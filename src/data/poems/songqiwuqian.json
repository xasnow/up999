  "lines": [
    {
      "text": "圣代无隐者，",
      "pinyin": [
        "shèng",
        "dài",
        "wú",
        "yǐn",
        "zhě"
      ],
      "translation": "圣明的时代没有隐士。",
      "noteIds": [
        "n-shengdai"
      ]
    },
    {
      "text": "英灵尽来归。",
      "pinyin": [
        "yīng",
        "líng",
        "jìn",
        "lái",
        "guī"
      ],
      "translation": "杰出的人才全都出来为朝廷效力。",
      "noteIds": []
    },
    {
      "text": "遂令东山客，",
      "pinyin": [
        "suì",
        "lìng",
        "dōng",
        "shān",
        "kè"
      ],
      "translation": "于是让隐居东山的高士。",
      "noteIds": [
        "n-dongshan"
      ]
    },
    {
      "text": "不得顾采薇。",
      "pinyin": [
        "bù",
        "dé",
        "gù",
        "cǎi",
        "wēi"
      ],
      "translation": "也顾不上再去过采薇隐居的生活。",
      "noteIds": [
        "n-caiwei"
      ]
    },
    {
      "text": "既至金门远，",
      "pinyin": [
        "jì",
        "zhì",
        "jīn",
        "mén",
        "yuǎn"
      ],
      "translation": "可是到了京城，离朝廷还是那么遥远。",
      "noteIds": [
        "n-jinmen"
      ]
    },
    {
      "text": "孰云吾道非。",
      "pinyin": [
        "shú",
        "yún",
        "wú",
        "dào",
        "fēi"
      ],
      "translation": "谁说我们的主张不对呢？",
      "noteIds": [
        "n-shuyun"
      ]
    },
    {
      "text": "江淮度寒食，",
      "pinyin": [
        "jiāng",
        "huái",
        "dù",
        "hán",
        "shí"
      ],
      "translation": "你在江淮一带过了寒食节。",
      "noteIds": [
        "n-hanshi"
      ]
    },
    {
      "text": "京洛缝春衣。",
      "pinyin": [
        "jīng",
        "luò",
        "féng",
        "chūn",
        "yī"
      ],
      "translation": "又在京城里缝补春衣，苦苦等待考试。",
      "noteIds": [
        "n-jingluo"
      ]
    },
    {
      "text": "置酒长安道，",
      "pinyin": [
        "zhì",
        "jiǔ",
        "cháng",
        "ān",
        "dào"
      ],
      "translation": "我在长安道上摆下酒席。",
      "noteIds": []
    },
    {
      "text": "同心与我违。",
      "pinyin": [
        "tóng",
        "xīn",
        "yǔ",
        "wǒ",
        "wéi"
      ],
      "translation": "知心的朋友就要和我分别了。",
      "noteIds": [
        "n-wei"
      ]
    },
    {
      "text": "行当浮桂棹，",
      "pinyin": [
        "xíng",
        "dāng",
        "fú",
        "guì",
        "zhào"
      ],
      "translation": "你将要乘船南归。",
      "noteIds": [
        "n-guizhao"
      ]
    },
    {
      "text": "未几拂荆扉。",
      "pinyin": [
        "wèi",
        "jǐ",
        "fú",
        "jīng",
        "fēi"
      ],
      "translation": "不久就会推开自家的柴门。",
      "noteIds": [
        "n-weiji"
      ]
    },
    {
      "text": "远树带行客，",
      "pinyin": [
        "yuǎn",
        "shù",
        "dài",
        "xíng",
        "kè"
      ],
      "translation": "远处的树影伴随着远行的人。",
      "noteIds": []
    },
    {
      "text": "孤村当落晖。",
      "pinyin": [
        "gū",
        "cūn",
        "dāng",
        "luò",
        "huī"
      ],
      "translation": "孤零零的村庄正对着落日的余晖。",
      "noteIds": [
        "n-luohui"
      ]
    },
    {
      "text": "吾谋适不用，",
      "pinyin": [
        "wú",
        "móu",
        "shì",
        "bù",
        "yòng"
      ],
      "translation": "你的才学只是这一次恰好没被采用。",
      "noteIds": [
        "n-wumou"
      ]
    },
    {
      "text": "勿谓知音稀。",
      "pinyin": [
        "wù",
        "wèi",
        "zhī",
        "yīn",
        "xī"
      ],
      "translation": "千万别说世上懂得你的人稀少。",
      "noteIds": [
        "n-zhiyin"
      ]
    }
  ],
