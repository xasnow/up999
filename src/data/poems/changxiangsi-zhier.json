  "lines": [
    {
      "text": "日色欲尽花含烟，",
      "pinyin": ["rì", "sè", "yù", "jìn", "huā", "hán", "yān"],
      "translation": "夕阳西沉，暮色里花像含着轻烟，",
      "noteIds": []
    },
    {
      "text": "月明欲素愁不眠。",
      "pinyin": ["yuè", "míng", "yù", "sù", "chóu", "bù", "mián"],
      "translation": "月光皎洁得像白绢，她愁得睡不着。",
      "noteIds": []
    },
    {
      "text": "赵瑟初停凤凰柱，",
      "pinyin": ["zhào", "sè", "chū", "tíng", "fèng", "huáng", "zhù"],
      "translation": "刚弹完赵地的瑟，瑟柱上雕着凤凰，",
      "noteIds": ["n-fenghuangzhu"]
    },
    {
      "text": "蜀琴欲奏鸳鸯弦。",
      "pinyin": ["shǔ", "qín", "yù", "zòu", "yuān", "yāng", "xián"],
      "translation": "又想弹蜀地的琴，琴上配着鸳鸯弦。",
      "noteIds": ["n-yuanyangxian"]
    },
    {
      "text": "此曲有意无人传，",
      "pinyin": ["cǐ", "qǔ", "yǒu", "yì", "wú", "rén", "chuán"],
      "translation": "这支曲子满含情意，却无人传递，",
      "noteIds": []
    },
    {
      "text": "愿随春风寄燕然。",
      "pinyin": ["yuàn", "suí", "chūn", "fēng", "jì", "yān", "rán"],
      "translation": "愿它随着春风，寄到遥远的燕然。",
      "noteIds": ["n-yanran"]
    },
    {
      "text": "忆君迢迢隔青天。",
      "pinyin": ["yì", "jūn", "tiáo", "tiáo", "gé", "qīng", "tiān"],
      "translation": "思念的人啊，迢迢远隔在青天之外。",
      "noteIds": []
    },
    {
      "text": "昔日横波目，",
      "pinyin": ["xī", "rì", "héng", "bō", "mù"],
      "translation": "从前那双含情流动的眼睛，",
      "noteIds": ["n-hengbo"]
    },
    {
      "text": "今作流泪泉。",
      "pinyin": ["jīn", "zuò", "liú", "lèi", "quán"],
      "translation": "如今变成了流不完的泪泉。",
      "noteIds": []
    },
    {
      "text": "不信妾肠断，",
      "pinyin": ["bú", "xìn", "qiè", "cháng", "duàn"],
      "translation": "如果你不信我为你想断了肠，",
      "noteIds": []
    },
    {
      "text": "归来看取明镜前。",
      "pinyin": ["guī", "lái", "kàn", "qǔ", "míng", "jìng", "qián"],
      "translation": "回来时到明镜前看一看我吧。",
      "noteIds": ["n-kanqu"]
