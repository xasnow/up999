      "pinyin": [
        "tiān",
        "yīn",
        "yǔ",
        "shī",
        "shēng",
        "jiū",
        "jiū"
      ],
      "translation": "阴天下雨时，啼哭声一片啾啾。",
      "noteIds": []
    }
