  "famousLines": ["家住层城临汉苑，心随明月到胡天。"],
  "lines": [
    {
      "text": "莺啼燕语报新年，",
      "pinyin": ["yīng", "tí", "yàn", "yǔ", "bào", "xīn", "nián"],
      "translation": "黄莺啼叫，燕子呢喃，报告新的一年来了，",
      "noteIds": []
    },
    {
      "text": "马邑龙堆路几千。",
      "pinyin": ["mǎ", "yì", "lóng", "duī", "lù", "jǐ", "qiān"],
      "translation": "可丈夫远在马邑、白龙堆，回家的路有几千个里程。",
      "noteIds": ["n-mayi", "n-longdui"]
    },
    {
      "text": "家住层城临汉苑，",
      "pinyin": ["jiā", "zhù", "céng", "chéng", "lín", "hàn", "yuàn"],
      "translation": "我家住在长安城，紧靠着皇宫的园苑，",
      "noteIds": ["n-cengcheng"]
    },
    {
      "text": "心随明月到胡天。",
      "pinyin": ["xīn", "suí", "míng", "yuè", "dào", "hú", "tiān"],
      "translation": "心却随着明月飞到了北方胡人的天空。",
      "noteIds": []
    },
    {
      "text": "机中锦字论长恨，",
      "pinyin": ["jī", "zhōng", "jǐn", "zì", "lùn", "cháng", "hèn"],
      "translation": "织机上织着锦字回文，诉说不尽的愁恨，",
      "noteIds": ["n-jinzi"]
    },
    {
      "text": "楼上花枝笑独眠。",
      "pinyin": ["lóu", "shàng", "huā", "zhī", "xiào", "dú", "mián"],
      "translation": "楼头的花枝偏偏开放，好像在笑话我一个人孤眠。",
      "noteIds": []
    },
    {
      "text": "为问元戎窦车骑，",
      "pinyin": ["wèi", "wèn", "yuán", "róng", "dòu", "jū", "jì"],
      "translation": "请问统领大军的车骑将军窦宪，",
      "noteIds": ["n-yuanrong", "n-cheji"]
    },
    {
      "text": "何时返旆勒燕然。",
      "pinyin": ["hé", "shí", "fǎn", "pèi", "lè", "yān", "rán"],
      "translation": "什么时候才能得胜回师，在燕然山上刻石记功？",
      "noteIds": ["n-pei", "n-yanran"]
    }
  ],
  "notes": [
    { "id": "n-mayi", "word": "马邑", "pinyin": "mǎ yì", "meaning": "秦汉时的北方边城，在今山西朔州一带。" },
