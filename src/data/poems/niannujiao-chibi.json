      "noteIds": ["n-gulei"]
    },
    {
      "text": "人道是，",
      "pinyin": ["rén", "dào", "shì"],
      "translation": "人们说，",
      "noteIds": []
    },
    {
      "text": "三国周郎赤壁。",
      "pinyin": ["sān", "guó", "zhōu", "láng", "chì", "bì"],
      "translation": "那就是三国时周瑜大破曹军的赤壁。",
      "noteIds": ["n-zhoul"]
    },
    {
      "text": "乱石穿空，",
      "pinyin": ["luàn", "shí", "chuān", "kōng"],
      "translation": "陡峭的乱石直插天空，",
      "noteIds": []
    },
    {
      "text": "惊涛拍岸，",
      "pinyin": ["jīng", "tāo", "pāi", "àn"],
      "translation": "惊人的巨浪拍打着江岸，",
      "noteIds": []
    },
    {
      "text": "卷起千堆雪。",
      "pinyin": ["juǎn", "qǐ", "qiān", "duī", "xuě"],
      "translation": "卷起千万堆雪白的浪花。",
      "noteIds": []
    },
    {
      "text": "江山如画，",
      "pinyin": ["jiāng", "shān", "rú", "huà"],
      "translation": "江山美丽得像画一样，",
      "noteIds": []
    },
    {
      "text": "一时多少豪杰。",
      "pinyin": ["yī", "shí", "duō", "shǎo", "háo", "jié"],
      "translation": "那个时代涌现出多少英雄豪杰啊。",
      "noteIds": []
    },
    {
      "text": "遥想公瑾当年，",
      "pinyin": ["yáo", "xiǎng", "gōng", "jǐn", "dāng", "nián"],
      "translation": "遥想当年的周公瑾，",
      "noteIds": ["n-gongjin"]
    },
    {
      "text": "小乔初嫁了，",
      "pinyin": ["xiǎo", "qiáo", "chū", "jià", "liǎo"],
      "translation": "小乔刚嫁给他，",
      "noteIds": ["n-xiaoqiao"]
    },
    {
      "text": "雄姿英发。",
      "pinyin": ["xióng", "zī", "yīng", "fā"],
      "translation": "他英姿勃勃、意气风发。",
      "noteIds": []
    },
    {
      "text": "羽扇纶巾，",
      "pinyin": ["yǔ", "shàn", "guān", "jīn"],
      "translation": "他手摇羽扇，头戴纶巾，",
      "noteIds": ["n-guanjin"]
    },
    {
      "text": "谈笑间，",
      "pinyin": ["tán", "xiào", "jiān"],
      "translation": "谈笑之间，",
      "noteIds": []
    },
    {
      "text": "樯橹灰飞烟灭。",
      "pinyin": ["qiáng", "lǔ", "huī", "fēi", "yān", "miè"],
      "translation": "就把曹操的战船烧得灰飞烟灭。",
      "noteIds": ["n-qianglu"]
    },
    {
      "text": "故国神游，",
      "pinyin": ["gù", "guó", "shén", "yóu"],
      "translation": "神游在当年三国的古战场，",
      "noteIds": []
    },
    {
      "text": "多情应笑我，",
      "pinyin": ["duō", "qíng", "yīng", "xiào", "wǒ"],
      "translation": "应该笑我这么多愁善感，",
      "noteIds": []
    },
    {
      "text": "早生华发。",
      "pinyin": ["zǎo", "shēng", "huá", "fà"],
      "translation": "头发早早地花白了。",
      "noteIds": ["n-huafa"]
    },
    {
      "text": "人生如梦，",
      "pinyin": ["rén", "shēng", "rú", "mèng"],
      "translation": "人生就像一场梦，",
      "noteIds": []
    },
    {
      "text": "一尊还酹江月。",
      "pinyin": ["yī", "zūn", "huán", "lèi", "jiāng", "yuè"],
      "translation": "还是斟满一杯酒，洒向江中的明月吧。",
      "noteIds": ["n-zun", "n-lei"]
    }
