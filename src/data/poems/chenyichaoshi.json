  "famousLines": ["日出雾露馀，青松如膏沐。"],
  "lines": [
    {
      "text": "汲井漱寒齿，",
      "pinyin": ["jí", "jǐng", "shù", "hán", "chǐ"],
      "translation": "清晨打来井水漱口，寒气沁到牙齿里，",
      "noteIds": ["n-ji"]
    },
    {
      "text": "清心拂尘服。",
      "pinyin": ["qīng", "xīn", "fú", "chén", "fú"],
      "translation": "擦去衣上的尘埃，让心也安静干净下来。",
      "noteIds": []
    },
    {
      "text": "闲持贝叶书，",
      "pinyin": ["xián", "chí", "bèi", "yè", "shū"],
      "translation": "悠闲地捧起一卷佛经，",
      "noteIds": ["n-beiye"]
    },
    {
      "text": "步出东斋读。",
      "pinyin": ["bù", "chū", "dōng", "zhāi", "dú"],
      "translation": "走出东边的书斋慢慢诵读。",
      "noteIds": []
    },
    {
      "text": "真源了无取，",
      "pinyin": ["zhēn", "yuán", "liǎo", "wú", "qǔ"],
      "translation": "世上的人对真正的道理全然不去领会，",
      "noteIds": ["n-liao"]
    },
    {
      "text": "妄迹世所逐。",
      "pinyin": ["wàng", "jì", "shì", "suǒ", "zhú"],
      "translation": "只追逐那些虚妄的表面东西。",
      "noteIds": []
    },
    {
      "text": "遗言冀可冥，",
      "pinyin": ["yí", "yán", "jì", "kě", "míng"],
      "translation": "佛祖留下的话，我希望它能与我心中所想暗暗相合，",
      "noteIds": []
    },
    {
      "text": "缮性何由熟。",
      "pinyin": ["shàn", "xìng", "hé", "yóu", "shú"],
      "translation": "可修养本性的功夫，又怎能在短时间内纯熟呢？",
      "noteIds": ["n-shanxing"]
    },
    {
      "text": "道人庭宇静，",
      "pinyin": ["dào", "rén", "tíng", "yǔ", "jìng"],
      "translation": "超师和尚的庭院安静极了，",
      "noteIds": []
    },
    {
      "text": "苔色连深竹。",
      "pinyin": ["tái", "sè", "lián", "shēn", "zhú"],
      "translation": "青苔的颜色一直连到深深的竹林。",
      "noteIds": []
    },
    {
      "text": "日出雾露馀，",
      "pinyin": ["rì", "chū", "wù", "lù", "yú"],
      "translation": "太阳升起，雾气和露水还没有散尽，",
      "noteIds": []
    },
    {
      "text": "青松如膏沐。",
      "pinyin": ["qīng", "sōng", "rú", "gào", "mù"],
      "translation": "青松像刚涂了润发油一样润泽鲜亮。",
      "noteIds": ["n-gaomu"]
    },
    {
      "text": "澹然离言说，",
      "pinyin": ["dàn", "rán", "lí", "yán", "shuō"],
      "translation": "这样宁静安适，一切妙处都说不出口，",
      "noteIds": ["n-danran"]
    },
    {
      "text": "悟悦心自足。",
      "pinyin": ["wù", "yuè", "xīn", "zì", "zú"],
      "translation": "心里已经明白、喜悦，自己觉得圆满充足。",
      "noteIds": []
    }
  ],
