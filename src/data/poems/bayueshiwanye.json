{
  "id": "tang-zhongtang-hanyu-bayueshiwanye",
  "slug": "bayueshiwanye",
  "title": "八月十五夜赠张功曹",
  "titlePinyin": "bā yuè shí wǔ yè zèng zhāng gōng cáo",
  "dynasty": "tangshi",
  "era": "zhongtang",
  "genre": "shi",
  "form": "七言古诗",
  "authorId": "hanyu",
  "gradeBand": "ext",
  "tags": [
    "月亮",
    "七言古诗",
