  "lines": [
    {
      "text": "天秋月又满，",
      "pinyin": ["tiān", "qiū", "yuè", "yòu", "mǎn"],
      "translation": "秋天的夜空，月亮又圆了，",
      "noteIds": []
    },
    {
      "text": "城阙夜千重。",
      "pinyin": ["chéng", "què", "yè", "qiān", "chóng"],
      "translation": "京城宫阙笼罩在深深的夜色里。",
      "noteIds": ["n-chengque"]
    },
    {
      "text": "还作江南会，",
      "pinyin": ["hái", "zuò", "jiāng", "nán", "huì"],
      "translation": "我们竟像在江南家乡时那样相聚，",
      "noteIds": ["n-hui"]
    },
    {
      "text": "翻疑梦里逢。",
      "pinyin": ["fān", "yí", "mèng", "lǐ", "féng"],
      "translation": "反而让人怀疑是在梦中相逢。",
      "noteIds": []
    },
    {
      "text": "风枝惊暗鹊，",
      "pinyin": ["fēng", "zhī", "jīng", "àn", "què"],
      "translation": "风吹动树枝，惊起了暗处栖息的乌鹊，",
      "noteIds": []
    },
    {
      "text": "露草覆寒蛩。",
      "pinyin": ["lù", "cǎo", "fù", "hán", "qióng"],
      "translation": "露水沾湿秋草，寒蛩在草下低鸣。",
      "noteIds": ["n-qiong"]
    },
    {
      "text": "羁旅长堪醉，",
      "pinyin": ["jī", "lǚ", "cháng", "kān", "zuì"],
      "translation": "客居在外的人正该一醉方休，",
      "noteIds": ["n-jilv"]
    },
    {
      "text": "相留畏晓钟。",
      "pinyin": ["xiāng", "liú", "wèi", "xiǎo", "zhōng"],
      "translation": "我们互相挽留，只怕听见报晓的钟声。",
      "noteIds": ["n-xiaozhong"]
    }
