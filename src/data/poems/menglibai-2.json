  "lines": [
    {
      "text": "浮云终日行，",
      "pinyin": [
        "fú",
        "yún",
        "zhōng",
        "rì",
        "xíng"
      ],
      "translation": "浮云整天在天空飘动，",
      "noteIds": []
    },
    {
      "text": "游子久不至。",
      "pinyin": [
        "yóu",
        "zǐ",
        "jiǔ",
        "bù",
        "zhì"
      ],
      "translation": "远游的人却迟迟没有到来。",
      "noteIds": [
        "n-youzi"
      ]
    },
    {
      "text": "三夜频梦君，",
      "pinyin": [
        "sān",
        "yè",
        "pín",
        "mèng",
        "jūn"
      ],
      "translation": "一连三个夜里频频梦见你，",
      "noteIds": []
    },
    {
      "text": "情亲见君意。",
      "pinyin": [
        "qíng",
        "qīn",
        "jiàn",
        "jūn",
        "yì"
      ],
      "translation": "梦里那份亲近平切，看得出你的一片心意。",
      "noteIds": [
        "n-qingqin"
      ]
    },
    {
      "text": "告归常局促，",
      "pinyin": [
        "gào",
        "guī",
        "cháng",
        "jú",
        "cù"
      ],
      "translation": "你每次告别回去总是匆忙不安，",
      "noteIds": [
        "n-gaogui",
        "n-juju"
      ]
    },
    {
      "text": "苦道来不易。",
      "pinyin": [
        "kǔ",
        "dào",
        "lái",
        "bù",
        "yì"
      ],
      "translation": "诉说来一趟多么不容易。",
      "noteIds": []
    },
    {
      "text": "江湖多风波，",
      "pinyin": [
        "jiāng",
        "hú",
        "duō",
        "fēng",
        "bō"
      ],
      "translation": "江湖上风浪那么多，",
      "noteIds": []
    },
    {
      "text": "舟楫恐失坠。",
      "pinyin": [
        "zhōu",
        "jí",
        "kǒng",
        "shī",
        "zhuì"
      ],
      "translation": "怕小船会翻落水中。",
      "noteIds": [
        "n-zhouji"
      ]
    },
    {
      "text": "出门搔白首，",
      "pinyin": [
        "chū",
        "mén",
        "sāo",
        "bái",
        "shǒu"
      ],
      "translation": "梦里的你出门时搔着满头白发，",
      "noteIds": []
    },
    {
      "text": "若负平生志。",
      "pinyin": [
        "ruò",
        "fù",
        "píng",
        "shēng",
        "zhì"
      ],
      "translation": "好像辜负了平生的志向。",
      "noteIds": []
    },
    {
      "text": "冠盖满京华，",
      "pinyin": [
        "guān",
        "gài",
        "mǎn",
        "jīng",
        "huá"
      ],
      "translation": "京城里满是达官贵人，",
      "noteIds": [
        "n-guangai"
      ]
    },
    {
      "text": "斯人独憔悴。",
      "pinyin": [
        "sī",
        "rén",
        "dú",
        "qiáo",
        "cuì"
      ],
      "translation": "偏偏你这样的人才憔悴失意。",
      "noteIds": [
        "n-siren"
      ]
    },
    {
      "text": "孰云网恢恢，",
      "pinyin": [
        "shú",
        "yún",
        "wǎng",
        "huī",
        "huī"
      ],
      "translation": "谁说天网宽广，无所遗漏？",
      "noteIds": [
        "n-huihui"
      ]
    },
    {
      "text": "将老身反累。",
      "pinyin": [
