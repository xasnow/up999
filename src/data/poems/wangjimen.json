  "lines": [
    {
      "text": "燕台一去客心惊，",
      "pinyin": ["yān", "tái", "yī", "qù", "kè", "xīn", "jīng"],
      "translation": "一到燕台，我这个远来的客人心里就激动起来，",
      "noteIds": ["n-yantai"]
    },
    {
      "text": "笳鼓喧喧汉将营。",
      "pinyin": ["jiā", "gǔ", "xuān", "xuān", "hàn", "jiāng", "yíng"],
      "translation": "胡笳和战鼓喧闹震响，那是汉家将军的营垒。",
      "noteIds": ["n-jia"]
    },
    {
      "text": "万里寒光生积雪，",
      "pinyin": ["wàn", "lǐ", "hán", "guāng", "shēng", "jī", "xuě"],
      "translation": "万里大地上，积雪泛起刺眼的寒光，",
      "noteIds": []
    },
