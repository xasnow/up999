  ],
  "lines": [
    {
      "text": "巴山楚水凄凉地，",
      "pinyin": ["bā", "shān", "chǔ", "shuǐ", "qī", "liáng", "dì"],
      "translation": "我在巴山楚水这些凄凉的地方，",
      "noteIds": []
    },
    {
      "text": "二十三年弃置身。",
      "pinyin": ["èr", "shí", "sān", "nián", "qì", "zhì", "shēn"],
      "translation": "被丢在一边，过了二十三年。",
      "noteIds": ["n-qizhi"]
    },
    {
      "text": "怀旧空吟闻笛赋，",
      "pinyin": ["huái", "jiù", "kōng", "yín", "wén", "dí", "fù"],
      "translation": "想念老朋友，只能白白地吟着《思旧赋》，",
      "noteIds": ["n-wendifu"]
    },
    {
      "text": "到乡翻似烂柯人。",
      "pinyin": ["dào", "xiāng", "fān", "sì", "làn", "kē", "rén"],
      "translation": "回到家乡，倒像那个烂柯人，什么都变了。",
      "noteIds": ["n-lanke"]
    },
    {
      "text": "沉舟侧畔千帆过，",
      "pinyin": ["chén", "zhōu", "cè", "pàn", "qiān", "fān", "guò"],
      "translation": "沉船旁边，千条大船驶过，",
      "noteIds": ["n-pan"]
    },
    {
      "text": "病树前头万木春。",
      "pinyin": ["bìng", "shù", "qián", "tóu", "wàn", "mù", "chūn"],
      "translation": "病树前头，万棵大树争着迎春。",
      "noteIds": []
    },
    {
      "text": "今日听君歌一曲，",
      "pinyin": ["jīn", "rì", "tīng", "jūn", "gē", "yī", "qǔ"],
      "translation": "今天听了你的一支歌，",
      "noteIds": []
    },
    {
      "text": "暂凭杯酒长精神。",
      "pinyin": ["zàn", "píng", "bēi", "jiǔ", "zhǎng", "jīng", "shén"],
      "translation": "借这杯酒，让自己重新振作起来。",
      "noteIds": ["n-zhang"]
    }
  ],
