{
  "id": "tang-zhongtang-baijuyi-changhenge",
  "slug": "changhenge",
  "title": "长恨歌",
  "titlePinyin": "cháng hèn gē",
  "dynasty": "tangshi",
  "era": "zhongtang",
  "genre": "shi",
  "form": "七言古诗",
  "authorId": "baijuyi",
  "gradeBand": "ext",
  "tags": ["爱情", "七言古诗", "月夜"],
  "difficulty": 3,
  "writtenYear": 806,
  "writtenLabel": "约公元 806 年（白居易 35 岁，任盩厔县尉，与友人游仙游寺时所作）",
  "orderInAuthor": 1,
  "famousLines": [
    "在天愿作比翼鸟，在地愿为连理枝。",
    "天长地久有时尽，此恨绵绵无绝期。"
  ],
  "lines": [
    { "text": "汉皇重色思倾国，", "pinyin": ["hàn", "huáng", "zhòng", "sè", "sī", "qīng", "guó"], "translation": "皇帝看重美色，一心想找一位倾国倾城的绝代佳人。", "noteIds": ["n-hanhuang", "n-qingguo"] },
    { "text": "御宇多年求不得。", "pinyin": ["yù", "yǔ", "duō", "nián", "qiú", "bù", "dé"], "translation": "他统治天下多年，一直没有找到称心的人。", "noteIds": ["n-yuyu"] },
    { "text": "杨家有女初长成，", "pinyin": ["yáng", "jiā", "yǒu", "nǚ", "chū", "zhǎng", "chéng"], "translation": "杨家有个女儿刚刚长大成人，", "noteIds": [] },
    { "text": "养在深闺人未识。", "pinyin": ["yǎng", "zài", "shēn", "guī", "rén", "wèi", "shí"], "translation": "养在深闺之中，外面的人还不知道她的美貌。", "noteIds": ["n-shengui"] },
    { "text": "天生丽质难自弃，", "pinyin": ["tiān", "shēng", "lì", "zhì", "nán", "zì", "qì"], "translation": "天生的丽质让她不甘心被埋没，", "noteIds": [] },
    { "text": "一朝选在君王侧。", "pinyin": ["yì", "zhāo", "xuǎn", "zài", "jūn", "wáng", "cè"], "translation": "终于有一天被选进宫，来到君王身边。", "noteIds": [] },
    { "text": "回眸一笑百媚生，", "pinyin": ["huí", "móu", "yí", "xiào", "bǎi", "mèi", "shēng"], "translation": "她回头一笑，生出千娇百媚，", "noteIds": [] },
    { "text": "六宫粉黛无颜色。", "pinyin": ["liù", "gōng", "fěn", "dài", "wú", "yán", "sè"], "translation": "后宫里的其他美人，相比之下都黯然失色。", "noteIds": ["n-liugong", "n-fendai"] },
    { "text": "春寒赐浴华清池，", "pinyin": ["chūn", "hán", "cì", "yù", "huá", "qīng", "chí"], "translation": "初春寒凉时，皇帝赏她到华清池洗温泉，", "noteIds": ["n-huaqing"] },
    { "text": "温泉水滑洗凝脂。", "pinyin": ["wēn", "quán", "shuǐ", "huá", "xǐ", "níng", "zhī"], "translation": "温热的泉水滑润，洗着她细嫩如脂的肌肤。", "noteIds": ["n-ningzhi"] },
    { "text": "侍儿扶起娇无力，", "pinyin": ["shì", "ér", "fú", "qǐ", "jiāo", "wú", "lì"], "translation": "侍女把她扶起来，她娇柔得没有力气，", "noteIds": [] },
    { "text": "始是新承恩泽时。", "pinyin": ["shǐ", "shì", "xīn", "chéng", "ēn", "zé", "shí"], "translation": "这正是她刚开始蒙受君王恩宠的时候。", "noteIds": [] },
    { "text": "云鬓花颜金步摇，", "pinyin": ["yún", "bìn", "huā", "yán", "jīn", "bù", "yáo"], "translation": "她鬓发如云、容颜似花，头上金步摇轻轻颤动，", "noteIds": ["n-buyao"] },
    { "text": "芙蓉帐暖度春宵。", "pinyin": ["fú", "róng", "zhàng", "nuǎn", "dù", "chūn", "xiāo"], "translation": "在温暖的芙蓉帐里度过美好的春夜。", "noteIds": ["n-furongzhang"] },
    { "text": "春宵苦短日高起，", "pinyin": ["chūn", "xiāo", "kǔ", "duǎn", "rì", "gāo", "qǐ"], "translation": "春夜嫌太短，太阳升得很高了她才起身，", "noteIds": [] },
    { "text": "从此君王不早朝。", "pinyin": ["cóng", "cǐ", "jūn", "wáng", "bù", "zǎo", "cháo"], "translation": "从此君王不再上早朝。", "noteIds": ["n-zaochao"] },
    { "text": "承欢侍宴无闲暇，", "pinyin": ["chéng", "huān", "shì", "yàn", "wú", "xián", "xiá"], "translation": "她陪着皇帝欢宴，忙得没有一点空闲，", "noteIds": [] },
    { "text": "春从春游夜专夜。", "pinyin": ["chūn", "cóng", "chūn", "yóu", "yè", "zhuān", "yè"], "translation": "春天随驾春游，夜里夜夜都由她专宠。", "noteIds": [] },
    { "text": "后宫佳丽三千人，", "pinyin": ["hòu", "gōng", "jiā", "lì", "sān", "qiān", "rén"], "translation": "后宫里有三千位美丽的女子，", "noteIds": [] },
    { "text": "三千宠爱在一身。", "pinyin": ["sān", "qiān", "chǒng", "ài", "zài", "yì", "shēn"], "translation": "三千人的宠爱，都集中在她一个人身上。", "noteIds": [] },
    { "text": "金屋妆成娇侍夜，", "pinyin": ["jīn", "wū", "zhuāng", "chéng", "jiāo", "shì", "yè"], "translation": "她在华丽的屋子里梳妆停当，娇媚地侍奉皇帝，", "noteIds": [] },
    { "text": "玉楼宴罢醉和春。", "pinyin": ["yù", "lóu", "yàn", "bà", "zuì", "hé", "chūn"], "translation": "玉楼上宴席散后，她带着醉意，更添几分春色。", "noteIds": [] },
    { "text": "姊妹弟兄皆列土，", "pinyin": ["zǐ", "mèi", "dì", "xiōng", "jiē", "liè", "tǔ"], "translation": "她的姐妹兄弟都分封了土地爵位，", "noteIds": ["n-lietu"] },
    { "text": "可怜光彩生门户。", "pinyin": ["kě", "lián", "guāng", "cǎi", "shēng", "mén", "hù"], "translation": "杨家的门第光彩照人，令天下人羡慕。", "noteIds": [] },
    { "text": "遂令天下父母心，", "pinyin": ["suì", "lìng", "tiān", "xià", "fù", "mǔ", "xīn"], "translation": "这让天下做父母的心思都变了，", "noteIds": [] },
    { "text": "不重生男重生女。", "pinyin": ["bú", "zhòng", "shēng", "nán", "zhòng", "shēng", "nǚ"], "translation": "不再看重生男孩，只看重生女孩。", "noteIds": [] },
    { "text": "骊宫高处入青云，", "pinyin": ["lí", "gōng", "gāo", "chù", "rù", "qīng", "yún"], "translation": "骊山上的宫殿高耸，直插青云，", "noteIds": ["n-ligong"] },
    { "text": "仙乐风飘处处闻。", "pinyin": ["xiān", "yuè", "fēng", "piāo", "chù", "chù", "wén"], "translation": "宫中的乐声像仙乐一样随风飘散，处处都能听见。", "noteIds": ["n-xianle"] },
    { "text": "缓歌慢舞凝丝竹，", "pinyin": ["huǎn", "gē", "màn", "wǔ", "níng", "sī", "zhú"], "translation": "缓缓的歌声、慢慢的舞步，和着丝竹音乐，", "noteIds": ["n-sizhu"] },
    { "text": "尽日君王看不足。", "pinyin": ["jìn", "rì", "jūn", "wáng", "kàn", "bù", "zú"], "translation": "君王整天地观赏，怎么也看不够。", "noteIds": [] },
    { "text": "渔阳鼙鼓动地来，", "pinyin": ["yú", "yáng", "pí", "gǔ", "dòng", "dì", "lái"], "translation": "忽然渔阳的战鼓震天动地打过来，", "noteIds": ["n-pigu"] },
    { "text": "惊破霓裳羽衣曲。", "pinyin": ["jīng", "pò", "ní", "cháng", "yǔ", "yī", "qǔ"], "translation": "惊断了《霓裳羽衣曲》的歌舞升平。", "noteIds": ["n-nichang"] },
    { "text": "九重城阙烟尘生，", "pinyin": ["jiǔ", "chóng", "chéng", "què", "yān", "chén", "shēng"], "translation": "京城的上空烟尘弥漫，", "noteIds": ["n-chengque"] },
    { "text": "千乘万骑西南行。", "pinyin": ["qiān", "shèng", "wàn", "jì", "xī", "nán", "xíng"], "translation": "天子带着千车万骑，向西南仓皇逃奔。", "noteIds": ["n-qiancheng", "n-wanqi"] },
    { "text": "翠华摇摇行复止，", "pinyin": ["cuì", "huá", "yáo", "yáo", "xíng", "fù", "zhǐ"], "translation": "皇帝仪仗的翠旗摇摇晃晃，走走又停，", "noteIds": ["n-cuihua"] },
    { "text": "西出都门百余里。", "pinyin": ["xī", "chū", "dū", "mén", "bǎi", "yú", "lǐ"], "translation": "向西出了都门，才走了一百多里。", "noteIds": [] },
    { "text": "六军不发无奈何，", "pinyin": ["liù", "jūn", "bù", "fā", "wú", "nài", "hé"], "translation": "禁卫军不肯再往前走，君王毫无办法，", "noteIds": ["n-liujun"] },
    { "text": "宛转蛾眉马前死。", "pinyin": ["wǎn", "zhuǎn", "é", "méi", "mǎ", "qián", "sǐ"], "translation": "只好让美丽的贵妃在马前凄婉地死去。", "noteIds": ["n-emei"] },
    { "text": "花钿委地无人收，", "pinyin": ["huā", "diàn", "wěi", "dì", "wú", "rén", "shōu"], "translation": "她的花钿首饰落在地上，没有人去捡，", "noteIds": ["n-huadian"] },
    { "text": "翠翘金雀玉搔头。", "pinyin": ["cuì", "qiáo", "jīn", "què", "yù", "sāo", "tóu"], "translation": "翠翘、金雀和玉簪散落了一地。", "noteIds": ["n-cuiqiao", "n-saotou"] },
    { "text": "君王掩面救不得，", "pinyin": ["jūn", "wáng", "yǎn", "miàn", "jiù", "bù", "dé"], "translation": "君王掩着面孔，想救也救不了，", "noteIds": [] },
    { "text": "回看血泪相和流。", "pinyin": ["huí", "kàn", "xuè", "lèi", "xiāng", "hé", "liú"], "translation": "回头看时，血和眼泪一起流淌。", "noteIds": [] },
    { "text": "黄埃散漫风萧索，", "pinyin": ["huáng", "āi", "sǎn", "màn", "fēng", "xiāo", "suǒ"], "translation": "黄尘弥漫，风声凄冷萧索，", "noteIds": [] },
    { "text": "云栈萦纡登剑阁。", "pinyin": ["yún", "zhàn", "yíng", "yū", "dēng", "jiàn", "gé"], "translation": "高入云霄的栈道曲折盘旋，队伍登上剑阁。", "noteIds": ["n-yunzhan", "n-yingyu", "n-jiange"] },
    { "text": "峨嵋山下少人行，", "pinyin": ["é", "méi", "shān", "xià", "shǎo", "rén", "xíng"], "translation": "峨嵋山下行人稀少，", "noteIds": ["n-emeishan"] },
    { "text": "旌旗无光日色薄。", "pinyin": ["jīng", "qí", "wú", "guāng", "rì", "sè", "bó"], "translation": "旌旗黯淡无光，连日光也显得微弱。", "noteIds": [] },
    { "text": "蜀江水碧蜀山青，", "pinyin": ["shǔ", "jiāng", "shuǐ", "bì", "shǔ", "shān", "qīng"], "translation": "蜀地的江水碧绿，青山苍翠，", "noteIds": [] },
    { "text": "圣主朝朝暮暮情。", "pinyin": ["shèng", "zhǔ", "zhāo", "zhāo", "mù", "mù", "qíng"], "translation": "君主日日夜夜，都怀着思念的情意。", "noteIds": [] },
    { "text": "行宫见月伤心色，", "pinyin": ["xíng", "gōng", "jiàn", "yuè", "shāng", "xīn", "sè"], "translation": "在行宫看见月亮，就露出伤心的神色，", "noteIds": [] },
    { "text": "夜雨闻铃肠断声。", "pinyin": ["yè", "yǔ", "wén", "líng", "cháng", "duàn", "shēng"], "translation": "夜里听到雨中的檐铃，就像听到令人肠断的声音。", "noteIds": [] },
    { "text": "天旋地转回龙驭，", "pinyin": ["tiān", "xuán", "dì", "zhuàn", "huí", "lóng", "yù"], "translation": "时局平定，皇帝的车驾重新返回，", "noteIds": ["n-longyu"] },
    { "text": "到此踌躇不能去。", "pinyin": ["dào", "cǐ", "chóu", "chú", "bù", "néng", "qù"], "translation": "走到马嵬坡这里，徘徊犹豫，再也迈不开脚步。", "noteIds": [] },
    { "text": "马嵬坡下泥土中，", "pinyin": ["mǎ", "wéi", "pō", "xià", "ní", "tǔ", "zhōng"], "translation": "马嵬坡下的泥土之中，", "noteIds": ["n-maweipo"] },
    { "text": "不见玉颜空死处。", "pinyin": ["bú", "jiàn", "yù", "yán", "kōng", "sǐ", "chù"], "translation": "再也看不见那玉容，只空留她死去的地方。", "noteIds": [] },
    { "text": "君臣相顾尽沾衣，", "pinyin": ["jūn", "chén", "xiāng", "gù", "jìn", "zhān", "yī"], "translation": "君臣互相望着，眼泪都打湿了衣衫，", "noteIds": [] },
    { "text": "东望都门信马归。", "pinyin": ["dōng", "wàng", "dū", "mén", "xìn", "mǎ", "guī"], "translation": "向东望着都门，任凭马儿把自己带回去。", "noteIds": [] },
    { "text": "归来池苑皆依旧，", "pinyin": ["guī", "lái", "chí", "yuàn", "jiē", "yī", "jiù"], "translation": "回来后，池水园林都还是原来的样子，", "noteIds": [] },
    { "text": "太液芙蓉未央柳。", "pinyin": ["tài", "yè", "fú", "róng", "wèi", "yāng", "liǔ"], "translation": "太液池里的荷花、未央宫前的柳树一如从前。", "noteIds": ["n-taiye", "n-weiyang"] },
    { "text": "芙蓉如面柳如眉，", "pinyin": ["fú", "róng", "rú", "miàn", "liǔ", "rú", "méi"], "translation": "荷花像她的脸，柳叶像她的眉，", "noteIds": [] },
    { "text": "对此如何不泪垂。", "pinyin": ["duì", "cǐ", "rú", "hé", "bù", "lèi", "chuí"], "translation": "面对这些景物，怎么能不落泪呢。", "noteIds": [] },
    { "text": "春风桃李花开日，", "pinyin": ["chūn", "fēng", "táo", "lǐ", "huā", "kāi", "rì"], "translation": "春风吹开桃李花的日子，", "noteIds": [] },
    { "text": "秋雨梧桐叶落时。", "pinyin": ["qiū", "yǔ", "wú", "tóng", "yè", "luò", "shí"], "translation": "秋雨打落梧桐叶的时候，", "noteIds": [] },
    { "text": "西宫南内多秋草，", "pinyin": ["xī", "gōng", "nán", "nèi", "duō", "qiū", "cǎo"], "translation": "西宫南内的庭院里长满了秋草，", "noteIds": ["n-nannei"] },
    { "text": "落叶满阶红不扫。", "pinyin": ["luò", "yè", "mǎn", "jiē", "hóng", "bù", "sǎo"], "translation": "落叶铺满台阶，红叶也没有人打扫。", "noteIds": [] },
    { "text": "梨园弟子白发新，", "pinyin": ["lí", "yuán", "dì", "zǐ", "bái", "fà", "xīn"], "translation": "梨园的乐工们添了新的白发，", "noteIds": ["n-liyuan"] },
    { "text": "椒房阿监青娥老。", "pinyin": ["jiāo", "fáng", "ā", "jiān", "qīng", "é", "lǎo"], "translation": "椒房里的女官和宫女也都渐渐老了。", "noteIds": ["n-jiaofang", "n-ajian", "n-qinge"] },
    { "text": "夕殿萤飞思悄然，", "pinyin": ["xī", "diàn", "yíng", "fēi", "sī", "qiǎo", "rán"], "translation": "傍晚的宫殿里萤火虫飞舞，他静静思念，一声不响，", "noteIds": [] },
    { "text": "孤灯挑尽未成眠。", "pinyin": ["gū", "dēng", "tiǎo", "jìn", "wèi", "chéng", "mián"], "translation": "孤灯的灯芯挑了又挑，还是难以入眠。", "noteIds": [] },
    { "text": "迟迟钟鼓初长夜，", "pinyin": ["chí", "chí", "zhōng", "gǔ", "chū", "cháng", "yè"], "translation": "缓缓的钟鼓声里，漫漫的长夜刚刚开始，", "noteIds": [] },
    { "text": "耿耿星河欲曙天。", "pinyin": ["gěng", "gěng", "xīng", "hé", "yù", "shǔ", "tiān"], "translation": "明亮的银河横在天上，天快亮了还是睡不着。", "noteIds": [] },
    { "text": "鸳鸯瓦冷霜华重，", "pinyin": ["yuān", "yāng", "wǎ", "lěng", "shuāng", "huá", "zhòng"], "translation": "鸳鸯瓦冰冷，屋顶的霜花又厚又重，", "noteIds": ["n-yuanyangwa"] },
    { "text": "翡翠衾寒谁与共。", "pinyin": ["fěi", "cuì", "qīn", "hán", "shuí", "yǔ", "gòng"], "translation": "绣着翡翠鸟的锦被又冷又寒，还有谁与他同盖？", "noteIds": ["n-feicuiqin"] },
    { "text": "悠悠生死别经年，", "pinyin": ["yōu", "yōu", "shēng", "sǐ", "bié", "jīng", "nián"], "translation": "生死相别，一晃已经过去多年，", "noteIds": [] },
    { "text": "魂魄不曾来入梦。", "pinyin": ["hún", "pò", "bù", "céng", "lái", "rù", "mèng"], "translation": "她的魂魄却从不曾来进他的梦里。", "noteIds": [] },
    { "text": "临邛道士鸿都客，", "pinyin": ["lín", "qióng", "dào", "shì", "hóng", "dū", "kè"], "translation": "有位从临邛来的道士，客居京城，", "noteIds": ["n-linqiong", "n-hongdu"] },
    { "text": "能以精诚致魂魄。", "pinyin": ["néng", "yǐ", "jīng", "chéng", "zhì", "hún", "pò"], "translation": "能用一片诚心把亡魂召来。", "noteIds": [] },
    { "text": "为感君王辗转思，", "pinyin": ["wèi", "gǎn", "jūn", "wáng", "zhǎn", "zhuǎn", "sī"], "translation": "他被君王翻来覆去的思念打动，", "noteIds": [] },
    { "text": "遂教方士殷勤觅。", "pinyin": ["suì", "jiào", "fāng", "shì", "yīn", "qín", "mì"], "translation": "就派方士尽心尽力去寻找贵妃的魂魄。", "noteIds": ["n-fangshi"] },
    { "text": "排空驭气奔如电，", "pinyin": ["pái", "kōng", "yù", "qì", "bēn", "rú", "diàn"], "translation": "方士腾云驾雾，飞奔得像闪电一样，", "noteIds": [] },
    { "text": "升天入地求之遍。", "pinyin": ["shēng", "tiān", "rù", "dì", "qiú", "zhī", "biàn"], "translation": "升上天界、下到地府，到处都找遍了。", "noteIds": [] },
    { "text": "上穷碧落下黄泉，", "pinyin": ["shàng", "qióng", "bì", "luò", "xià", "huáng", "quán"], "translation": "上到天空的尽头，下到黄泉的深处，", "noteIds": ["n-biluo", "n-huangquan"] },
    { "text": "两处茫茫皆不见。", "pinyin": ["liǎng", "chù", "máng", "máng", "jiē", "bú", "jiàn"], "translation": "两处都茫茫无边，哪里也找不到她。", "noteIds": [] },
    { "text": "忽闻海上有仙山，", "pinyin": ["hū", "wén", "hǎi", "shàng", "yǒu", "xiān", "shān"], "translation": "忽然听说海上有一座仙山，", "noteIds": [] },
    { "text": "山在虚无缥缈间。", "pinyin": ["shān", "zài", "xū", "wú", "piāo", "miǎo", "jiān"], "translation": "山在若隐若现的云雾缥缈之间。", "noteIds": [] },
    { "text": "楼阁玲珑五云起，", "pinyin": ["lóu", "gé", "líng", "lóng", "wǔ", "yún", "qǐ"], "translation": "玲珑的楼阁立在五彩祥云之中，", "noteIds": [] },
    { "text": "其中绰约多仙子。", "pinyin": ["qí", "zhōng", "chuò", "yuē", "duō", "xiān", "zǐ"], "translation": "里面住着许多体态柔美的仙子。", "noteIds": ["n-chuoyue"] },
    { "text": "中有一人字太真，", "pinyin": ["zhōng", "yǒu", "yì", "rén", "zì", "tài", "zhēn"], "translation": "其中有一位，道号叫太真，", "noteIds": ["n-taizhen"] },
    { "text": "雪肤花貌参差是。", "pinyin": ["xuě", "fū", "huā", "mào", "cēn", "cī", "shì"], "translation": "肌肤如雪、容貌如花，看起来正是杨贵妃。", "noteIds": [] },
    { "text": "金阙西厢叩玉扃，", "pinyin": ["jīn", "què", "xī", "xiāng", "kòu", "yù", "jiōng"], "translation": "方士在金阙的西厢，轻轻叩响了玉门，", "noteIds": ["n-jinque", "n-yujiong"] },
    { "text": "转教小玉报双成。", "pinyin": ["zhuǎn", "jiào", "xiǎo", "yù", "bào", "shuāng", "chéng"], "translation": "请小玉转告双成，让她进去通报。", "noteIds": ["n-xiaoyu", "n-shuangcheng"] },
    { "text": "闻道汉家天子使，", "pinyin": ["wén", "dào", "hàn", "jiā", "tiān", "zǐ", "shǐ"], "translation": "太真听说大唐天子派使者来了，", "noteIds": [] },
    { "text": "九华帐里梦魂惊。", "pinyin": ["jiǔ", "huá", "zhàng", "lǐ", "mèng", "hún", "jīng"], "translation": "在九华帐里从睡梦中惊醒。", "noteIds": ["n-jiuhua"] },
    { "text": "揽衣推枕起徘徊，", "pinyin": ["lǎn", "yī", "tuī", "zhěn", "qǐ", "pái", "huái"], "translation": "她披上衣服、推开枕头，起身徘徊，", "noteIds": [] },
    { "text": "珠箔银屏迤逦开。", "pinyin": ["zhū", "bó", "yín", "píng", "yǐ", "lǐ", "kāi"], "translation": "珠帘和银屏风一路依次打开。", "noteIds": ["n-zhubo", "n-yinping", "n-yili"] },
    { "text": "云鬓半偏新睡觉，", "pinyin": ["yún", "bìn", "bàn", "piān", "xīn", "shuì", "jué"], "translation": "如云的鬓发还半偏着，她刚刚睡醒，", "noteIds": ["n-shuijue"] },
    { "text": "花冠不整下堂来。", "pinyin": ["huā", "guān", "bù", "zhěng", "xià", "táng", "lái"], "translation": "花冠还没来得及戴正，就匆匆走下堂来。", "noteIds": [] },
    { "text": "风吹仙袂飘飘举，", "pinyin": ["fēng", "chuī", "xiān", "mèi", "piāo", "piāo", "jǔ"], "translation": "风吹动她的衣袖，轻轻飘起，", "noteIds": ["n-xianmei"] },
    { "text": "犹似霓裳羽衣舞。", "pinyin": ["yóu", "sì", "ní", "cháng", "yǔ", "yī", "wǔ"], "translation": "还像当年《霓裳羽衣舞》的样子。", "noteIds": [] },
    { "text": "玉容寂寞泪阑干，", "pinyin": ["yù", "róng", "jì", "mò", "lèi", "lán", "gān"], "translation": "她美丽的面容带着寂寞，泪水纵横，", "noteIds": ["n-langan"] },
    { "text": "梨花一枝春带雨。", "pinyin": ["lí", "huā", "yì", "zhī", "chūn", "dài", "yǔ"], "translation": "就像一枝梨花，春天里带着雨。", "noteIds": [] },
    { "text": "含情凝睇谢君王，", "pinyin": ["hán", "qíng", "níng", "dì", "xiè", "jūn", "wáng"], "translation": "她含着深情久久凝望，感谢君王的思念，", "noteIds": ["n-ningdi"] },
    { "text": "一别音容两渺茫。", "pinyin": ["yì", "bié", "yīn", "róng", "liǎng", "miǎo", "máng"], "translation": "自从一别，两边都再也听不到声音、看不到容貌了。", "noteIds": [] },
    { "text": "昭阳殿里恩爱绝，", "pinyin": ["zhāo", "yáng", "diàn", "lǐ", "ēn", "ài", "jué"], "translation": "昭阳殿里的恩爱早已断绝，", "noteIds": ["n-zhaoyang"] },
    { "text": "蓬莱宫中日月长。", "pinyin": ["péng", "lái", "gōng", "zhōng", "rì", "yuè", "cháng"], "translation": "蓬莱仙宫里的岁月却这样漫长。", "noteIds": ["n-penglai"] },
    { "text": "回头下望人寰处，", "pinyin": ["huí", "tóu", "xià", "wàng", "rén", "huán", "chù"], "translation": "她回头向下望人世间，", "noteIds": ["n-renhuan"] },
    { "text": "不见长安见尘雾。", "pinyin": ["bú", "jiàn", "cháng", "ān", "jiàn", "chén", "wù"], "translation": "看不见长安，只看见一片尘雾。", "noteIds": [] },
    { "text": "惟将旧物表深情，", "pinyin": ["wéi", "jiāng", "jiù", "wù", "biǎo", "shēn", "qíng"], "translation": "她只好拿旧日的信物表达深情，", "noteIds": [] },
    { "text": "钿合金钗寄将去。", "pinyin": ["diàn", "hé", "jīn", "chāi", "jì", "jiāng", "qù"], "translation": "把钿盒和金钗托使者带回去。", "noteIds": ["n-dianhe"] },
    { "text": "钗留一股合一扇，", "pinyin": ["chāi", "liú", "yì", "gǔ", "hé", "yí", "shàn"], "translation": "金钗留下一股，钿盒留下一半，", "noteIds": [] },
    { "text": "钗擘黄金合分钿。", "pinyin": ["chāi", "bò", "huáng", "jīn", "hé", "fēn", "diàn"], "translation": "把金钗掰开、钿盒分开，各留一半作凭证。", "noteIds": ["n-bo"] },
    { "text": "但教心似金钿坚，", "pinyin": ["dàn", "jiào", "xīn", "sì", "jīn", "diàn", "jiān"], "translation": "只要心意像金钿一样坚固，", "noteIds": [] },
    { "text": "天上人间会相见。", "pinyin": ["tiān", "shàng", "rén", "jiān", "huì", "xiāng", "jiàn"], "translation": "无论天上人间，总会有相见的一天。", "noteIds": [] },
    { "text": "临别殷勤重寄词，", "pinyin": ["lín", "bié", "yīn", "qín", "chóng", "jì", "cí"], "translation": "临别时，她又恳切地再三捎话，", "noteIds": [] },
    { "text": "词中有誓两心知。", "pinyin": ["cí", "zhōng", "yǒu", "shì", "liǎng", "xīn", "zhī"], "translation": "话中有两个人当年都知道的誓言。", "noteIds": [] },
    { "text": "七月七日长生殿，", "pinyin": ["qī", "yuè", "qī", "rì", "cháng", "shēng", "diàn"], "translation": "那年七月七日，在长生殿里，", "noteIds": ["n-changsheng"] },
    { "text": "夜半无人私语时。", "pinyin": ["yè", "bàn", "wú", "rén", "sī", "yǔ", "shí"], "translation": "夜深无人时，两人悄悄说过的心里话——", "noteIds": [] },
    { "text": "在天愿作比翼鸟，", "pinyin": ["zài", "tiān", "yuàn", "zuò", "bǐ", "yì", "niǎo"], "translation": "在天上，愿意做比翼双飞的鸟儿，", "noteIds": ["n-biyi"] },
    { "text": "在地愿为连理枝。", "pinyin": ["zài", "dì", "yuàn", "wéi", "lián", "lǐ", "zhī"], "translation": "在地上，愿意做枝干相连的树木。", "noteIds": ["n-lianli"] },
    { "text": "天长地久有时尽，", "pinyin": ["tiān", "cháng", "dì", "jiǔ", "yǒu", "shí", "jìn"], "translation": "天再长、地再久，也总有个尽头，", "noteIds": [] },
    { "text": "此恨绵绵无绝期。", "pinyin": ["cǐ", "hèn", "mián", "mián", "wú", "jué", "qī"], "translation": "可这生死相隔的遗恨，绵绵不断，永无终结。", "noteIds": [] }
  ],
  "notes": [
    { "id": "n-hanhuang", "word": "汉皇", "pinyin": "hàn huáng", "meaning": "借指唐玄宗李隆基。诗人不便直说本朝皇帝，便用汉武帝来代指。" },
    { "id": "n-qingguo", "word": "倾国", "pinyin": "qīng guó", "meaning": "形容女子美到极点，全城全国的人都被她的美貌倾倒。" },
    { "id": "n-yuyu", "word": "御宇", "pinyin": "yù yǔ", "meaning": "统治天下。宇，指天下。" },
    { "id": "n-shengui", "word": "深闺", "pinyin": "shēn guī", "meaning": "旧时女子居住的深宅内室。" },
    { "id": "n-liugong", "word": "六宫", "pinyin": "liù gōng", "meaning": "皇帝的后宫，代指宫中所有的妃嫔。" },
    { "id": "n-fendai", "word": "粉黛", "pinyin": "fěn dài", "meaning": "女子化妆用的白粉和画眉的黛石，代指美女。" },
    { "id": "n-huaqing", "word": "华清池", "pinyin": "huá qīng chí", "meaning": "骊山上的温泉池，今陕西西安临潼，唐玄宗常带杨贵妃来此洗浴。" },
    { "id": "n-ningzhi", "word": "凝脂", "pinyin": "níng zhī", "meaning": "凝结的油脂，形容皮肤白嫩光滑。" },
    { "id": "n-buyao", "word": "金步摇", "pinyin": "jīn bù yáo", "meaning": "一种金首饰，插在发髻上，走起路来随步子轻轻摇动，所以叫步摇。" },
    { "id": "n-furongzhang", "word": "芙蓉帐", "pinyin": "fú róng zhàng", "meaning": "绣着荷花图案的华丽床帐。" },
    { "id": "n-zaochao", "word": "早朝", "pinyin": "zǎo cháo", "meaning": "臣子清晨进宫拜见皇帝、商议国事。" },
    { "id": "n-lietu", "word": "列土", "pinyin": "liè tǔ", "meaning": "分封土地。列，同“裂”。杨贵妃得宠后，杨家亲族都得了高官和封地。" },
    { "id": "n-ligong", "word": "骊宫", "pinyin": "lí gōng", "meaning": "骊山上的华清宫，唐玄宗和杨贵妃游乐的地方。" },
    { "id": "n-xianle", "word": "仙乐", "pinyin": "xiān yuè", "meaning": "像仙界音乐一样好听的音乐。乐，指音乐，读 yuè。" },
    { "id": "n-sizhu", "word": "丝竹", "pinyin": "sī zhú", "meaning": "弦乐器和管乐器，泛指音乐。" },
    { "id": "n-pigu", "word": "鼙鼓", "pinyin": "pí gǔ", "meaning": "战鼓。渔阳起兵的战鼓，指安禄山在渔阳发动叛乱。" },
    { "id": "n-nichang", "word": "霓裳羽衣曲", "pinyin": "ní cháng yǔ yī qǔ", "meaning": "唐代著名乐曲，相传唐玄宗参与创制，杨贵妃善跳此舞。裳，指下裙，读 cháng。" },
    { "id": "n-chengque", "word": "九重城阙", "pinyin": "jiǔ chóng chéng què", "meaning": "指京城长安。九重，形容宫门层层；城阙，宫殿前的望楼。" },
    { "id": "n-qiancheng", "word": "千乘", "pinyin": "qiān shèng", "meaning": "千辆兵车。乘，指四马拉的一辆车，读 shèng。" },
    { "id": "n-wanqi", "word": "万骑", "pinyin": "wàn jì", "meaning": "万名骑兵。骑，一人一马叫一骑，读 jì。" },
    { "id": "n-cuihua", "word": "翠华", "pinyin": "cuì huá", "meaning": "用翠鸟羽毛装饰的旗帜，是皇帝仪仗，代指皇帝的车驾。" },
    { "id": "n-liujun", "word": "六军", "pinyin": "liù jūn", "meaning": "皇帝的禁卫军。" },
    { "id": "n-emei", "word": "蛾眉", "pinyin": "é méi", "meaning": "像蚕蛾触须一样弯曲的细眉，代指美丽的女子，这里指杨贵妃。" },
    { "id": "n-huadian", "word": "花钿", "pinyin": "huā diàn", "meaning": "镶金花的首饰。钿，读 diàn。" },
    { "id": "n-cuiqiao", "word": "翠翘", "pinyin": "cuì qiáo", "meaning": "形如翠鸟尾羽的头饰。" },
    { "id": "n-saotou", "word": "玉搔头", "pinyin": "yù sāo tóu", "meaning": "玉簪子，可以用来搔头，所以叫玉搔头。" },
    { "id": "n-yunzhan", "word": "云栈", "pinyin": "yún zhàn", "meaning": "高入云端的山间栈道，在悬崖上凿孔架木铺成。" },
    { "id": "n-yingyu", "word": "萦纡", "pinyin": "yíng yū", "meaning": "曲折盘旋的样子。" },
    { "id": "n-jiange", "word": "剑阁", "pinyin": "jiàn gé", "meaning": "大剑山和小剑山之间的栈道，在今四川，是入蜀的必经之地。" },
    { "id": "n-emeishan", "word": "峨嵋山", "pinyin": "é méi shān", "meaning": "在今四川境内，唐玄宗入蜀途中经过之地。" },
    { "id": "n-longyu", "word": "龙驭", "pinyin": "lóng yù", "meaning": "皇帝的车驾。驭，驾车的马，这里指车驾。" },
    { "id": "n-maweipo", "word": "马嵬坡", "pinyin": "mǎ wéi pō", "meaning": "在今陕西兴平西。禁卫军在此哗变，杨贵妃被迫自尽。" },
    { "id": "n-taiye", "word": "太液", "pinyin": "tài yè", "meaning": "太液池，长安宫廷中人工开凿的大池。" },
    { "id": "n-weiyang", "word": "未央", "pinyin": "wèi yāng", "meaning": "未央宫，汉代宫殿名，唐代宫殿仍沿用其名。" },
    { "id": "n-nannei", "word": "西宫南内", "pinyin": "xī gōng nán nèi", "meaning": "太极宫和兴庆宫。玄宗退位后由兴庆宫迁居西边的太极宫。" },
    { "id": "n-liyuan", "word": "梨园", "pinyin": "lí yuán", "meaning": "唐玄宗培养乐工的地方。后来人们把戏曲艺人称为梨园弟子。" },
    { "id": "n-jiaofang", "word": "椒房", "pinyin": "jiāo fáng", "meaning": "用花椒和泥涂墙的后宫房屋，取温暖多子的好意头，是后妃住的地方。" },
    { "id": "n-ajian", "word": "阿监", "pinyin": "ā jiān", "meaning": "宫中的女官、宦官。阿，是词头，没有实际意思。" },
    { "id": "n-qinge", "word": "青娥", "pinyin": "qīng é", "meaning": "年轻美丽的宫女。" },
    { "id": "n-yuanyangwa", "word": "鸳鸯瓦", "pinyin": "yuān yāng wǎ", "meaning": "屋顶上一俯一仰、成对相合的瓦，像成双成对的鸳鸯。" },
    { "id": "n-feicuiqin", "word": "翡翠衾", "pinyin": "fěi cuì qīn", "meaning": "绣着翡翠鸟图案的锦被。衾，被子，读 qīn。" },
    { "id": "n-linqiong", "word": "临邛", "pinyin": "lín qióng", "meaning": "地名，在今四川邛崃。" },
    { "id": "n-hongdu", "word": "鸿都", "pinyin": "hóng dū", "meaning": "东汉洛阳的宫门名，这里借指长安。" },
    { "id": "n-fangshi", "word": "方士", "pinyin": "fāng shì", "meaning": "懂得法术、能寻访仙界的人，这里指为玄宗寻找杨贵妃魂魄的道士。" },
    { "id": "n-biluo", "word": "碧落", "pinyin": "bì luò", "meaning": "天空。道教把天空最高处称为碧落。" },
    { "id": "n-huangquan", "word": "黄泉", "pinyin": "huáng quán", "meaning": "地下深处，指人死后去的地方。" },
    { "id": "n-chuoyue", "word": "绰约", "pinyin": "chuò yuē", "meaning": "姿态柔美轻盈的样子。" },
    { "id": "n-taizhen", "word": "太真", "pinyin": "tài zhēn", "meaning": "杨贵妃做女道士时用过的道号，这里指杨贵妃。" },
    { "id": "n-jinque", "word": "金阙", "pinyin": "jīn què", "meaning": "仙宫的门楼。" },
    { "id": "n-yujiong", "word": "玉扃", "pinyin": "yù jiōng", "meaning": "玉做的门。扃，本指门闩，这里指门。" },
    { "id": "n-xiaoyu", "word": "小玉", "pinyin": "xiǎo yù", "meaning": "传说中西王母的侍女。" },
    { "id": "n-shuangcheng", "word": "双成", "pinyin": "shuāng chéng", "meaning": "传说中西王母的侍女董双成，这里指太真的侍女。" },
    { "id": "n-jiuhua", "word": "九华帐", "pinyin": "jiǔ huá zhàng", "meaning": "绣饰繁多的华美帐子。九华，形容花样繁盛。" },
    { "id": "n-zhubo", "word": "珠箔", "pinyin": "zhū bó", "meaning": "用珍珠串成的帘子。箔，帘子，读 bó。" },
    { "id": "n-yinping", "word": "银屏", "pinyin": "yín píng", "meaning": "镶银装饰的屏风。" },
