        "dì",
        "shì",
        "nǚ",
        "bā",
        "qiān",
        "rén"
      ],
      "translation": "先帝宫中的歌舞侍女有八千人，",
      "noteIds": []
    },
    {
      "text": "公孙剑器初第一。",
      "pinyin": [
        "gōng",
        "sūn",
        "jiàn",
        "qì",
        "chū",
        "dì",
        "yī"
      ],
      "translation": "公孙大娘的剑器舞，本数第一。",
      "noteIds": []
    },
    {
      "text": "五十年间似反掌，",
      "pinyin": [
