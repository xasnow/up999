  "lines": [
    {
      "text": "幽意无断绝，",
      "pinyin": ["yōu", "yì", "wú", "duàn", "jué"],
      "translation": "游山玩水的兴致，从来没有断过，",
      "noteIds": []
    },
    {
      "text": "此去随所偶。",
      "pinyin": ["cǐ", "qù", "suí", "suǒ", "ǒu"],
      "translation": "这一趟出行，就任凭小船漂到哪儿算哪儿。",
      "noteIds": ["n-ou"]
    },
    {
      "text": "晚风吹行舟，",
      "pinyin": ["wǎn", "fēng", "chuī", "xíng", "zhōu"],
      "translation": "晚风轻轻推着小船前行，",
      "noteIds": []
    },
    {
      "text": "花路入溪口。",
      "pinyin": ["huā", "lù", "rù", "xī", "kǒu"],
      "translation": "沿着开满花的堤岸，驶进了溪口。",
      "noteIds": []
    },
    {
      "text": "际夜转西壑，",
      "pinyin": ["jì", "yè", "zhuǎn", "xī", "hè"],
      "translation": "到了夜里，小船转过西边的山谷，",
      "noteIds": ["n-jixi"]
    },
    {
      "text": "隔山望南斗。",
      "pinyin": ["gé", "shān", "wàng", "nán", "dǒu"],
      "translation": "隔着山，抬头望见南斗星。",
      "noteIds": []
    },
    {
      "text": "潭烟飞溶溶，",
      "pinyin": ["tán", "yān", "fēi", "róng", "róng"],
      "translation": "潭水上的雾气轻飘飘地浮动，",
      "noteIds": ["n-tanyan", "n-rou"]
    },
    {
      "text": "林月低向后。",
      "pinyin": ["lín", "yuè", "dī", "xiàng", "hòu"],
      "translation": "林间的月亮低低地照着，好像随着船往后退。",
      "noteIds": []
    },
    {
      "text": "生事且弥漫，",
      "pinyin": ["shēng", "shì", "qiě", "mí", "màn"],
      "translation": "人间的生计和世事，也像这雾一样茫茫一片，",
      "noteIds": ["n-shengshi"]
    },
    {
      "text": "愿为持竿叟。",
      "pinyin": ["yuàn", "wéi", "chí", "gān", "sǒu"],
      "translation": "我情愿做一个握着钓竿的老渔翁。",
      "noteIds": ["n-sou"]
    }
