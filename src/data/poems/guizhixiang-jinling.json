  "writtenLabel": "约公元 1067 年（王安石 46 岁，出知江宁府；一说作于罢相后退居金陵时）",
  "orderInAuthor": 1,
  "famousLines": [
    "六朝旧事随流水，但寒烟衰草凝绿。",
    "至今商女，时时犹唱，后庭遗曲。"
  ],
  "lines": [
    {
      "text": "登临送目，",
      "pinyin": [
        "dēng",
        "lín",
        "sòng",
        "mù"
      ],
      "translation": "登上高处，放眼远望，",
      "noteIds": []
    },
    {
      "text": "正故国晚秋，",
      "pinyin": [
        "zhèng",
        "gù",
        "guó",
        "wǎn",
        "qiū"
      ],
      "translation": "正是故都金陵的晚秋，",
      "noteIds": []
    },
    {
      "text": "天气初肃。",
      "pinyin": [
        "tiān",
        "qì",
        "chū",
        "sù"
      ],
      "translation": "天气刚刚变得清朗肃爽。",
      "noteIds": [
        "n-chusu"
      ]
    },
    {
      "text": "千里澄江似练，",
      "pinyin": [
        "qiān",
        "lǐ",
        "chéng",
        "jiāng",
        "sì",
        "liàn"
      ],
      "translation": "千里长江清澈得像一条白绢，",
      "noteIds": [
        "n-lian"
      ]
    },
    {
      "text": "翠峰如簇。",
      "pinyin": [
        "cuì",
        "fēng",
        "rú",
        "cù"
      ],
      "translation": "青翠的山峰像箭头一样攒聚在一起。",
      "noteIds": [
        "n-cu"
      ]
    },
    {
      "text": "归帆去棹残阳里，",
      "pinyin": [
        "guī",
        "fān",
        "qù",
        "zhào",
        "cán",
        "yáng",
        "lǐ"
      ],
      "translation": "往来的船只行驶在残阳里，",
      "noteIds": []
    },
    {
      "text": "背西风，",
      "pinyin": [
        "bèi",
        "xī",
        "fēng"
      ],
      "translation": "背对着西风，",
      "noteIds": []
    },
    {
      "text": "酒旗斜矗。",
      "pinyin": [
        "jiǔ",
        "qí",
        "xié",
        "chù"
      ],
      "translation": "酒旗斜斜地竖立着。",
      "noteIds": []
    },
    {
      "text": "彩舟云淡，",
      "pinyin": [
        "cǎi",
        "zhōu",
        "yún",
        "dàn"
      ],
      "translation": "华丽的画船航行在淡淡的云影里，",
      "noteIds": []
    },
    {
      "text": "星河鹭起，",
      "pinyin": [
        "xīng",
        "hé",
        "lù",
        "qǐ"
      ],
      "translation": "白鹭从银河般的江面上飞起，",
      "noteIds": [
        "n-xinghe"
      ]
    },
    {
      "text": "画图难足。",
      "pinyin": [
        "huà",
        "tú",
        "nán",
        "zú"
      ],
      "translation": "这样的美景，用图画也难以画全。",
      "noteIds": []
    },
    {
      "text": "念往昔，",
      "pinyin": [
        "niàn",
        "wǎng",
        "xī"
      ],
      "translation": "想起往昔，",
      "noteIds": []
    },
    {
      "text": "繁华竞逐，",
      "pinyin": [
        "fán",
        "huá",
        "jìng",
        "zhú"
      ],
      "translation": "六朝的统治者争着过豪华奢侈的生活，",
      "noteIds": []
    },
    {
      "text": "叹门外楼头，",
      "pinyin": [
        "tàn",
        "mén",
        "wài",
        "lóu",
        "tóu"
      ],
      "translation": "可叹隋军已兵临城门外，陈后主还在楼头寻欢，",
      "noteIds": [
        "n-loutou"
      ]
    },
    {
      "text": "悲恨相续。",
      "pinyin": [
        "bēi",
        "hèn",
        "xiāng",
        "xù"
      ],
      "translation": "亡国的悲哀和遗恨一代接着一代。",
      "noteIds": []
    },
    {
      "text": "千古凭高对此，",
      "pinyin": [
        "qiān",
        "gǔ",
        "píng",
        "gāo",
        "duì",
        "cǐ"
      ],
      "translation": "千百年来多少人登高面对此景，",
      "noteIds": []
    },
    {
      "text": "谩嗟荣辱。",
      "pinyin": [
        "màn",
        "jiē",
        "róng",
        "rǔ"
      ],
      "translation": "只能空空地叹息荣耀与屈辱。",
      "noteIds": []
    },
    {
      "text": "六朝旧事随流水，",
      "pinyin": [
        "liù",
        "cháo",
        "jiù",
        "shì",
        "suí",
        "liú",
        "shuǐ"
      ],
      "translation": "六朝的旧事已经随着流水远去，",
      "noteIds": []
    },
    {
      "text": "但寒烟衰草凝绿。",
      "pinyin": [
        "dàn",
        "hán",
        "yān",
        "shuāi",
        "cǎo",
        "níng",
        "lǜ"
      ],
      "translation": "只剩下寒烟笼罩的衰草，凝成一片暗绿。",
      "noteIds": []
    },
    {
      "text": "至今商女，",
      "pinyin": [
        "zhì",
        "jīn",
        "shāng",
        "nǚ"
      ],
      "translation": "直到今天，歌女们",
      "noteIds": [
        "n-shangnü"
      ]
    },
    {
      "text": "时时犹唱，",
      "pinyin": [
        "shí",
        "shí",
        "yóu",
        "chàng"
      ],
      "translation": "还时时唱着，",
      "noteIds": []
    },
    {
      "text": "后庭遗曲。",
      "pinyin": [
        "hòu",
        "tíng",
        "yí",
        "qǔ"
      ],
      "translation": "陈后主留下的那支亡国之曲。",
      "noteIds": [
        "n-houting"
      ]
    }
  ],
