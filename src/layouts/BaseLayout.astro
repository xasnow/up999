---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteTree from '../components/SiteTree.astro';
import PageToc from '../components/PageToc.astro';
import MobileNav from '../components/MobileNav.astro';
import { SITE_KEYWORDS } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** 本页关键词（覆盖 seo.json），不传则用全站默认 */
  keywords?: string;
  /** 结构化数据 JSON-LD（可选，对象或数组） */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** 是否显示双侧目录（首页/关于/404 用 false） */
  nav?: boolean;
}
const {
  title,
  description = '为小学生做的古诗词学习网站：带拼音、有漫画、跟着时间线读懂每一首诗。',
  keywords,
  jsonLd,
  nav = true
} = Astro.props;

// canonical 与 OG 地址：构建期为页面静态路径
const canonical = new URL(Astro.url.pathname, Astro.site);
const keywordStr = keywords ?? SITE_KEYWORDS.site;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordStr} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="每天一首小古诗 · up999.cn" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {jsonLdList.length > 0 && (
      jsonLdList.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // 主题在首屏绘制前生效，避免闪烁
      try {
        document.documentElement.dataset.theme = localStorage.getItem('up999-theme') || 'light';
      } catch (e) {}
    </script>
  </head>
  <body>
    <SiteHeader />
    <div class:list={['layout-shell', { 'no-nav': !nav }]}>
      {nav && (
        <div class="side-left">
          <SiteTree />
        </div>
      )}
      <main class="page-main" id="page-main">
        <slot />
      </main>
      {nav && <PageToc />}
    </div>
    {nav && <MobileNav />}
    <footer class="site-footer">
      <nav class="footer-nav">
        <a href="/">首页</a>
        <a href="/tangshi/">唐诗</a>
        <a href="/songci/">宋词</a>
        <a href="/qita/">其他朝代</a>
        <a href="/about/">关于</a>
      </nav>
      <p class="footer-note">内容由人工校对，配图由 AI 辅助生成 · © up999.cn 每天一首小古诗</p>
    </footer>
    <script>
      // 拼音开关状态全站记忆（localStorage）
      const saved = localStorage.getItem('up999-pinyin');
      if (saved === 'off') document.body.classList.add('hide-pinyin');
    </script>
    <script>
      // 本页目录：采集正文 h2 生成锚点，滚动时高亮当前章节
      const main = document.getElementById('page-main');
      const tocLists = document.querySelectorAll('[data-page-toc]');
      if (main && tocLists.length) {
        const headings = Array.from(main.querySelectorAll('h2'));
        const labelOf = (h) => {
          const clone = h.cloneNode(true);
          clone.querySelectorAll('small, em').forEach((n) => n.remove());
          return clone.textContent?.trim() || '';
        };

        headings.forEach((h, i) => {
          if (!h.id) h.id = `sec-${i + 1}`;
        });

        const items = headings.map((h) => ({ id: h.id, text: labelOf(h) }));
        tocLists.forEach((list) => {
          list.innerHTML = items
            .map((it) => `<li><a href="#${it.id}">${it.text}</a></li>`)
            .join('');
        });

        // 没有足够章节时不显示目录列
        if (headings.length < 2) {
          document.querySelectorAll('.page-toc').forEach((el) => el.remove());
          document.querySelectorAll('.drawer-tab[data-tab="toc"]').forEach((el) => el.remove());
        }

        const links = Array.from(document.querySelectorAll('[data-page-toc] a'));
        let currentId = '';
        const setActive = (id) => {
          if (id === currentId) return;
          currentId = id;
          links.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${id}`));
        };

        let ticking = false;
        const onScroll = () => {
          let cur = headings[0]?.id ?? '';
          for (const h of headings) {
            if (h.getBoundingClientRect().top <= 120) cur = h.id;
          }
          // 已经滚到底部时，最后几节可能永远到不了顶部，直接高亮最后一节
          const atBottom =
            window.innerHeight + window.scrollY >=
            document.documentElement.scrollHeight - 4;
          if (atBottom && headings.length) cur = headings[headings.length - 1].id;
          if (cur) setActive(cur);
        };
        window.addEventListener(
          'scroll',
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              onScroll();
              ticking = false;
            });
          },
          { passive: true }
        );
        onScroll();
      }

      // 移动端抽屉
      const fab = document.getElementById('toc-fab');
      const drawer = document.getElementById('mobile-drawer');
      if (fab && drawer) {
        const setOpen = (open) => {
          drawer.classList.toggle('open', open);
          document.body.classList.toggle('drawer-open', open);
          fab.setAttribute('aria-expanded', String(open));
        };
        const toggle = () => setOpen(!drawer.classList.contains('open'));

        fab.addEventListener('click', toggle);
        drawer.querySelectorAll('[data-close]').forEach((el) => {
          el.addEventListener('click', () => setOpen(false));
        });
        drawer.querySelectorAll('.drawer-tab').forEach((tab) => {
          tab.addEventListener('click', () => {
            drawer
              .querySelectorAll('.drawer-tab')
              .forEach((t) => t.classList.toggle('active', t === tab));
            drawer
              .querySelectorAll('.drawer-pane')
              .forEach((p) => p.classList.toggle('active', p.dataset.pane === tab.dataset.tab));
          });
        });
        // 点击目录里的链接后自动收起抽屉
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      }
    </script>
  </body>
</html>
