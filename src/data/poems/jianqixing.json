      "pinyin": [
        "zú",
        "jiǎn",
        "huāng",
        "shān",
        "zhuǎn",
        "chóu",
        "jí"
      ],
      "translation": "脚上磨出了厚茧，在荒山里奔波，愁病更重了。",
      "noteIds": [
        "n-zujian"
      ]
    }
