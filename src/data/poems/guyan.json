  "lines": [
    {
      "text": "几行归塞尽，",
      "pinyin": ["jǐ", "háng", "guī", "sài", "jìn"],
      "translation": "几行北归塞外的大雁都已飞尽，",
      "noteIds": ["n-jihang"]
    },
    {
      "text": "念尔独何之。",
      "pinyin": ["niàn", "ěr", "dú", "hé", "zhī"],
      "translation": "我心念着你这孤雁，要独自飞向哪里。",
      "noteIds": ["n-er"]
    },
    {
      "text": "暮雨相呼失，",
      "pinyin": ["mù", "yǔ", "xiāng", "hū", "shī"],
      "translation": "暮雨中你呼唤着失散的同伴，",
      "noteIds": ["n-hushi"]
    },
    {
      "text": "寒塘欲下迟。",
      "pinyin": ["hán", "táng", "yù", "xià", "chí"],
      "translation": "想落到寒塘边，又迟疑不定。",
      "noteIds": []
    },
    {
      "text": "渚云低暗度，",
      "pinyin": ["zhǔ", "yún", "dī", "àn", "dù"],
      "translation": "你低低穿过水洲上空的乌云，",
      "noteIds": ["n-zhu"]
    },
    {
      "text": "关月冷相随。",
      "pinyin": ["guān", "yuè", "lěng", "xiāng", "suí"],
      "translation": "只有清冷的关月与你相随。",
      "noteIds": []
    },
    {
      "text": "未必逢矰缴，",
      "pinyin": ["wèi", "bì", "féng", "zēng", "zhuó"],
      "translation": "其实未必会遭到暗箭的伤害，",
      "noteIds": ["n-zengjiao"]
    },
    {
      "text": "孤飞自可疑。",
      "pinyin": ["gū", "fēi", "zì", "kě", "yí"],
      "translation": "可独自孤飞，怎能不让人疑惧？",
