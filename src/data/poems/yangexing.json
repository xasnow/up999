    { "id": "n-yuzhu", "word": "玉箸", "pinyin": "yù zhù", "meaning": "玉筷子，比喻思妇的眼泪。" },
    { "id": "n-piaoyao", "word": "飘飖", "pinyin": "piāo yáo", "meaning": "飘摇不定，指战局动荡。" },
    { "id": "n-diaodou", "word": "刁斗", "pinyin": "diāo dǒu", "meaning": "军中铜器，白天做饭，夜里敲它报时警戒。" },
