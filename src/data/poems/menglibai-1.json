  "lines": [
    {
      "text": "死别已吞声，",
      "pinyin": [
        "sǐ",
        "bié",
        "yǐ",
        "tūn",
        "shēng"
      ],
      "translation": "死别时哭得发不出声音，",
      "noteIds": [
        "n-tunsheng"
      ]
    },
    {
      "text": "生别常恻恻。",
      "pinyin": [
        "shēng",
        "bié",
        "cháng",
        "cè",
        "cè"
      ],
      "translation": "活着分开，却常常忧伤不止。",
      "noteIds": [
        "n-cece"
      ]
    },
    {
      "text": "江南瘴疠地，",
      "pinyin": [
        "jiāng",
        "nán",
        "zhàng",
        "lì",
        "dì"
      ],
      "translation": "你流放的江南，是瘴气流行的地方，",
      "noteIds": [
        "n-zhangli"
      ]
    },
    {
      "text": "逐客无消息。",
      "pinyin": [
        "zhú",
        "kè",
        "wú",
        "xiāo",
        "xī"
      ],
      "translation": "被放逐的人一直没有什么消息。",
      "noteIds": [
        "n-zhuke"
      ]
    },
    {
      "text": "故人入我梦，",
      "pinyin": [
        "gù",
        "rén",
        "rù",
        "wǒ",
        "mèng"
      ],
      "translation": "老朋友走进我的梦中，",
      "noteIds": []
    },
    {
      "text": "明我长相忆。",
      "pinyin": [
        "míng",
        "wǒ",
        "cháng",
        "xiāng",
        "yì"
      ],
      "translation": "说明我一直在把他挂念。",
      "noteIds": []
    },
    {
      "text": "恐非平生魂，",
      "pinyin": [
        "kǒng",
        "fēi",
        "píng",
        "shēng",
        "hún"
      ],
      "translation": "我担心这不是他生前的魂魄，",
      "noteIds": []
    },
    {
      "text": "路远不可测。",
      "pinyin": [
        "lù",
        "yuǎn",
        "bù",
        "kě",
        "cè"
      ],
      "translation": "路途那么遥远，实在难以推测。",
      "noteIds": []
    },
    {
      "text": "魂来枫叶青，",
      "pinyin": [
        "hún",
        "lái",
        "fēng",
        "yè",
        "qīng"
      ],
      "translation": "魂魄来时，穿过江南青青的枫林，",
      "noteIds": [
        "n-fengye"
      ]
    },
    {
      "text": "魂返关塞黑。",
      "pinyin": [
        "hún",
        "fǎn",
        "guān",
        "sài",
        "hēi"
      ],
      "translation": "回去时要飞过黑沉沉的关塞。",
      "noteIds": [
        "n-guansai"
      ]
    },
    {
      "text": "君今在罗网，",
      "pinyin": [
        "jūn",
        "jīn",
        "zài",
        "luó",
        "wǎng"
      ],
      "translation": "如今你正陷在罗网之中，",
      "noteIds": [
        "n-luowang"
      ]
    },
    {
      "text": "何以有羽翼。",
      "pinyin": [
        "hé",
        "yǐ",
        "yǒu",
        "yǔ",
        "yì"
      ],
      "translation": "怎么还能生出翅膀自由来去？",
      "noteIds": []
    },
    {
      "text": "落月满屋梁，",
      "pinyin": [
        "luò",
        "yuè",
        "mǎn",
        "wū",
        "liáng"
      ],
      "translation": "下落的月光洒满屋梁，",
      "noteIds": []
    },
    {
      "text": "犹疑照颜色。",
      "pinyin": [
        "yóu",
        "yí",
        "zhào",
        "yán",
        "sè"
      ],
      "translation": "我恍惚觉得，那光照着你的面容。",
      "noteIds": [
        "n-yanse"
      ]
