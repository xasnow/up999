  ],
  "lines": [
    {
      "text": "十二楼中尽晓妆，",
      "pinyin": ["shí", "èr", "lóu", "zhōng", "jìn", "xiǎo", "zhuāng"],
      "translation": "仙宫般的高楼里，宫女们一早都在梳妆。",
      "noteIds": ["n-shierlou"]
    },
    {
      "text": "望仙楼上望君王。",
      "pinyin": ["wàng", "xiān", "lóu", "shàng", "wàng", "jūn", "wáng"],
      "translation": "在望仙楼上，痴痴地望着君王来的方向。",
      "noteIds": ["n-wangxianlou"]
    },
    {
      "text": "锁衔金兽连环冷，",
      "pinyin": ["suǒ", "xián", "jīn", "shòu", "lián", "huán", "lěng"],
      "translation": "门锁上金兽衔着的连环，摸上去冷冰冰。",
      "noteIds": ["n-jinshou"]
    },
    {
      "text": "水滴铜龙昼漏长。",
      "pinyin": ["shuǐ", "dī", "tóng", "lóng", "zhòu", "lòu", "cháng"],
      "translation": "铜龙漏壶滴着水，白天显得格外长。",
      "noteIds": ["n-tonglong"]
    },
    {
      "text": "云髻罢梳还对镜，",
      "pinyin": ["yún", "jì", "bà", "shū", "hái", "duì", "jìng"],
      "translation": "高高的发髻梳好了，还对着镜子照了又照。",
      "noteIds": ["n-yunji"]
    },
    {
      "text": "罗衣欲换更添香。",
      "pinyin": ["luó", "yī", "yù", "huàn", "gèng", "tiān", "xiāng"],
      "translation": "想换一件罗衣，还要再熏上更多香气。",
      "noteIds": []
    },
    {
      "text": "遥窥正殿帘开处，",
      "pinyin": ["yáo", "kuī", "zhèng", "diàn", "lián", "kāi", "chù"],
      "translation": "远远望见正殿帘子掀开的地方，",
      "noteIds": ["n-kui"]
    },
    {
      "text": "袍袴宫人扫御床。",
      "pinyin": ["páo", "kù", "gōng", "rén", "sǎo", "yù", "chuáng"],
      "translation": "只有穿袍裤的宫人在打扫御床。",
      "noteIds": ["n-paoku"]
    }
