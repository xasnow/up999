  "writtenYear": 753,
  "writtenLabel": "约公元 753 年春（杜甫 41 岁，在长安，见杨氏兄妹曲江游宴的奢靡）",
  "orderInAuthor": 1,
  "famousLines": [
    "态浓意远淑且真，肌理细腻骨肉匀。",
    "炙手可热势绝伦，慎莫近前丞相嗔。"
  ],
  "lines": [
    {
      "text": "三月三日天气新，",
      "pinyin": [
        "sān",
        "yuè",
        "sān",
        "rì",
        "tiān",
        "qì",
        "xīn"
      ],
      "translation": "三月三日的上巳节，天气清新，",
      "noteIds": []
    },
    {
      "text": "长安水边多丽人。",
      "pinyin": [
        "cháng",
        "ān",
        "shuǐ",
        "biān",
        "duō",
        "lì",
        "rén"
      ],
      "translation": "长安曲江水边到处是游春的美人。",
      "noteIds": []
    },
    {
      "text": "态浓意远淑且真，",
      "pinyin": [
        "tài",
        "nóng",
        "yì",
        "yuǎn",
        "shū",
        "qiě",
        "zhēn"
      ],
      "translation": "她们姿态浓艳、神情高雅，文淑又自然，",
      "noteIds": []
    },
    {
      "text": "肌理细腻骨肉匀。",
      "pinyin": [
        "jī",
        "lǐ",
        "xì",
        "nì",
        "gǔ",
        "ròu",
        "yún"
      ],
      "translation": "肌肤细腻，身材丰瘦匀称。",
      "noteIds": []
    },
    {
      "text": "绣罗衣裳照暮春，",
      "pinyin": [
        "xiù",
        "luó",
        "yī",
        "cháng",
        "zhào",
        "mù",
        "chūn"
      ],
      "translation": "绣花的罗衣在暮春的阳光下闪闪发亮，",
      "noteIds": []
    },
    {
      "text": "蹙金孔雀银麒麟。",
      "pinyin": [
        "cù",
        "jīn",
        "kǒng",
        "què",
        "yín",
        "qí",
        "lín"
      ],
      "translation": "金线绣的孔雀、银线绣的麒麟在衣上闪光。",
      "noteIds": [
        "n-cuojin"
      ]
    },
    {
      "text": "头上何所有？",
      "pinyin": [
        "tóu",
        "shàng",
        "hé",
        "suǒ",
        "yǒu"
      ],
      "translation": "她们头上戴的是什么？",
      "noteIds": []
    },
    {
      "text": "翠微盍叶垂鬓唇。",
      "pinyin": [
        "cuì",
        "wēi",
        "hé",
        "yè",
        "chuí",
        "bìn",
        "chún"
      ],
      "translation": "翡翠的花叶饰垂在鬓边。",
      "noteIds": [
        "n-cuiwei"
      ]
    },
    {
      "text": "背后何所见？",
      "pinyin": [
        "bèi",
        "hòu",
        "hé",
        "suǒ",
        "jiàn"
      ],
      "translation": "她们背后看到的是什么？",
      "noteIds": []
    },
    {
      "text": "珠压腰衱稳称身。",
      "pinyin": [
        "zhū",
        "yā",
        "yāo",
        "jié",
        "wěn",
        "chèn",
        "shēn"
      ],
      "translation": "珍珠缀压的裙带服服帖帖，正好合身。",
      "noteIds": [
        "n-yaojie"
      ]
    },
    {
      "text": "就中云幕椒房亲，",
      "pinyin": [
        "jiù",
        "zhōng",
        "yún",
        "mù",
        "jiāo",
        "fáng",
        "qīn"
      ],
      "translation": "其中有几位是后妃的亲属，坐在云帐锦幕之中，",
      "noteIds": [
        "n-jiaofangqin"
      ]
    },
    {
      "text": "赐名大国虢与秦。",
      "pinyin": [
        "cì",
        "míng",
        "dà",
        "guó",
        "guó",
        "yǔ",
        "qín"
      ],
      "translation": "皇帝赐封她们为虢国夫人与秦国夫人。",
      "noteIds": [
        "n-guoqin"
      ]
    },
    {
      "text": "紫驼之峰出翠釜，",
      "pinyin": [
        "zǐ",
        "tuó",
        "zhī",
        "fēng",
        "chū",
        "cuì",
        "fǔ"
      ],
      "translation": "紫色驼峰肉盛在翠绿的锅里端出，",
      "noteIds": []
    },
    {
      "text": "水精之盘行素鳞。",
      "pinyin": [
        "shuǐ",
        "jīng",
        "zhī",
        "pán",
        "xíng",
        "sù",
        "lín"
      ],
      "translation": "水晶盘里盛着鲜白的鳞鱼。",
      "noteIds": []
    },
    {
      "text": "犀箸厌饫久未下，",
      "pinyin": [
        "xī",
        "zhù",
        "yàn",
        "yù",
        "jiǔ",
        "wèi",
        "xià"
      ],
      "translation": "犀角筷子早已吃腻了山珍，久久没有动，",
      "noteIds": [
        "n-xizhu",
        "n-yaoyu"
      ]
    },
    {
      "text": "鸾刀缕切空纷纶。",
      "pinyin": [
        "luán",
        "dāo",
        "lǚ",
        "qiè",
        "kōng",
        "fēn",
        "lún"
      ],
      "translation": "厨师的鸾刀细细切肉，忙碌却白费。",
      "noteIds": []
    },
    {
      "text": "黄门飞鞚不动尘，",
      "pinyin": [
        "huáng",
        "mén",
        "fēi",
        "kòng",
        "bù",
        "dòng",
        "chén"
      ],
      "translation": "宦官骑马飞驰而来，却不起一点尘土，",
      "noteIds": [
        "n-kong"
      ]
    },
    {
      "text": "御厨络绎送八珍。",
      "pinyin": [
        "yù",
        "chú",
        "luò",
        "yì",
        "sòng",
        "bā",
        "zhēn"
      ],
      "translation": "御厨接连不断地送来八方珍馐。",
      "noteIds": []
    },
    {
      "text": "箫鼓哀吟感鬼神，",
      "pinyin": [
        "xiāo",
        "gǔ",
        "āi",
        "yín",
        "gǎn",
        "guǐ",
        "shén"
      ],
      "translation": "箫鼓吹奏出的乐声哀婉动人，仿佛能感动鬼神，",
      "noteIds": []
    },
    {
      "text": "宾从杂遝实要津。",
      "pinyin": [
        "bīn",
        "cóng",
        "zá",
        "tà",
        "shí",
        "yāo",
        "jīn"
      ],
      "translation": "宾客随从杂沓而至，都是身居要职的人物。",
      "noteIds": [
        "n-zata"
      ]
    },
    {
      "text": "后来鞍马何逡巡，",
      "pinyin": [
        "hòu",
        "lái",
        "ān",
        "mǎ",
        "hé",
        "qūn",
        "xún"
      ],
      "translation": "后来到场的骑马者大模大样，缓缓而来，",
      "noteIds": [
        "n-qunxun"
      ]
    },
    {
      "text": "当轩下马入锦茵。",
      "pinyin": [
        "dāng",
        "xuān",
        "xià",
        "mǎ",
        "rù",
        "jǐn",
        "yīn"
      ],
      "translation": "他当着厅堂前下马，径直踏上锦绣的地毯。",
      "noteIds": []
    },
    {
      "text": "杨花雪落覆白蘋，",
      "pinyin": [
        "yáng",
        "huā",
        "xuě",
        "luò",
        "fù",
        "bái",
        "pín"
      ],
      "translation": "杨花像雪一样飘落，覆盖在水面的白蘋上，",
      "noteIds": []
    },
    {
      "text": "青鸟飞去衔红巾。",
      "pinyin": [
        "qīng",
        "niǎo",
        "fēi",
        "qù",
        "xián",
        "hóng",
        "jīn"
      ],
      "translation": "青鸟飞去，衔走了传递消息的红手帕。",
      "noteIds": []
    },
    {
      "text": "炙手可热势绝伦，",
      "pinyin": [
        "zhì",
        "shǒu",
        "kě",
        "rè",
        "shì",
        "jué",
        "lún"
      ],
      "translation": "他权势之大，烫得别人不敢靠近，",
      "noteIds": []
    },
    {
      "text": "慎莫近前丞相嗔。",
      "pinyin": [
        "shèn",
        "mò",
        "jìn",
        "qián",
        "chéng",
        "xiàng",
        "chēn"
      ],
      "translation": "可千万别靠近，小心丞相杨国忠发怒。",
      "noteIds": []
    }
  ],
