    {
      "text": "世事两茫茫。",
      "pinyin": [
        "shì",
        "shì",
        "liǎng",
        "máng",
        "máng"
      ],
      "translation": "你和我的前路，都茫茫难料了。",
      "noteIds": []
    }
  ],
