  "lines": [
    {
      "text": "近寒食雨草萋萋，",
      "pinyin": ["jìn", "hán", "shí", "yǔ", "cǎo", "qī", "qī"],
      "translation": "快到寒食节了，细雨中春草长得又密又绿，",
      "noteIds": ["n-hanshi", "n-qiqi"]
    },
    {
      "text": "著麦苗风柳映堤。",
      "pinyin": ["zhuó", "mài", "miáo", "fēng", "liǔ", "yìng", "dī"],
      "translation": "风拂过麦苗，柳荫掩映着长堤。",
      "noteIds": []
    },
    {
      "text": "等是有家归未得，",
      "pinyin": ["děng", "shì", "yǒu", "jiā", "guī", "wèi", "dé"],
      "translation": "同样是有家的人，却回不去，",
      "noteIds": ["n-dengshi"]
    },
    {
      "text": "杜鹃休向耳边啼。",
      "pinyin": ["dù", "juān", "xiū", "xiàng", "ěr", "biān", "tí"],
      "translation": "杜鹃鸟啊，请别再对着我的耳朵啼叫了。",
      "noteIds": ["n-dujuan"]
    }
  ],
