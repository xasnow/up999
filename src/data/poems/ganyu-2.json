  "famousLines": [
    "草木有本心，何求美人折。"
  ],
  "lines": [
    {
      "text": "兰叶春葳蕤，",
      "pinyin": ["lán", "yè", "chūn", "wēi", "ruí"],
      "translation": "兰草在春天枝叶繁茂，",
      "noteIds": ["n-wei-rui"]
    },
    {
      "text": "桂华秋皎洁。",
      "pinyin": ["guì", "huā", "qiū", "jiǎo", "jié"],
      "translation": "桂花在秋天开得皎洁清新。",
      "noteIds": ["n-hua"]
    },
    {
      "text": "欣欣此生意，",
      "pinyin": ["xīn", "xīn", "cǐ", "shēng", "yì"],
      "translation": "它们生机勃勃，欣欣向荣，",
      "noteIds": []
    },
    {
      "text": "自尔为佳节。",
      "pinyin": ["zì", "ěr", "wéi", "jiā", "jié"],
      "translation": "自然而然地装点了美好的季节。",
      "noteIds": []
    },
    {
      "text": "谁知林栖者，",
      "pinyin": ["shuí", "zhī", "lín", "qī", "zhě"],
      "translation": "谁知道住在山林里的隐士，",
      "noteIds": ["n-qi"]
    },
    {
      "text": "闻风坐相悦。",
      "pinyin": ["wén", "fēng", "zuò", "xiāng", "yuè"],
      "translation": "闻到花香，就满心欢喜起来。",
      "noteIds": ["n-zuo"]
    },
    {
      "text": "草木有本心，",
      "pinyin": ["cǎo", "mù", "yǒu", "běn", "xīn"],
      "translation": "草木散发香气是天性使然，",
      "noteIds": []
    },
    {
      "text": "何求美人折。",
      "pinyin": ["hé", "qiú", "měi", "rén", "zhé"],
      "translation": "哪里是为了求人攀折欣赏呢。",
      "noteIds": []
    }
  ],
