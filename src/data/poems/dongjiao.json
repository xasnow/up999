  "famousLines": [
    "杨柳散和风，青山澹吾虑。"
  ],
  "lines": [
    {
      "text": "吏舍跼终年，",
      "pinyin": ["lì", "shè", "jú", "zhōng", "nián"],
      "translation": "在官舍里拘束地待了一整年，",
      "noteIds": ["n-ju"]
    },
    {
      "text": "出郊旷清曙。",
      "pinyin": ["chū", "jiāo", "kuàng", "qīng", "shǔ"],
      "translation": "清早走出城郊，顿时觉得开阔舒畅。",
      "noteIds": ["n-shu"]
    },
    {
      "text": "杨柳散和风，",
      "pinyin": ["yáng", "liǔ", "sàn", "hé", "fēng"],
      "translation": "杨柳在和风里轻轻舒展，",
      "noteIds": []
    },
    {
      "text": "青山澹吾虑。",
      "pinyin": ["qīng", "shān", "dàn", "wú", "lǜ"],
      "translation": "青山的颜色让我心中的思虑安静下来。",
      "noteIds": ["n-dan"]
    },
    {
      "text": "依丛适自憩，",
      "pinyin": ["yī", "cóng", "shì", "zì", "qì"],
      "translation": "靠着树丛歇一歇，",
      "noteIds": ["n-qi"]
    },
    {
      "text": "缘涧还复去。",
      "pinyin": ["yuán", "jiàn", "huán", "fù", "qù"],
      "translation": "又沿着山涧走，走了还想去。",
      "noteIds": []
    },
    {
      "text": "微雨霭芳原，",
      "pinyin": ["wēi", "yǔ", "ǎi", "fāng", "yuán"],
      "translation": "细雨的雾气笼罩着芬芳的原野，",
      "noteIds": ["n-ai"]
    },
    {
      "text": "春鸠鸣何处。",
      "pinyin": ["chūn", "jiū", "míng", "hé", "chù"],
      "translation": "不知从哪里传来斑鸠的鸣叫。",
      "noteIds": []
    },
    {
      "text": "乐幽心屡止，",
      "pinyin": ["lè", "yōu", "xīn", "lǚ", "zhǐ"],
      "translation": "喜欢这清幽的地方，心思几次想留下，",
      "noteIds": []
    },
    {
      "text": "遵事迹犹遽。",
      "pinyin": ["zūn", "shì", "jì", "yóu", "jù"],
      "translation": "可公务在身，脚步还是匆匆。",
      "noteIds": ["n-ju2"]
    },
    {
      "text": "终罢斯结庐，",
      "pinyin": ["zhōng", "bà", "sī", "jié", "lú"],
      "translation": "等最终辞了官，就在这里盖间小屋，",
      "noteIds": []
    },
    {
      "text": "慕陶直可庶。",
      "pinyin": ["mù", "táo", "zhí", "kě", "shù"],
      "translation": "学陶渊明归隐田园，这个愿望差不多能实现。",
      "noteIds": ["n-shu2"]
    }
  ],
