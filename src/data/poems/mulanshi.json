{
  "id": "qita-hanwei-beichao-mulanshi",
  "slug": "mulanshi",
  "title": "木兰诗",
  "titlePinyin": "mù lán shī",
  "dynasty": "qita",
  "era": "hanwei",
  "genre": "shi",
  "form": "乐府",
  "authorId": "beichao",
  "gradeBand": "ext",
  "tags": [
    "爱国",
    "乐府",
    "边塞",
    "骏马"
  ],
  "difficulty": 3,
  "writtenYear": 550,
  "writtenLabel": "约公元 550 年（北朝时期，民间长期传唱定型）",
  "orderInAuthor": 1,
  "famousLines": [
    "万里赴戎机，关山度若飞。",
    "双兔傍地走，安能辨我是雄雌？"
  ],
  "lines": [
    {
      "text": "唧唧复唧唧，",
      "pinyin": ["jī", "jī", "fù", "jī", "jī"],
      "translation": "织机声一声接着一声，",
      "noteIds": ["n-jiji"]
    },
    {
      "text": "木兰当户织。",
      "pinyin": ["mù", "lán", "dāng", "hù", "zhī"],
      "translation": "木兰对着门在织布。",
      "noteIds": ["n-danghu"]
    },
    {
      "text": "不闻机杼声，",
      "pinyin": ["bù", "wén", "jī", "zhù", "shēng"],
      "translation": "听不见织机的声音，",
      "noteIds": ["n-jizhu"]
    },
    {
      "text": "惟闻女叹息。",
      "pinyin": ["wéi", "wén", "nǚ", "tàn", "xī"],
      "translation": "只听见姑娘的叹息声。",
      "noteIds": ["n-weiwen"]
    },
    {
      "text": "问女何所思，",
      "pinyin": ["wèn", "nǚ", "hé", "suǒ", "sī"],
      "translation": "问姑娘在想什么，",
      "noteIds": []
    },
    {
      "text": "问女何所忆。",
      "pinyin": ["wèn", "nǚ", "hé", "suǒ", "yì"],
      "translation": "问姑娘在思念什么。",
      "noteIds": []
    },
    {
      "text": "女亦无所思，",
      "pinyin": ["nǚ", "yì", "wú", "suǒ", "sī"],
      "translation": "姑娘说也没有想什么，",
      "noteIds": []
    },
    {
      "text": "女亦无所忆。",
      "pinyin": ["nǚ", "yì", "wú", "suǒ", "yì"],
      "translation": "也没有思念什么。",
      "noteIds": []
    },
    {
      "text": "昨夜见军帖，",
      "pinyin": ["zuó", "yè", "jiàn", "jūn", "tiě"],
      "translation": "昨天夜里看见了征兵的文书，",
      "noteIds": ["n-juntie"]
    },
    {
      "text": "可汗大点兵，",
      "pinyin": ["kè", "hán", "dà", "diǎn", "bīng"],
      "translation": "君主大规模地征兵。",
      "noteIds": ["n-kehan"]
    },
    {
      "text": "军书十二卷，",
      "pinyin": ["jūn", "shū", "shí", "èr", "juàn"],
      "translation": "征兵的名册有很多卷，",
      "noteIds": ["n-shier"]
    },
    {
      "text": "卷卷有爷名。",
      "pinyin": ["juàn", "juàn", "yǒu", "yé", "míng"],
      "translation": "每一卷上都有父亲的名字。",
      "noteIds": ["n-ye"]
    },
    {
      "text": "阿爷无大儿，",
      "pinyin": ["ā", "yé", "wú", "dà", "ér"],
      "translation": "父亲没有成年的儿子，",
      "noteIds": []
    },
    {
      "text": "木兰无长兄，",
      "pinyin": ["mù", "lán", "wú", "zhǎng", "xiōng"],
      "translation": "木兰也没有兄长。",
      "noteIds": []
    },
    {
      "text": "愿为市鞍马，",
      "pinyin": ["yuàn", "wèi", "shì", "ān", "mǎ"],
      "translation": "木兰愿意为此去买来鞍马，",
      "noteIds": ["n-wei", "n-shi"]
    },
    {
      "text": "从此替爷征。",
      "pinyin": ["cóng", "cǐ", "tì", "yé", "zhēng"],
      "translation": "从此替父亲出征。",
      "noteIds": []
    },
    {
      "text": "东市买骏马，",
      "pinyin": ["dōng", "shì", "mǎi", "jùn", "mǎ"],
      "translation": "在东边的集市上买来骏马，",
      "noteIds": []
    },
    {
      "text": "西市买鞍鞯，",
      "pinyin": ["xī", "shì", "mǎi", "ān", "jiān"],
      "translation": "在西边的集市上买来鞍鞯，",
      "noteIds": ["n-anjian"]
    },
    {
      "text": "南市买辔头，",
      "pinyin": ["nán", "shì", "mǎi", "pèi", "tóu"],
      "translation": "在南边的集市上买来辔头，",
      "noteIds": ["n-peitou"]
    },
    {
      "text": "北市买长鞭。",
      "pinyin": ["běi", "shì", "mǎi", "cháng", "biān"],
      "translation": "在北边的集市上买来长鞭。",
      "noteIds": []
    },
    {
      "text": "旦辞爷娘去，",
      "pinyin": ["dàn", "cí", "yé", "niáng", "qù"],
      "translation": "早晨告别爹娘出发，",
      "noteIds": ["n-dan"]
    },
    {
      "text": "暮宿黄河边，",
      "pinyin": ["mù", "sù", "huáng", "hé", "biān"],
      "translation": "晚上宿营在黄河边上，",
      "noteIds": []
    },
    {
      "text": "不闻爷娘唤女声，",
      "pinyin": ["bù", "wén", "yé", "niáng", "huàn", "nǚ", "shēng"],
      "translation": "听不见爹娘呼唤女儿的声音，",
      "noteIds": []
    },
    {
      "text": "但闻黄河流水鸣溅溅。",
      "pinyin": ["dàn", "wén", "huáng", "hé", "liú", "shuǐ", "míng", "jiān", "jiān"],
      "translation": "只听见黄河水奔流溅溅作响。",
      "noteIds": ["n-jianjian"]
    },
    {
      "text": "旦辞黄河去，",
      "pinyin": ["dàn", "cí", "huáng", "hé", "qù"],
      "translation": "早晨辞别黄河上路，",
      "noteIds": []
    },
    {
      "text": "暮至黑山头，",
      "pinyin": ["mù", "zhì", "hēi", "shān", "tóu"],
      "translation": "晚上到达黑山头，",
      "noteIds": []
    },
    {
      "text": "不闻爷娘唤女声，",
      "pinyin": ["bù", "wén", "yé", "niáng", "huàn", "nǚ", "shēng"],
      "translation": "听不见爹娘呼唤女儿的声音，",
      "noteIds": []
    },
    {
      "text": "但闻燕山胡骑鸣啾啾。",
      "pinyin": ["dàn", "wén", "yān", "shān", "hú", "jì", "míng", "jiū", "jiū"],
      "translation": "只听见燕山下胡人的战马啾啾嘶鸣。",
      "noteIds": ["n-yanshan", "n-huji", "n-jiujiu"]
    },
    {
      "text": "万里赴戎机，",
      "pinyin": ["wàn", "lǐ", "fù", "róng", "jī"],
      "translation": "不远万里奔赴战场，",
      "noteIds": ["n-rongji"]
    },
    {
      "text": "关山度若飞。",
      "pinyin": ["guān", "shān", "dù", "ruò", "fēi"],
      "translation": "像飞一样越过一道道关隘山岭。",
      "noteIds": ["n-du"]
    },
    {
      "text": "朔气传金柝，",
      "pinyin": ["shuò", "qì", "chuán", "jīn", "tuò"],
      "translation": "北方的寒气里传来打更的声音，",
      "noteIds": ["n-shuoqi", "n-jintuo"]
    },
    {
      "text": "寒光照铁衣。",
      "pinyin": ["hán", "guāng", "zhào", "tiě", "yī"],
      "translation": "清冷的月光照着将士的铁甲战袍。",
      "noteIds": []
    },
    {
      "text": "将军百战死，",
      "pinyin": ["jiāng", "jūn", "bǎi", "zhàn", "sǐ"],
      "translation": "将士们身经百战，有的战死沙场，",
      "noteIds": []
    },
    {
      "text": "壮士十年归。",
      "pinyin": ["zhuàng", "shì", "shí", "nián", "guī"],
      "translation": "征战多年的勇士终于胜利归来。",
      "noteIds": []
    },
    {
      "text": "归来见天子，",
      "pinyin": ["guī", "lái", "jiàn", "tiān", "zǐ"],
      "translation": "胜利归来朝见君主，",
      "noteIds": []
    },
    {
      "text": "天子坐明堂。",
      "pinyin": ["tiān", "zǐ", "zuò", "míng", "táng"],
      "translation": "君主坐在朝堂上论功行赏。",
      "noteIds": []
    },
    {
      "text": "策勋十二转，",
      "pinyin": ["cè", "xūn", "shí", "èr", "zhuǎn"],
      "translation": "木兰记下极大的战功，",
      "noteIds": ["n-cexun", "n-zhuan"]
    },
    {
      "text": "赏赐百千强。",
      "pinyin": ["shǎng", "cì", "bǎi", "qiān", "qiáng"],
      "translation": "得到的赏赐比千百份还要多。",
      "noteIds": ["n-qiang"]
    },
    {
      "text": "可汗问所欲，",
      "pinyin": ["kè", "hán", "wèn", "suǒ", "yù"],
      "translation": "君主问木兰想要什么，",
      "noteIds": []
    },
    {
      "text": "木兰不用尚书郎，",
      "pinyin": ["mù", "lán", "bù", "yòng", "shàng", "shū", "láng"],
      "translation": "木兰说自己不想做尚书郎，",
      "noteIds": ["n-shangshu"]
    },
    {
      "text": "愿驰千里足，",
      "pinyin": ["yuàn", "chí", "qiān", "lǐ", "zú"],
      "translation": "只希望骑上千里快马，",
      "noteIds": []
    },
    {
      "text": "送儿还故乡。",
      "pinyin": ["sòng", "ér", "huán", "gù", "xiāng"],
      "translation": "送我回到自己的故乡。",
      "noteIds": []
    },
    {
      "text": "爷娘闻女来，",
      "pinyin": ["yé", "niáng", "wén", "nǚ", "lái"],
      "translation": "爹娘听说女儿回来了，",
      "noteIds": []
    },
    {
      "text": "出郭相扶将；",
      "pinyin": ["chū", "guō", "xiāng", "fú", "jiāng"],
      "translation": "互相搀扶着走出外城迎接；",
      "noteIds": ["n-guo", "n-fujiang"]
    },
    {
      "text": "阿姊闻妹来，",
      "pinyin": ["ā", "zǐ", "wén", "mèi", "lái"],
      "translation": "姐姐听说妹妹回来了，",
      "noteIds": ["n-azi"]
    },
    {
      "text": "当户理红妆；",
      "pinyin": ["dāng", "hù", "lǐ", "hóng", "zhuāng"],
      "translation": "对着门户梳妆打扮起来；",
      "noteIds": []
    },
    {
      "text": "小弟闻姊来，",
      "pinyin": ["xiǎo", "dì", "wén", "zǐ", "lái"],
      "translation": "弟弟听说姐姐回来了，",
      "noteIds": []
    },
    {
      "text": "磨刀霍霍向猪羊。",
      "pinyin": ["mó", "dāo", "huò", "huò", "xiàng", "zhū", "yáng"],
      "translation": "霍霍地磨刀，忙着杀猪宰羊。",
      "noteIds": ["n-huohuo"]
    },
    {
      "text": "开我东阁门，",
      "pinyin": ["kāi", "wǒ", "dōng", "gé", "mén"],
      "translation": "打开我东屋的门，",
      "noteIds": []
    },
    {
      "text": "坐我西阁床，",
      "pinyin": ["zuò", "wǒ", "xī", "gé", "chuáng"],
      "translation": "坐上我西屋的床，",
      "noteIds": []
    },
    {
      "text": "脱我战时袍，",
      "pinyin": ["tuō", "wǒ", "zhàn", "shí", "páo"],
      "translation": "脱下我打仗时穿的战袍，",
      "noteIds": []
    },
    {
      "text": "著我旧时裳。",
      "pinyin": ["zhuó", "wǒ", "jiù", "shí", "cháng"],
      "translation": "穿上我从前女子的衣裙。",
      "noteIds": ["n-zhuo", "n-chang"]
    },
    {
      "text": "当窗理云鬓，",
      "pinyin": ["dāng", "chuāng", "lǐ", "yún", "bìn"],
      "translation": "对着窗子梳理像云一样的鬓发，",
      "noteIds": ["n-yunbin"]
    },
    {
      "text": "对镜帖花黄。",
      "pinyin": ["duì", "jìng", "tiē", "huā", "huáng"],
      "translation": "照着镜子贴上花黄。",
      "noteIds": ["n-tiehuang"]
    },
    {
      "text": "出门看火伴，",
      "pinyin": ["chū", "mén", "kàn", "huǒ", "bàn"],
      "translation": "走出门去看同伍的伙伴，",
      "noteIds": ["n-huoban"]
    },
    {
      "text": "火伴皆惊忙：",
      "pinyin": ["huǒ", "bàn", "jiē", "jīng", "máng"],
      "translation": "伙伴们见了都很吃惊：",
      "noteIds": []
    },
    {
      "text": "同行十二年，",
      "pinyin": ["tóng", "xíng", "shí", "èr", "nián"],
      "translation": "一起行军打仗这么多年，",
      "noteIds": []
    },
    {
      "text": "不知木兰是女郎。",
      "pinyin": ["bù", "zhī", "mù", "lán", "shì", "nǚ", "láng"],
      "translation": "竟然不知道木兰是个姑娘。",
      "noteIds": []
    },
    {
      "text": "雄兔脚扑朔，",
      "pinyin": ["xióng", "tù", "jiǎo", "pū", "shuò"],
      "translation": "雄兔被提起来时脚不停摆动，",
      "noteIds": ["n-pushuo"]
    },
    {
      "text": "雌兔眼迷离；",
      "pinyin": ["cí", "tù", "yǎn", "mí", "lí"],
      "translation": "雌兔被提起来时双眼眯着；",
      "noteIds": ["n-mili"]
    },
    {
      "text": "双兔傍地走，",
      "pinyin": ["shuāng", "tù", "bàng", "dì", "zǒu"],
      "translation": "可是两只兔子贴着地面并排跑起来，",
      "noteIds": ["n-bang"]
    },
    {
      "text": "安能辨我是雄雌？",
      "pinyin": ["ān", "néng", "biàn", "wǒ", "shì", "xióng", "cí"],
      "translation": "又怎能分辨出哪个是雄、哪个是雌呢？",
      "noteIds": []
    }
  ],
