    {
      "text": "动如参与商。",
      "pinyin": [
        "dòng",
        "rú",
        "shēn",
        "yǔ",
        "shāng"
      ],
      "translation": "常像参星和商星，一个升起另一个就落下。",
      "noteIds": [
        "n-shenshang"
      ]
    },
    {
      "text": "今夕复何夕，",
      "pinyin": [
        "jīn",
        "xī",
        "fù",
        "hé",
        "xī"
      ],
      "translation": "今晚是什么样的好夜晚，",
      "noteIds": []
    },
    {
      "text": "共此灯烛光。",
      "pinyin": [
        "gòng",
        "cǐ",
        "dēng",
        "zhú",
        "guāng"
      ],
      "translation": "能和你一起点着灯烛相对而坐。",
      "noteIds": []
    },
    {
      "text": "少壮能几时，",
      "pinyin": [
        "shào",
        "zhuàng",
        "néng",
        "jǐ",
        "shí"
      ],
      "translation": "年轻力壮的日子能有多少？",
      "noteIds": []
    },
    {
      "text": "鬓发各已苍。",
      "pinyin": [
        "bìn",
        "fà",
        "gè",
        "yǐ",
        "cāng"
      ],
      "translation": "两人的鬓发都已经花白。",
      "noteIds": []
    },
    {
      "text": "访旧半为鬼，",
      "pinyin": [
        "fǎng",
        "jiù",
        "bàn",
        "wéi",
        "guǐ"
      ],
      "translation": "打听当年的老朋友，一半已经去世，",
      "noteIds": []
    },
    {
      "text": "惊呼热中肠。",
      "pinyin": [
        "jīng",
        "hū",
        "rè",
        "zhōng",
        "cháng"
      ],
      "translation": "忍不住惊呼出声，心里像火烧一样难受。",
      "noteIds": [
        "n-zhongchang"
      ]
    },
    {
      "text": "焉知二十载，",
      "pinyin": [
        "yān",
        "zhī",
        "èr",
        "shí",
        "zǎi"
      ],
      "translation": "谁能想到分别二十年之后，",
      "noteIds": []
    },
    {
      "text": "重上君子堂。",
      "pinyin": [
        "chóng",
        "shàng",
        "jūn",
        "zǐ",
        "táng"
      ],
      "translation": "还能再登上你家堂屋。",
      "noteIds": []
    },
    {
      "text": "昔别君未婚，",
      "pinyin": [
        "xī",
        "bié",
        "jūn",
        "wèi",
        "hūn"
      ],
      "translation": "当年分别时你还没有结婚，",
      "noteIds": []
    },
    {
      "text": "儿女忽成行。",
      "pinyin": [
        "ér",
        "nǚ",
        "hū",
        "chéng",
        "háng"
      ],
      "translation": "如今儿女已经排成了行。",
      "noteIds": [
        "n-chenghang"
      ]
    },
    {
      "text": "怡然敬父执，",
      "pinyin": [
