{
  "id": "tang-zhongtang-baijuyi-pipaxing",
  "slug": "pipaxing",
  "title": "琵琶行",
  "titlePinyin": "pí pá xíng",
  "dynasty": "tangshi",
  "era": "zhongtang",
  "genre": "shi",
  "form": "七言古诗",
  "authorId": "baijuyi",
  "gradeBand": "ext",
  "tags": [
    "送别",
    "七言古诗",
    "音乐",
    "江月"
  ],
  "difficulty": 3,
  "writtenYear": 816,
  "writtenLabel": "约公元 816 年（白居易 44 岁，被贬为江州司马，秋夜在浔阳江头送客，闻琵琶声而作）",
  "orderInAuthor": 1,
  "famousLines": [
    "同是天涯沦落人，相逢何必曾相识。",
    "千呼万唤始出来，犹抱琵琶半遮面。"
  ],
  "lines": [
    {
      "text": "浔阳江头夜送客，",
      "pinyin": ["xún", "yáng", "jiāng", "tóu", "yè", "sòng", "kè"],
      "translation": "秋夜，我在浔阳江边为客人送行，",
      "noteIds": ["n-xunyangjiang"]
    },
    {
      "text": "枫叶荻花秋瑟瑟。",
      "pinyin": ["fēng", "yè", "dí", "huā", "qiū", "sè", "sè"],
      "translation": "枫叶和荻花在秋风中沙沙作响。",
      "noteIds": ["n-dihua"]
    },
    {
      "text": "主人下马客在船，",
      "pinyin": ["zhǔ", "rén", "xià", "mǎ", "kè", "zài", "chuán"],
      "translation": "我下马走进客人的船中，",
      "noteIds": []
    },
    {
      "text": "举酒欲饮无管弦。",
      "pinyin": ["jǔ", "jiǔ", "yù", "yǐn", "wú", "guǎn", "xián"],
      "translation": "举起酒杯想喝，却没有音乐助兴。",
      "noteIds": ["n-guanxian"]
    },
    {
      "text": "醉不成欢惨将别，",
      "pinyin": ["zuì", "bù", "chéng", "huān", "cǎn", "jiāng", "bié"],
      "translation": "喝醉了也不痛快，悲伤地就要分别，",
      "noteIds": []
    },
    {
      "text": "别时茫茫江浸月。",
      "pinyin": ["bié", "shí", "máng", "máng", "jiāng", "jìn", "yuè"],
      "translation": "分别时，茫茫的江水里浸着一轮明月。",
      "noteIds": []
    },
    {
      "text": "忽闻水上琵琶声，",
      "pinyin": ["hū", "wén", "shuǐ", "shàng", "pí", "pá", "shēng"],
      "translation": "忽然听见江面上传来琵琶声，",
      "noteIds": []
    },
    {
      "text": "主人忘归客不发。",
      "pinyin": ["zhǔ", "rén", "wàng", "guī", "kè", "bù", "fā"],
      "translation": "我忘了回家，客人也忘了启程。",
      "noteIds": []
    },
    {
      "text": "寻声暗问弹者谁，",
      "pinyin": ["xún", "shēng", "àn", "wèn", "tán", "zhě", "shuí"],
      "translation": "顺着声音轻声问：弹琵琶的是谁？",
      "noteIds": []
    },
    {
      "text": "琵琶声停欲语迟。",
      "pinyin": ["pí", "pá", "shēng", "tíng", "yù", "yǔ", "chí"],
      "translation": "琵琶声停了下来，她想回答又有些迟疑。",
      "noteIds": []
    },
    {
      "text": "移船相近邀相见，",
      "pinyin": ["yí", "chuán", "xiāng", "jìn", "yāo", "xiāng", "jiàn"],
      "translation": "我们把船移过去，请她出来相见，",
      "noteIds": []
    },
    {
      "text": "添酒回灯重开宴。",
      "pinyin": ["tiān", "jiǔ", "huí", "dēng", "chóng", "kāi", "yàn"],
      "translation": "添上酒，重新点灯，再摆开酒宴。",
      "noteIds": ["n-huideng"]
    },
    {
      "text": "千呼万唤始出来，",
      "pinyin": ["qiān", "hū", "wàn", "huàn", "shǐ", "chū", "lái"],
      "translation": "叫了千遍万遍，她才慢慢走出来，",
      "noteIds": []
    },
    {
      "text": "犹抱琵琶半遮面。",
      "pinyin": ["yóu", "bào", "pí", "pá", "bàn", "zhē", "miàn"],
      "translation": "还抱着琵琶，半遮着脸。",
      "noteIds": []
    },
    {
      "text": "转轴拨弦三两声，",
      "pinyin": ["zhuǎn", "zhóu", "bō", "xián", "sān", "liǎng", "shēng"],
      "translation": "拧转弦轴，试拨了三两声，",
      "noteIds": []
    },
    {
      "text": "未成曲调先有情。",
      "pinyin": ["wèi", "chéng", "qǔ", "diào", "xiān", "yǒu", "qíng"],
      "translation": "还没成曲子，就已经饱含感情。",
      "noteIds": []
    },
    {
      "text": "弦弦掩抑声声思，",
      "pinyin": ["xián", "xián", "yǎn", "yì", "shēng", "shēng", "sī"],
      "translation": "一弦一弦低沉压抑，一声一声都是愁思，",
      "noteIds": []
    },
    {
      "text": "似诉平生不得志。",
      "pinyin": ["sì", "sù", "píng", "shēng", "bù", "dé", "zhì"],
      "translation": "像在诉说一生的不得意。",
      "noteIds": []
    },
    {
      "text": "低眉信手续续弹，",
      "pinyin": ["dī", "méi", "xìn", "shǒu", "xù", "xù", "tán"],
      "translation": "她低着头，随手连续地弹着，",
      "noteIds": []
    },
    {
      "text": "说尽心中无限事。",
      "pinyin": ["shuō", "jìn", "xīn", "zhōng", "wú", "xiàn", "shì"],
      "translation": "把心里数不尽的往事都弹了出来。",
      "noteIds": []
    },
    {
      "text": "轻拢慢捻抹复挑，",
      "pinyin": ["qīng", "lǒng", "màn", "niǎn", "mǒ", "fù", "tiāo"],
      "translation": "轻轻地拢，慢慢地捻，一会儿抹，一会儿挑，",
      "noteIds": []
    },
    {
      "text": "初为《霓裳》后《六幺》。",
      "pinyin": ["chū", "wéi", "ní", "cháng", "hòu", "liù", "yāo"],
      "translation": "先弹《霓裳羽衣曲》，又弹《六幺》。",
      "noteIds": ["n-nichang", "n-liuyao"]
    },
    {
      "text": "大弦嘈嘈如急雨，",
      "pinyin": ["dà", "xián", "cáo", "cáo", "rú", "jí", "yǔ"],
      "translation": "粗弦声音沉重，像一阵急雨，",
      "noteIds": ["n-zaocao"]
    },
    {
      "text": "小弦切切如私语。",
      "pinyin": ["xiǎo", "xián", "qiè", "qiè", "rú", "sī", "yǔ"],
      "translation": "细弦声音轻促，像悄悄耳语。",
      "noteIds": ["n-qieqie"]
    },
    {
      "text": "嘈嘈切切错杂弹，",
      "pinyin": ["cáo", "cáo", "qiè", "qiè", "cuò", "zá", "tán"],
      "translation": "沉重的、轻细的声音交错着弹，",
      "noteIds": []
    },
    {
      "text": "大珠小珠落玉盘。",
      "pinyin": ["dà", "zhū", "xiǎo", "zhū", "luò", "yù", "pán"],
      "translation": "就像大珠小珠落进玉盘，又脆又密。",
      "noteIds": []
    },
    {
      "text": "间关莺语花底滑，",
      "pinyin": ["jiān", "guān", "yīng", "yǔ", "huā", "dǐ", "huá"],
      "translation": "一会儿像黄莺在花下啼鸣，婉转流利，",
      "noteIds": ["n-jianguan"]
    },
    {
      "text": "幽咽泉流冰下难。",
      "pinyin": ["yōu", "yè", "quán", "liú", "bīng", "xià", "nán"],
      "translation": "一会儿像泉水在冰下流动，艰难滞涩。",
      "noteIds": ["n-youye"]
    },
    {
      "text": "冰泉冷涩弦凝绝，",
      "pinyin": ["bīng", "quán", "lěng", "sè", "xián", "níng", "jué"],
      "translation": "泉水冻住了，弦声也渐渐凝结断绝，",
      "noteIds": ["n-ningjue"]
    },
    {
      "text": "凝绝不通声暂歇。",
      "pinyin": ["níng", "jué", "bù", "tōng", "shēng", "zàn", "xiē"],
      "translation": "声音像冻住一样，暂时停了下来。",
      "noteIds": []
    },
    {
      "text": "别有幽愁暗恨生，",
      "pinyin": ["bié", "yǒu", "yōu", "chóu", "àn", "hèn", "shēng"],
      "translation": "另有一种深藏的忧愁和怨恨暗暗升起，",
      "noteIds": []
    },
    {
      "text": "此时无声胜有声。",
      "pinyin": ["cǐ", "shí", "wú", "shēng", "shèng", "yǒu", "shēng"],
      "translation": "这时的无声，胜过有声。",
      "noteIds": []
    },
    {
      "text": "银瓶乍破水浆迸，",
      "pinyin": ["yín", "píng", "zhà", "pò", "shuǐ", "jiāng", "bèng"],
      "translation": "忽然像银瓶炸破，水浆四溅，",
      "noteIds": ["n-yinping"]
    },
    {
      "text": "铁骑突出刀枪鸣。",
      "pinyin": ["tiě", "qí", "tū", "chū", "dāo", "qiāng", "míng"],
      "translation": "又像骑兵突然冲出，刀枪齐鸣。",
      "noteIds": ["n-tieqi"]
    },
    {
      "text": "曲终收拨当心画，",
      "pinyin": ["qǔ", "zhōng", "shōu", "bō", "dāng", "xīn", "huà"],
      "translation": "曲子弹完，她收回拨子，在琵琶中心用力一划，",
      "noteIds": ["n-bo"]
    },
    {
      "text": "四弦一声如裂帛。",
      "pinyin": ["sì", "xián", "yī", "shēng", "rú", "liè", "bó"],
      "translation": "四根弦同时发声，像撕开丝帛一样响亮。",
      "noteIds": ["n-liebo"]
    },
    {
      "text": "东船西舫悄无言，",
      "pinyin": ["dōng", "chuán", "xī", "fǎng", "qiǎo", "wú", "yán"],
      "translation": "左右的船都静悄悄的，没有人说话，",
      "noteIds": ["n-fang"]
    },
    {
      "text": "唯见江心秋月白。",
      "pinyin": ["wéi", "jiàn", "jiāng", "xīn", "qiū", "yuè", "bái"],
      "translation": "只看见江心的秋月泛着白光。",
      "noteIds": []
    },
    {
      "text": "沉吟放拨插弦中，",
      "pinyin": ["chén", "yín", "fàng", "bō", "chā", "xián", "zhōng"],
      "translation": "她迟疑着放下拨子，插在弦中，",
      "noteIds": ["n-chenyin"]
    },
    {
      "text": "整顿衣裳起敛容。",
      "pinyin": ["zhěng", "dùn", "yī", "cháng", "qǐ", "liǎn", "róng"],
      "translation": "整了整衣裳，站起身收起神情。",
      "noteIds": ["n-lianrong"]
    },
    {
      "text": "自言本是京城女，",
      "pinyin": ["zì", "yán", "běn", "shì", "jīng", "chéng", "nǚ"],
      "translation": "她说自己本是京城的女子，",
      "noteIds": []
    },
    {
      "text": "家在虾蟆陵下住。",
      "pinyin": ["jiā", "zài", "há", "má", "líng", "xià", "zhù"],
      "translation": "家就住在虾蟆陵下。",
      "noteIds": ["n-hamaling"]
    },
    {
      "text": "十三学得琵琶成，",
      "pinyin": ["shí", "sān", "xué", "dé", "pí", "pá", "chéng"],
      "translation": "十三岁就学成了琵琶，",
      "noteIds": []
    },
    {
      "text": "名属教坊第一部。",
      "pinyin": ["míng", "shǔ", "jiào", "fāng", "dì", "yī", "bù"],
      "translation": "名字排在教坊第一队里。",
      "noteIds": ["n-jiaofang"]
    },
    {
      "text": "曲罢曾教善才服，",
      "pinyin": ["qǔ", "bà", "céng", "jiāo", "shàn", "cái", "fú"],
      "translation": "一曲弹完，连乐师都佩服，",
      "noteIds": ["n-shancai"]
    },
    {
      "text": "妆成每被秋娘妒。",
      "pinyin": ["zhuāng", "chéng", "měi", "bèi", "qiū", "niáng", "dù"],
      "translation": "梳妆好了，常常被同辈歌女嫉妒。",
      "noteIds": ["n-qiuniang"]
    },
    {
      "text": "五陵年少争缠头，",
      "pinyin": ["wǔ", "líng", "nián", "shào", "zhēng", "chán", "tóu"],
      "translation": "富贵子弟争着送她锦帛彩礼，",
      "noteIds": ["n-wuling", "n-chantou"]
    },
    {
      "text": "一曲红绡不知数。",
      "pinyin": ["yī", "qǔ", "hóng", "xiāo", "bù", "zhī", "shù"],
      "translation": "弹一曲，收到的红绡数也数不清。",
      "noteIds": ["n-hongxiao"]
    },
    {
      "text": "钿头银篦击节碎，",
      "pinyin": ["diàn", "tóu", "yín", "bì", "jī", "jié", "suì"],
      "translation": "打拍子时，镶花的银篦都敲碎了，",
      "noteIds": ["n-dianybin", "n-jijie"]
    },
    {
      "text": "血色罗裙翻酒污。",
      "pinyin": ["xuè", "sè", "luó", "qún", "fān", "jiǔ", "wū"],
      "translation": "红色的罗裙被泼翻的酒弄脏了也不在意。",
      "noteIds": ["n-fanjiuwu"]
    },
    {
      "text": "今年欢笑复明年，",
      "pinyin": ["jīn", "nián", "huān", "xiào", "fù", "míng", "nián"],
      "translation": "今年欢笑，明年又欢笑，",
      "noteIds": []
    },
    {
      "text": "秋月春风等闲度。",
      "pinyin": ["qiū", "yuè", "chūn", "fēng", "děng", "xián", "dù"],
      "translation": "秋月春风的美好时光就这样随随便便度过。",
      "noteIds": []
    },
    {
      "text": "弟走从军阿姨死，",
      "pinyin": ["dì", "zǒu", "cóng", "jūn", "ā", "yí", "sǐ"],
      "translation": "后来弟弟当了兵，阿姨也去世了，",
      "noteIds": ["n-ayi"]
    },
    {
      "text": "暮去朝来颜色故。",
      "pinyin": ["mù", "qù", "zhāo", "lái", "yán", "sè", "gù"],
      "translation": "日子一天天过去，容貌渐渐衰老。",
      "noteIds": []
    },
    {
      "text": "门前冷落鞍马稀，",
      "pinyin": ["mén", "qián", "lěng", "luò", "ān", "mǎ", "xī"],
      "translation": "门前冷落，来往的车马稀少了，",
      "noteIds": []
    },
    {
      "text": "老大嫁作商人妇。",
      "pinyin": ["lǎo", "dà", "jià", "zuò", "shāng", "rén", "fù"],
      "translation": "年纪大了，只好嫁给商人做妻子。",
      "noteIds": []
    },
    {
      "text": "商人重利轻别离，",
      "pinyin": ["shāng", "rén", "zhòng", "lì", "qīng", "bié", "lí"],
      "translation": "商人看重财利，不把分别当回事，",
      "noteIds": []
    },
    {
      "text": "前月浮梁买茶去。",
      "pinyin": ["qián", "yuè", "fú", "liáng", "mǎi", "chá", "qù"],
      "translation": "上个月到浮梁买茶去了。",
      "noteIds": ["n-fuliang"]
    },
    {
      "text": "去来江口守空船，",
      "pinyin": ["qù", "lái", "jiāng", "kǒu", "shǒu", "kōng", "chuán"],
      "translation": "他走了以后，我独自在江口守着空船，",
      "noteIds": []
    },
    {
      "text": "绕船月明江水寒。",
      "pinyin": ["rào", "chuán", "yuè", "míng", "jiāng", "shuǐ", "hán"],
      "translation": "船边月色明亮，江水冰凉。",
      "noteIds": []
    },
    {
      "text": "夜深忽梦少年事，",
      "pinyin": ["yè", "shēn", "hū", "mèng", "shào", "nián", "shì"],
      "translation": "深夜里忽然梦见少年时的欢乐往事，",
      "noteIds": []
    },
    {
      "text": "梦啼妆泪红阑干。",
      "pinyin": ["mèng", "tí", "zhuāng", "lèi", "hóng", "lán", "gān"],
      "translation": "哭醒了，泪水纵横，弄花了脸上的脂粉。",
      "noteIds": ["n-langan"]
    },
    {
      "text": "我闻琵琶已叹息，",
      "pinyin": ["wǒ", "wén", "pí", "pá", "yǐ", "tàn", "xī"],
      "translation": "我听了琵琶声，已经连连叹息，",
      "noteIds": []
    },
    {
      "text": "又闻此语重唧唧。",
      "pinyin": ["yòu", "wén", "cǐ", "yǔ", "chóng", "jī", "jī"],
      "translation": "又听了这番身世，更加叹息不已。",
      "noteIds": ["n-jiji"]
    },
    {
      "text": "同是天涯沦落人，",
      "pinyin": ["tóng", "shì", "tiān", "yá", "lún", "luò", "rén"],
      "translation": "同是流落天涯的人，",
      "noteIds": []
    },
    {
      "text": "相逢何必曾相识。",
      "pinyin": ["xiāng", "féng", "hé", "bì", "céng", "xiāng", "shí"],
      "translation": "相逢在一起，何必要曾经认识呢！",
      "noteIds": []
    },
    {
      "text": "我从去年辞帝京，",
      "pinyin": ["wǒ", "cóng", "qù", "nián", "cí", "dì", "jīng"],
      "translation": "我从去年离开京城长安，",
      "noteIds": []
    },
    {
      "text": "谪居卧病浔阳城。",
      "pinyin": ["zhé", "jū", "wò", "bìng", "xún", "yáng", "chéng"],
      "translation": "被贬居住在浔阳城，常常卧病。",
      "noteIds": ["n-zheju"]
    },
    {
      "text": "浔阳地僻无音乐，",
      "pinyin": ["xún", "yáng", "dì", "pì", "wú", "yīn", "yuè"],
      "translation": "浔阳地方偏僻，没有音乐，",
      "noteIds": []
    },
    {
      "text": "终岁不闻丝竹声。",
      "pinyin": ["zhōng", "suì", "bù", "wén", "sī", "zhú", "shēng"],
      "translation": "一年到头听不到丝竹的声音。",
      "noteIds": []
    },
    {
      "text": "住近湓江地低湿，",
      "pinyin": ["zhù", "jìn", "pén", "jiāng", "dì", "dī", "shī"],
      "translation": "住在湓江边，地势低洼潮湿，",
      "noteIds": ["n-penjiang"]
    },
    {
      "text": "黄芦苦竹绕宅生。",
