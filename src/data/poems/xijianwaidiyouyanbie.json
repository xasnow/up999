  "lines": [
    {
      "text": "十年离乱后，",
      "pinyin": ["shí", "nián", "lí", "luàn", "hòu"],
      "translation": "经过十年战乱离散之后，",
      "noteIds": ["n-liluan"]
    },
    {
      "text": "长大一相逢。",
      "pinyin": ["zhǎng", "dà", "yì", "xiāng", "féng"],
      "translation": "我们都长大了，才意外相逢。",
      "noteIds": ["n-waidi"]
    },
    {
      "text": "问姓惊初见，",
      "pinyin": ["wèn", "xìng", "jīng", "chū", "jiàn"],
      "translation": "刚见面时问起姓氏，心里吃了一惊，",
      "noteIds": []
    },
    {
      "text": "称名忆旧容。",
      "pinyin": ["chēng", "míng", "yì", "jiù", "róng"],
      "translation": "说出名字，才想起儿时的旧容貌。",
      "noteIds": []
    },
    {
      "text": "别来沧海事，",
      "pinyin": ["bié", "lái", "cāng", "hǎi", "shì"],
      "translation": "分别以来经历了多少沧海桑田的变化，",
      "noteIds": ["n-canghai"]
    },
    {
      "text": "语罢暮天钟。",
      "pinyin": ["yǔ", "bà", "mù", "tiān", "zhōng"],
      "translation": "说完了话，已是黄昏的钟声响起。",
      "noteIds": []
    },
    {
      "text": "明日巴陵道，",
      "pinyin": ["míng", "rì", "bā", "líng", "dào"],
      "translation": "明天你就要走上去巴陵的路，",
      "noteIds": ["n-baling"]
    },
    {
      "text": "秋山又几重。",
      "pinyin": ["qiū", "shān", "yòu", "jǐ", "chóng"],
      "translation": "我们之间又要隔着几重秋山。",
      "noteIds": ["n-chong"]
    }
  ],
