---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '为小学生做的古诗词学习网站：带拼音、有漫画、跟着时间线读懂每一首诗。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <SiteHeader />
    <main class="page-main">
      <slot />
    </main>
    <footer class="site-footer">
      <nav class="footer-nav">
        <a href="/">首页</a>
        <a href="/tangshi/">唐诗</a>
        <a href="/songci/">宋词</a>
        <a href="/qita/">其他朝代</a>
        <a href="/about/">关于</a>
      </nav>
      <p class="footer-note">内容由人工校对，配图由 AI 辅助生成 · © up999.cn 每天一首小古诗</p>
    </footer>
    <script>
      // 拼音开关状态全站记忆（localStorage）
      const saved = localStorage.getItem('up999-pinyin');
      if (saved === 'off') document.body.classList.add('hide-pinyin');
    </script>
  </body>
</html>
