  "lines": [
    {
      "text": "幽人归独卧，",
      "pinyin": ["yōu", "rén", "guī", "dú", "wò"],
      "translation": "归隐的人独自卧在山间，",
      "noteIds": []
    },
    {
      "text": "滞虑洗孤清。",
      "pinyin": ["zhì", "lǜ", "xǐ", "gū", "qīng"],
      "translation": "把郁结的忧愁洗净，享受这份孤清。",
      "noteIds": ["n-zhilv"]
    },
    {
      "text": "持此谢高鸟，",
      "pinyin": ["chí", "cǐ", "xiè", "gāo", "niǎo"],
      "translation": "我捧着这份心意拜托高飞的鸟儿，",
      "noteIds": []
    },
    {
      "text": "因之传远情。",
      "pinyin": ["yīn", "zhī", "chuán", "yuǎn", "qíng"],
      "translation": "请它把远方的深情捎给故人。",
      "noteIds": []
    },
    {
      "text": "日夕怀空意，",
      "pinyin": ["rì", "xī", "huái", "kōng", "yì"],
      "translation": "从早到晚怀着一片空灵的诚意，",
      "noteIds": []
    },
    {
      "text": "人谁感至精？",
      "pinyin": ["rén", "shuí", "gǎn", "zhì", "jīng"],
      "translation": "可又有谁能被这至诚的心意打动呢？",
      "noteIds": ["n-jing"]
    },
    {
      "text": "飞沉理自隔，",
      "pinyin": ["fēi", "chén", "lǐ", "zì", "gé"],
      "translation": "飞鸟在天上、鱼儿在水底，境遇不同，自然相隔遥远，",
      "noteIds": ["n-feichen"]
    },
    {
      "text": "何所慰吾诚？",
      "pinyin": ["hé", "suǒ", "wèi", "wú", "chéng"],
      "translation": "有什么能安慰我这一片真心呢？",
      "noteIds": []
    }
