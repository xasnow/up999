  "lines": [
    {
      "text": "洛阳女儿对门居，",
      "pinyin": [
        "luò",
        "yáng",
        "nǚ",
        "ér",
        "duì",
        "mén",
        "jū"
      ],
      "translation": "洛阳有位女儿，就住在我家对门，",
      "noteIds": []
    },
    {
      "text": "才可颜容十五余。",
      "pinyin": [
        "cái",
        "kě",
        "yán",
        "róng",
        "shí",
        "wǔ",
        "yú"
      ],
      "translation": "容颜正当十五六岁的妙龄。",
      "noteIds": [
        "n-caike"
      ]
    },
    {
      "text": "良人玉勒乘骢马，",
      "pinyin": [
        "liáng",
        "rén",
        "yù",
        "lè",
        "chéng",
        "cōng",
        "mǎ"
      ],
      "translation": "她的丈夫骑着玉饰笼头的青白马，",
      "noteIds": [
        "n-liangren",
        "n-yule",
        "n-congma"
      ]
    },
    {
      "text": "侍女金盘脍鲤鱼。",
      "pinyin": [
        "shì",
        "nǚ",
        "jīn",
        "pán",
        "kuài",
        "lǐ",
        "yú"
      ],
      "translation": "侍女端上金盘，盛着细切精美的鲤鱼。",
      "noteIds": [
        "n-kuai"
      ]
    },
    {
      "text": "画阁朱楼尽相望，",
      "pinyin": [
        "huà",
        "gé",
        "zhū",
        "lóu",
        "jìn",
        "xiāng",
        "wàng"
      ],
      "translation": "画阁红楼一座连着一座，遥遥相对，",
      "noteIds": []
    },
    {
      "text": "红桃绿柳垂檐向。",
      "pinyin": [
        "hóng",
        "táo",
        "lǜ",
        "liǔ",
        "chuí",
        "yán",
        "xiàng"
      ],
      "translation": "红桃绿柳低垂在屋檐两旁。",
      "noteIds": []
    },
    {
      "text": "罗帷送上七香车，",
      "pinyin": [
        "luó",
        "wéi",
        "sòng",
        "shàng",
        "qī",
        "xiāng",
        "chē"
      ],
      "translation": "丝绸帷帐送她登上七香宝车，",
      "noteIds": [
        "n-wei",
        "n-qixiangche"
      ]
    },
    {
      "text": "宝扇迎归九华帐。",
      "pinyin": [
        "bǎo",
        "shàn",
        "yíng",
        "guī",
        "jiǔ",
        "huá",
        "zhàng"
      ],
      "translation": "仪仗宝扇迎她回到九华帐中。",
      "noteIds": [
        "n-jiuhuazhang"
      ]
    },
    {
      "text": "狂夫富贵在青春，",
      "pinyin": [
        "kuáng",
        "fū",
        "fù",
        "guì",
        "zài",
        "qīng",
        "chūn"
      ],
      "translation": "她丈夫正当青春、富贵得意，",
      "noteIds": [
        "n-kuangfu"
      ]
    },
    {
      "text": "意气骄奢剧季伦。",
      "pinyin": [
        "yì",
        "qì",
        "jiāo",
        "shē",
        "jù",
        "jì",
        "lún"
      ],
      "translation": "意气骄纵奢侈，超过了富豪石崇。",
      "noteIds": [
        "n-jilun"
      ]
    },
    {
      "text": "自怜碧玉亲教舞，",
      "pinyin": [
        "zì",
        "lián",
        "bì",
        "yù",
        "qīn",
        "jiào",
        "wǔ"
      ],
      "translation": "他宠爱碧玉般的年轻歌女，亲自教她跳舞，",
      "noteIds": [
        "n-biyu"
      ]
    },
    {
      "text": "不惜珊瑚持与人。",
      "pinyin": [
        "bù",
        "xī",
        "shān",
        "hú",
        "chí",
        "yǔ",
        "rén"
      ],
      "translation": "舍得把贵重的珊瑚随手送给别人。",
      "noteIds": []
    },
    {
      "text": "春窗曙灭九微火，",
      "pinyin": [
        "chūn",
        "chuāng",
        "shǔ",
        "miè",
        "jiǔ",
        "wēi",
        "huǒ"
      ],
      "translation": "春夜的灯烛一直点到天亮才熄灭，",
      "noteIds": [
        "n-jiuwei"
      ]
    },
    {
      "text": "九微片片飞花琐。",
      "pinyin": [
        "jiǔ",
        "wēi",
        "piàn",
        "piàn",
        "fēi",
        "huā",
        "suǒ"
      ],
      "translation": "灯花的碎屑片片，飞落在雕花窗格上。",
      "noteIds": [
        "n-huasuo"
      ]
    },
    {
      "text": "戏罢曾无理曲时，",
      "pinyin": [
        "xì",
        "bà",
        "céng",
        "wú",
        "lǐ",
        "qǔ",
        "shí"
      ],
      "translation": "嬉戏完了，从来没有练习曲子的工夫，",
      "noteIds": [
        "n-liqu"
      ]
    },
    {
      "text": "妆成祗是熏香坐。",
      "pinyin": [
        "zhuāng",
        "chéng",
        "zhǐ",
        "shì",
        "xūn",
        "xiāng",
        "zuò"
      ],
      "translation": "梳妆好了，只是坐在香炉旁熏香。",
      "noteIds": [
        "n-zhi"
      ]
    },
    {
      "text": "城中相识尽繁华，",
      "pinyin": [
        "chéng",
        "zhōng",
        "xiāng",
        "shí",
        "jìn",
        "fán",
        "huá"
      ],
      "translation": "城里来往相识的，全是富贵人家，",
      "noteIds": []
    },
    {
      "text": "日夜经过赵李家。",
      "pinyin": [
        "rì",
        "yè",
        "jīng",
        "guò",
        "zhào",
        "lǐ",
        "jiā"
      ],
      "translation": "日夜往来的，都是赵家李家那样的权贵。",
      "noteIds": [
        "n-zhaoli"
      ]
    },
    {
      "text": "谁怜越女颜如玉，",
      "pinyin": [
        "shuí",
        "lián",
        "yuè",
        "nǚ",
        "yán",
        "rú",
        "yù"
      ],
      "translation": "可有谁怜惜越女西施容颜如玉，",
      "noteIds": [
        "n-yuenv"
      ]
    },
    {
      "text": "贫贱江头自浣纱。",
      "pinyin": [
        "pín",
        "jiàn",
        "jiāng",
        "tóu",
        "zì",
        "huàn",
        "shā"
      ],
      "translation": "贫贱时却只能独自在江头浣洗纱线。",
      "noteIds": [
        "n-huansha"
      ]
    }
  ],
