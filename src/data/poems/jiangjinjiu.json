        "bú",
        "jiàn",
        "huáng",
        "hé",
        "zhī",
        "shuǐ",
        "tiān",
        "shàng",
        "lái"
      ],
      "translation": "你难道没看见，黄河的水从天上来，",
      "noteIds": []
    },
    {
      "text": "奔流到海不复回。",
      "pinyin": [
        "bēn",
        "liú",
        "dào",
        "hǎi",
        "bú",
        "fù",
        "huí"
      ],
      "translation": "奔流入海，再也不回头。",
      "noteIds": []
    },
    {
      "text": "君不见高堂明镜悲白发，",
      "pinyin": [
        "jūn",
        "bú",
        "jiàn",
        "gāo",
        "táng",
        "míng",
        "jìng",
        "bēi",
        "bái",
        "fà"
      ],
      "translation": "你难道没看见，高堂上对镜自照，为满头白发而悲伤，",
      "noteIds": []
