  "lines": [
    {
      "text": "神龟虽寿，",
      "pinyin": ["shén", "guī", "suī", "shòu"],
      "translation": "神龟虽然长寿，",
      "noteIds": ["n-shengui"]
    },
    {
      "text": "犹有竟时。",
      "pinyin": ["yóu", "yǒu", "jìng", "shí"],
      "translation": "也有生命结束的一天。",
      "noteIds": ["n-jingshi"]
    },
    {
      "text": "腾蛇乘雾，",
      "pinyin": ["téng", "shé", "chéng", "wù"],
      "translation": "腾蛇即使能驾雾飞行，",
      "noteIds": ["n-tengshe"]
    },
    {
      "text": "终为土灰。",
      "pinyin": ["zhōng", "wéi", "tǔ", "huī"],
      "translation": "最后也会化为尘土。",
      "noteIds": []
    },
    {
      "text": "老骥伏枥，",
      "pinyin": ["lǎo", "jì", "fú", "lì"],
      "translation": "年老的千里马趴在马槽旁，",
      "noteIds": ["n-laoji", "n-fuli"]
    },
    {
      "text": "志在千里。",
      "pinyin": ["zhì", "zài", "qiān", "lǐ"],
      "translation": "心里还想着驰骋千里。",
      "noteIds": []
    },
    {
      "text": "烈士暮年，",
      "pinyin": ["liè", "shì", "mù", "nián"],
      "translation": "有雄心壮志的人到了晚年，",
      "noteIds": ["n-lieshi"]
