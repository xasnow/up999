  "lines": [
    {
      "text": "楚江微雨里，",
      "pinyin": ["chǔ", "jiāng", "wēi", "yǔ", "lǐ"],
      "translation": "细雨笼罩着楚地的江面，",
      "noteIds": ["n-chujiang"]
    },
    {
      "text": "建业暮钟时。",
      "pinyin": ["jiàn", "yè", "mù", "zhōng", "shí"],
      "translation": "建业城传来傍晚的钟声。",
      "noteIds": ["n-jianye"]
    },
    {
      "text": "漠漠帆来重，",
      "pinyin": ["mò", "mò", "fān", "lái", "zhòng"],
      "translation": "水汽迷蒙，船帆被雨打湿显得沉重，",
      "noteIds": ["n-momo"]
    },
    {
      "text": "冥冥鸟去迟。",
      "pinyin": ["míng", "míng", "niǎo", "qù", "chí"],
      "translation": "天色昏暗，鸟儿冒雨飞得很迟缓。",
      "noteIds": ["n-mingming"]
    },
    {
      "text": "海门深不见，",
      "pinyin": ["hǎi", "mén", "shēn", "bù", "jiàn"],
      "translation": "海门远在深处，望也望不见，",
      "noteIds": ["n-haimen"]
    },
    {
      "text": "浦树远含滋。",
      "pinyin": ["pǔ", "shù", "yuǎn", "hán", "zī"],
      "translation": "岸边的树隔着水汽，含着蒙蒙的湿气。",
      "noteIds": []
    },
    {
      "text": "相送情无限，",
      "pinyin": ["xiāng", "sòng", "qíng", "wú", "xiàn"],
      "translation": "送别的情意没有尽头，",
      "noteIds": []
    },
    {
      "text": "沾襟比散丝。",
      "pinyin": ["zhān", "jīn", "bǐ", "sǎn", "sī"],
