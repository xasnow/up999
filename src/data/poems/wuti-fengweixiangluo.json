  "lines": [
    {
      "text": "凤尾香罗薄几重，",
      "pinyin": ["fèng", "wěi", "xiāng", "luó", "bó", "jǐ", "chóng"],
      "translation": "绣着凤尾纹的香罗帐薄薄几层，",
      "noteIds": ["n-fengwei"]
    },
    {
      "text": "碧文圆顶夜深缝。",
      "pinyin": ["bì", "wén", "yuán", "dǐng", "yè", "shēn", "féng"],
      "translation": "她连夜赶缝碧纹圆顶的车帐。",
      "noteIds": ["n-biwen"]
    },
    {
      "text": "扇裁月魄羞难掩，",
      "pinyin": ["shàn", "cái", "yuè", "pò", "xiū", "nán", "yǎn"],
      "translation": "团扇裁得像圆月，却难掩脸上的羞意，",
      "noteIds": ["n-yuepo"]
    },
    {
      "text": "车走雷声语未通。",
      "pinyin": ["chē", "zǒu", "léi", "shēng", "yǔ", "wèi", "tōng"],
      "translation": "对方的车子如雷声驶过，一句话也没能说上。",
      "noteIds": ["n-leisheng"]
    },
    {
      "text": "曾是寂寥金烬暗，",
      "pinyin": ["céng", "shì", "jì", "liáo", "jīn", "jìn", "àn"],
      "translation": "多少个寂寞长夜，灯芯烧成了暗淡的金烬，",
      "noteIds": ["n-jinjin"]
    },
    {
      "text": "断无消息石榴红。",
      "pinyin": ["duàn", "wú", "xiāo", "xī", "shí", "liú", "hóng"],
      "translation": "盼到石榴花又红了，依然杳无音信。",
      "noteIds": ["n-shiliuhong"]
    },
    {
      "text": "斑骓只系垂杨岸，",
      "pinyin": ["bān", "zhuī", "zhǐ", "xì", "chuí", "yáng", "àn"],
      "translation": "斑骓马只拴在垂柳岸边，",
      "noteIds": ["n-banzhui"]
