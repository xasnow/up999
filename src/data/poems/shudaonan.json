  "lines": [
    {
      "text": "噫吁嚱，危乎高哉！",
      "pinyin": [
        "yī",
        "xū",
        "xī",
        "wēi",
        "hū",
        "gāo",
        "zāi"
      ],
      "translation": "啊！高得吓人，险得惊人！",
      "noteIds": [
        "n-yuxi"
      ]
    },
    {
      "text": "蜀道之难，难于上青天！",
      "pinyin": [
        "shǔ",
        "dào",
        "zhī",
        "nán",
        "nán",
        "yú",
        "shàng",
        "qīng",
        "tiān"
      ],
      "translation": "走蜀道的难处，比上天还难！",
      "noteIds": []
    },
    {
      "text": "蚕丛及鱼凫，开国何茫然！",
      "pinyin": [
        "cán",
        "cóng",
        "jí",
        "yú",
        "fú",
        "kāi",
        "guó",
        "hé",
        "máng",
        "rán"
      ],
      "translation": "从蚕丛、鱼凫开国以来，蜀地有多少年月，已茫然难知！",
      "noteIds": [
        "n-cancong"
      ]
    },
    {
      "text": "尔来四万八千岁，不与秦塞通人烟。",
      "pinyin": [
        "ěr",
        "lái",
        "sì",
        "wàn",
        "bā",
        "qiān",
        "suì",
        "bù",
        "yǔ",
        "qín",
        "sài",
        "tōng",
        "rén",
        "yān"
      ],
      "translation": "四万八千年以来，蜀地和秦地边塞都不通人烟。",
      "noteIds": [
        "n-qinsai"
      ]
    },
    {
      "text": "西当太白有鸟道，可以横绝峨眉巅。",
      "pinyin": [
        "xī",
        "dāng",
        "tài",
        "bái",
        "yǒu",
        "niǎo",
        "dào",
        "kě",
        "yǐ",
        "héng",
        "jué",
        "é",
        "méi",
        "diān"
      ],
      "translation": "西边只有太白山上鸟儿能飞的小道，可以飞越到峨眉山顶。",
      "noteIds": [
        "n-hengjue"
      ]
    },
    {
      "text": "地崩山摧壮士死，然后天梯石栈相钩连。",
      "pinyin": [
        "dì",
        "bēng",
        "shān",
        "cuī",
        "zhuàng",
        "shì",
        "sǐ",
        "rán",
        "hòu",
        "tiān",
        "tī",
        "shí",
        "zhàn",
        "xiāng",
        "gōu",
        "lián"
      ],
      "translation": "传说山崩地裂、五个壮士遇难之后，才有天梯一样的山路和栈道连了起来。",
      "noteIds": [
        "n-wuding",
        "n-shizhan"
      ]
    },
    {
      "text": "上有六龙回日之高标，下有冲波逆折之回川。",
      "pinyin": [
        "shàng",
        "yǒu",
        "liù",
        "lóng",
        "huí",
        "rì",
        "zhī",
        "gāo",
        "biāo",
        "xià",
        "yǒu",
        "chōng",
        "bō",
        "nì",
        "zhé",
        "zhī",
        "huí",
        "chuān"
      ],
      "translation": "上有挡住太阳、连六龙拉日车都要绕行的山峰，下有激浪冲撞、曲折回旋的河川。",
      "noteIds": [
        "n-huiri"
      ]
    },
    {
      "text": "黄鹤之飞尚不得过，猿猱欲度愁攀援。",
