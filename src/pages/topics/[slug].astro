---
// 专题详情：按 tags 匹配聚合作品，四季等主题分小节展示
import BaseLayout from '../../layouts/BaseLayout.astro';
import PoemCard from '../../components/PoemCard.astro';
import { topics, poemsOfTopic, poemsOfTopic as poemsIn, topicPath } from '../../lib/content';
import { pageKeywords } from '../../lib/seo';

export function getStaticPaths() {
  return topics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;
const all = poemsIn(topic);
const others = topics.filter((t) => t.slug !== topic.slug);
// 分小节主题（如四季）：每节单独匹配、去重
const sections = (topic.sections ?? []).map((s: any) => {
  const pool = new Set(s.tags);
  const seen = new Set<string>();
  const list = all.filter((p) => {
    const hit = (p.tags ?? []).some((x: string) => pool.has(x)) && !seen.has(p.id);
    if (hit) seen.add(p.id);
    return hit;
  });
  return { title: s.title, list };
});
---

<BaseLayout
  title={`${topic.title} · 诗词专题 · 每天一首小古诗`}
  description={`${topic.title}专题：${all.length} 首带拼音、有讲解的古诗词。${topic.intro}`}
  keywords={pageKeywords('tangshi')}
>
  <div class="container">
    <p class="breadcrumb" style="text-align:left">
      <a href="/">首页</a> / <a href="/topics/">诗词专题</a> / {topic.title}
    </p>
    <section class="topic-hero" style={`--topic-color:${topic.color}`}>
      <span class="topic-emoji" aria-hidden="true">{topic.emoji}</span>
      <div>
        <h1>{topic.title}</h1>
        <p>{topic.intro}</p>
        <span class="topic-count">共 {all.length} 首</span>
      </div>
    </section>

    {
      sections.length > 0
        ? sections.map(
            (s) =>
              s.list.length > 0 && (
                <section class="section">
                  <div class="section-title">
                    <h2>{s.title}</h2>
                    <small>{s.list.length} 首</small>
                  </div>
                  <div class="poem-grid">
                    {s.list.map((p) => (
                      <PoemCard poem={p} />
                    ))}
                  </div>
                </section>
              )
          )
        : all.length > 0 && (
            <section class="section">
              <div class="poem-grid">
                {all.map((p) => (
                  <PoemCard poem={p} />
                ))}
              </div>
            </section>
          )
    }

    <section class="section">
      <div class="section-title">
        <h2>换个主题看看</h2>
      </div>
      <div class="topic-chips">
        {
          others.map((t) => (
            <a class="topic-chip" href={topicPath(t)} style={`--topic-color:${t.color}`}>
              {t.emoji} {t.title}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
