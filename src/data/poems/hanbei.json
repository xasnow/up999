{
  "id": "tang-wantang-lishangyin-hanbei",
  "slug": "hanbei",
  "title": "韩碑",
  "titlePinyin": "hán bēi",
  "dynasty": "tangshi",
  "era": "wantang",
  "genre": "shi",
  "form": "七言古诗",
  "authorId": "lishangyin",
  "gradeBand": "ext",
  "tags": [
    "怀古",
    "七言古诗",
    "碑石",
    "笔墨"
  ],
  "difficulty": 3,
  "writtenYear": 838,
  "writtenLabel": "作年不详，约公元 838 年（李商隐 26 岁，早年推崇韩愈古文，感于平淮西碑事而作）",
  "orderInAuthor": 1,
  "no": 1209,
  "famousLines": [
    "公之斯文若元气，先时已入人肝脾。"
  ],
  "lines": [
    {
      "text": "元和天子神武姿，",
      "pinyin": ["yuán", "hé", "tiān", "zǐ", "shén", "wǔ", "zī"],
      "translation": "元和年间的天子有神武的英姿，",
      "noteIds": ["n-yuanhe"]
    },
    {
      "text": "彼何人哉轩与羲。",
      "pinyin": ["bǐ", "hé", "rén", "zāi", "xuān", "yǔ", "xī"],
      "translation": "他像谁呢？像轩辕、伏羲那样的圣王。",
      "noteIds": ["n-xuanxi"]
    },
    {
      "text": "誓将上雪列圣耻，",
      "pinyin": ["shì", "jiāng", "shàng", "xuě", "liè", "shèng", "chǐ"],
      "translation": "立誓要洗雪历代先帝蒙受的耻辱，",
      "noteIds": []
    },
    {
      "text": "坐法宫中朝四夷。",
      "pinyin": ["zuò", "fǎ", "gōng", "zhōng", "cháo", "sì", "yí"],
      "translation": "端坐正殿，接受四方外族的朝见。",
      "noteIds": ["n-fagong"]
    },
    {
      "text": "淮西有贼五十载，",
      "pinyin": ["huái", "xī", "yǒu", "zéi", "wǔ", "shí", "zǎi"],
      "translation": "淮西的叛贼割据已有五十年，",
      "noteIds": ["n-huaixi"]
    },
    {
      "text": "封狼生貙貙生罴。",
      "pinyin": ["fēng", "láng", "shēng", "chū", "chū", "shēng", "pí"],
      "translation": "像大狼生下猛貙、貙又生下凶罴，一代比一代凶悍。",
      "noteIds": ["n-chu", "n-pi"]
    },
    {
      "text": "不据山河据平地，",
      "pinyin": ["bù", "jù", "shān", "hé", "jù", "píng", "dì"],
      "translation": "他们不占山河险要，偏在平地称霸，",
      "noteIds": []
    },
    {
      "text": "长戈利矛日可麾。",
      "pinyin": ["cháng", "gē", "lì", "máo", "rì", "kě", "huī"],
      "translation": "仗着长戈利矛，狂妄得仿佛连太阳都能挥指。",
      "noteIds": ["n-hui"]
    },
    {
      "text": "帝得圣相相曰度，",
      "pinyin": ["dì", "dé", "shèng", "xiàng", "xiàng", "yuē", "dù"],
      "translation": "天子得到了贤相，宰相名叫裴度。",
      "noteIds": ["n-du"]
    },
    {
      "text": "贼斫不死神扶持。",
      "pinyin": ["zéi", "zhuó", "bù", "sǐ", "shén", "fú", "chí"],
      "translation": "刺客砍他不死，像有神灵护佑。",
      "noteIds": ["n-zhuo"]
    },
    {
      "text": "腰悬相印作都统，",
      "pinyin": ["yāo", "xuán", "xiàng", "yìn", "zuò", "dū", "tǒng"],
      "translation": "他腰挂宰相印信，出任各路统帅，",
      "noteIds": ["n-dutong"]
    },
    {
      "text": "阴风惨澹天王旗。",
      "pinyin": ["yīn", "fēng", "cǎn", "dàn", "tiān", "wáng", "qí"],
      "translation": "阴风惨淡中，天子的旗帜迎风招展。",
      "noteIds": ["n-tianwangqi"]
    },
    {
      "text": "愬武古通作牙爪，",
      "pinyin": ["sù", "wǔ", "gǔ", "tōng", "zuò", "yá", "zhǎo"],
      "translation": "李愬、韩公武、李道古、李文通做了得力部将，",
      "noteIds": ["n-su", "n-yazhao"]
    },
    {
      "text": "仪曹外郎载笔随。",
      "pinyin": ["yí", "cáo", "wài", "láng", "zài", "bǐ", "suí"],
      "translation": "礼部员外郎带着笔墨随军记录。",
      "noteIds": []
    },
    {
      "text": "行军司马智且勇，",
      "pinyin": ["xíng", "jūn", "sī", "mǎ", "zhì", "qiě", "yǒng"],
      "translation": "行军司马韩愈，既聪明又勇毅，",
      "noteIds": ["n-xingjun"]
    },
    {
      "text": "十四万众犹虎貔。",
      "pinyin": ["shí", "sì", "wàn", "zhòng", "yóu", "hǔ", "pí"],
      "translation": "十四万大军像虎豹貔貅一样勇猛。",
      "noteIds": []
    },
    {
      "text": "入蔡缚贼献太庙，",
      "pinyin": ["rù", "cài", "fù", "zéi", "xiàn", "tài", "miào"],
      "translation": "大军攻入蔡州，生擒叛贼，献俘太庙，",
      "noteIds": ["n-rucai"]
    },
    {
      "text": "功无与让恩不訾。",
      "pinyin": ["gōng", "wú", "yǔ", "ràng", "ēn", "bù", "zī"],
      "translation": "功劳无人可比，皇恩多得难以计算。",
      "noteIds": ["n-zi"]
    },
    {
      "text": "帝曰汝度功第一，",
      "pinyin": ["dì", "yuē", "rǔ", "dù", "gōng", "dì", "yī"],
      "translation": "皇帝说：裴度，你的功劳第一，",
      "noteIds": []
    },
    {
      "text": "汝从事愈宜为辞。",
      "pinyin": ["rǔ", "cóng", "shì", "yù", "yí", "wéi", "cí"],
      "translation": "你的从事韩愈，应当撰写碑文。",
      "noteIds": ["n-congshi"]
    },
    {
      "text": "愈拜稽首蹈且舞，",
      "pinyin": ["yù", "bài", "qǐ", "shǒu", "dǎo", "qiě", "wǔ"],
      "translation": "韩愈叩头下拜，欢喜得手舞足蹈，",
      "noteIds": ["n-qishou"]
    },
    {
      "text": "金石刻画臣能为。",
      "pinyin": ["jīn", "shí", "kè", "huà", "chén", "néng", "wéi"],
      "translation": "说铭刻金石的文章，臣能够胜任。",
      "noteIds": []
    },
    {
      "text": "古者世称大手笔，",
      "pinyin": ["gǔ", "zhě", "shì", "chēng", "dà", "shǒu", "bǐ"],
      "translation": "自古以来人们称颂大手笔，",
      "noteIds": []
    },
    {
      "text": "此事不系于职司。",
      "pinyin": ["cǐ", "shì", "bù", "xì", "yú", "zhí", "sī"],
      "translation": "这样的大事不专属一般文职官员。",
      "noteIds": []
    },
    {
      "text": "当仁自古有不让，",
      "pinyin": ["dāng", "rén", "zì", "gǔ", "yǒu", "bù", "ràng"],
      "translation": "面对仁义之事，自古就有当仁不让，",
      "noteIds": []
    },
    {
      "text": "言讫屡颔天子颐。",
      "pinyin": ["yán", "qì", "lǚ", "hàn", "tiān", "zǐ", "yí"],
      "translation": "韩愈说完，天子连连点头称许。",
      "noteIds": ["n-yanqi", "n-han", "n-yi"]
    },
    {
      "text": "公退斋戒坐小阁，",
      "pinyin": ["gōng", "tuì", "zhāi", "jiè", "zuò", "xiǎo", "gé"],
      "translation": "韩公退朝后沐浴斋戒，独坐小阁，",
      "noteIds": []
    },
    {
      "text": "濡染大笔何淋漓。",
      "pinyin": ["rú", "rǎn", "dà", "bǐ", "hé", "lín", "lí"],
      "translation": "蘸饱大笔，写得何等酣畅淋漓。",
      "noteIds": ["n-ruran"]
    },
    {
      "text": "点窜尧典舜典字，",
      "pinyin": ["diǎn", "cuàn", "yáo", "diǎn", "shùn", "diǎn", "zì"],
      "translation": "文字追摹《尧典》《舜典》的古雅，",
      "noteIds": ["n-yaodian"]
    },
    {
      "text": "涂改清庙生民诗。",
      "pinyin": ["tú", "gǎi", "qīng", "miào", "shēng", "mín", "shī"],
      "translation": "笔法仿佛《清庙》《生民》的诗风。",
      "noteIds": ["n-qingmiao"]
    },
    {
      "text": "文成破体书在纸，",
      "pinyin": ["wén", "chéng", "pò", "tǐ", "shū", "zài", "zhǐ"],
      "translation": "碑文一反常格写成，落在纸上，",
      "noteIds": ["n-poti"]
    },
    {
      "text": "清晨再拜铺丹墀。",
      "pinyin": ["qīng", "chén", "zài", "bài", "pū", "dān", "chí"],
      "translation": "清晨再拜，把它铺陈在宫殿的丹墀之上。",
      "noteIds": ["n-danchi"]
    },
    {
      "text": "表曰臣愈昧死上，",
      "pinyin": ["biǎo", "yuē", "chén", "yù", "mèi", "sǐ", "shàng"],
      "translation": "表文写道：臣韩愈冒死呈上，",
      "noteIds": ["n-meisi"]
    },
    {
      "text": "咏神圣功书之碑。",
      "pinyin": ["yǒng", "shén", "shèng", "gōng", "shū", "zhī", "bēi"],
      "translation": "歌颂神圣功业，把它刻写成碑。",
      "noteIds": []
    },
    {
      "text": "碑高三丈字如斗，",
      "pinyin": ["bēi", "gāo", "sān", "zhàng", "zì", "rú", "dǒu"],
      "translation": "石碑高三丈，字大如斗，",
      "noteIds": []
    },
    {
      "text": "负以灵鳌蟠以螭。",
      "pinyin": ["fù", "yǐ", "líng", "áo", "pán", "yǐ", "chī"],
      "translation": "神鳌驮着碑身，螭龙盘绕碑侧。",
      "noteIds": ["n-ao", "n-chi"]
    },
    {
      "text": "句奇语重喻者少，",
      "pinyin": ["jù", "qí", "yǔ", "zhòng", "yù", "zhě", "shǎo"],
      "translation": "句子奇崛、语意深重，能理解的人很少，",
      "noteIds": []
    },
    {
      "text": "谗之天子言其私。",
      "pinyin": ["chán", "zhī", "tiān", "zǐ", "yán", "qí", "sī"],
      "translation": "有人便向天子进谗，说韩愈偏私。",
      "noteIds": ["n-chan"]
    },
    {
      "text": "长绳百尺拽碑倒，",
      "pinyin": ["cháng", "shéng", "bǎi", "chǐ", "zhuài", "bēi", "dǎo"],
      "translation": "百尺长绳把石碑拽倒，",
      "noteIds": []
    },
    {
      "text": "粗砂大石相磨治。",
      "pinyin": ["cū", "shā", "dà", "shí", "xiāng", "mó", "zhì"],
      "translation": "再用粗砂大石把碑文磨平。",
      "noteIds": ["n-mozhi"]
    },
    {
      "text": "公之斯文若元气，",
      "pinyin": ["gōng", "zhī", "sī", "wén", "ruò", "yuán", "qì"],
      "translation": "韩公这篇文章如同天地元气，",
      "noteIds": []
    },
    {
      "text": "先时已入人肝脾。",
      "pinyin": ["xiān", "shí", "yǐ", "rù", "rén", "gān", "pí"],
      "translation": "早就浸入了人们的肝脾肺腑。",
      "noteIds": []
    },
    {
      "text": "汤盘孔鼎有述作，",
      "pinyin": ["tāng", "pán", "kǒng", "dǐng", "yǒu", "shù", "zuò"],
      "translation": "商汤的盘、孔子的鼎上都铸有铭文，",
      "noteIds": ["n-tangpan", "n-kongding"]
    },
    {
      "text": "今无其器存其辞。",
      "pinyin": ["jīn", "wú", "qí", "qì", "cún", "qí", "cí"],
      "translation": "如今器物虽已不存，文辞仍在流传。",
      "noteIds": []
    },
    {
      "text": "呜呼圣王及圣相，",
      "pinyin": ["wū", "hū", "shèng", "wáng", "jí", "shèng", "xiàng"],
      "translation": "啊，圣明的君王与贤能的宰相，",
      "noteIds": []
    },
    {
      "text": "相与烜赫流淳熙。",
      "pinyin": ["xiāng", "yǔ", "xuǎn", "hè", "liú", "chún", "xī"],
      "translation": "相互辉映，美名如阳光流传后世。",
      "noteIds": ["n-xuanhe"]
    },
    {
      "text": "公之斯文不示后，",
      "pinyin": ["gōng", "zhī", "sī", "wén", "bù", "shì", "hòu"],
      "translation": "韩公的文章若不能昭示后人，",
      "noteIds": []
    },
    {
      "text": "曷与三五相攀追。",
      "pinyin": ["hé", "yǔ", "sān", "wǔ", "xiāng", "pān", "zhuī"],
      "translation": "宪宗的功业怎能与三皇五帝相攀比？",
      "noteIds": ["n-sanwu"]
    },
    {
      "text": "愿书万本诵万遍，",
      "pinyin": ["yuàn", "shū", "wàn", "běn", "sòng", "wàn", "biàn"],
      "translation": "我愿抄写它一万本，诵读它一万遍，",
      "noteIds": []
    },
    {
      "text": "口角流沫右手胝。",
      "pinyin": ["kǒu", "jiǎo", "liú", "mò", "yòu", "shǒu", "zhī"],
      "translation": "哪怕口角流出唾沫，右手磨出茧子。",
      "noteIds": ["n-zhi"]
    },
    {
      "text": "传之七十有二代，",
      "pinyin": ["chuán", "zhī", "qī", "shí", "yǒu", "èr", "dài"],
      "translation": "让它流传给古来七十二代封禅的帝王，",
      "noteIds": ["n-shierdai"]
    },
    {
      "text": "以为封禅玉检明堂基。",
      "pinyin": ["yǐ", "wéi", "fēng", "shàn", "yù", "jiǎn", "míng", "táng", "jī"],
      "translation": "作为封禅文书的玉检和明堂的基石。",
      "noteIds": ["n-fengshan", "n-yujian", "n-mingtang"]
    }
  ],
