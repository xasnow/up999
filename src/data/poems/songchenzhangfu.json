  "lines": [
    {
      "text": "四月南风大麦黄，",
      "pinyin": ["sì", "yuè", "nán", "fēng", "dà", "mài", "huáng"],
      "translation": "四月的南风吹得大麦一片金黄，",
      "noteIds": []
    },
    {
      "text": "枣花未落桐叶长。",
      "pinyin": ["zǎo", "huā", "wèi", "luò", "tóng", "yè", "cháng"],
      "translation": "枣花还没有落尽，桐树的叶子已经长得长长的。",
      "noteIds": []
    },
    {
      "text": "青山朝别暮还见，",
      "pinyin": ["qīng", "shān", "zhāo", "bié", "mù", "hái", "jiàn"],
      "translation": "早上告别了青山，傍晚还能相见，",
      "noteIds": []
    },
    {
      "text": "嘶马出门思旧乡。",
      "pinyin": ["sī", "mǎ", "chū", "mén", "sī", "jiù", "xiāng"],
      "translation": "马儿出门嘶鸣，也想着回到故乡。",
      "noteIds": []
    },
    {
      "text": "陈侯立身何坦荡，",
      "pinyin": ["chén", "hóu", "lì", "shēn", "hé", "tǎn", "dàng"],
      "translation": "陈侯为人处世多么光明磊落，",
      "noteIds": ["n-hou"]
    },
    {
      "text": "虬须虎眉仍大颡。",
      "pinyin": ["qiú", "xū", "hǔ", "méi", "réng", "dà", "sǎng"],
      "translation": "卷曲的胡须、虎一样的眉毛，还有宽宽的大额头。",
      "noteIds": ["n-sang"]
    },
    {
      "text": "腹中贮书一万卷，",
      "pinyin": ["fù", "zhōng", "zhù", "shū", "yī", "wàn", "juàn"],
      "translation": "肚子里装着一万卷书，",
      "noteIds": ["n-zhushu"]
    },
    {
      "text": "不肯低头在草莽。",
      "pinyin": ["bù", "kěn", "dī", "tóu", "zài", "cǎo", "mǎng"],
      "translation": "却不肯埋没在草野之中低头认命。",
      "noteIds": ["n-caomang"]
    },
    {
      "text": "东门酤酒饮我曹，",
      "pinyin": ["dōng", "mén", "gū", "jiǔ", "yǐn", "wǒ", "cáo"],
      "translation": "他曾在东门买酒请我们痛饮，",
      "noteIds": ["n-wocao"]
    },
    {
      "text": "心轻万事如鸿毛。",
      "pinyin": ["xīn", "qīng", "wàn", "shì", "rú", "hóng", "máo"],
      "translation": "把世间万事看得像鸿毛一样轻。",
      "noteIds": []
    },
    {
      "text": "醉卧不知白日暮，",
      "pinyin": ["zuì", "wò", "bù", "zhī", "bái", "rì", "mù"],
      "translation": "喝醉了躺下，连太阳落山都不知道，",
      "noteIds": []
    },
    {
      "text": "有时空望孤云高。",
      "pinyin": ["yǒu", "shí", "kōng", "wàng", "gū", "yún", "gāo"],
      "translation": "有时又望着天上高高的孤云出神。",
      "noteIds": []
    },
    {
      "text": "长河浪头连天黑，",
      "pinyin": ["cháng", "hé", "làng", "tóu", "lián", "tiān", "hēi"],
      "translation": "黄河浪头翻滚，天水连成一片昏黑，",
      "noteIds": []
    },
    {
      "text": "津口停舟渡不得。",
      "pinyin": ["jīn", "kǒu", "tíng", "zhōu", "dù", "bù", "dé"],
      "translation": "渡口船都停了，想渡也渡不过去。",
      "noteIds": ["n-jinkou"]
    },
    {
      "text": "郑国游人未及家，",
      "pinyin": ["zhèng", "guó", "yóu", "rén", "wèi", "jí", "jiā"],
      "translation": "你这位游子还回不了家，",
      "noteIds": ["n-zhengguo"]
    },
    {
      "text": "洛阳行子空叹息。",
      "pinyin": ["luò", "yáng", "xíng", "zǐ", "kōng", "tàn", "xī"],
      "translation": "我这个在洛阳做客的人也只能空自叹息。",
      "noteIds": ["n-xingzi"]
    },
    {
      "text": "闻道故林相识多，",
      "pinyin": ["wén", "dào", "gù", "lín", "xiāng", "shí", "duō"],
      "translation": "听说你故乡旧居那边认识的人很多，",
      "noteIds": []
    },
    {
      "text": "罢官昨日今如何。",
      "pinyin": ["bà", "guān", "zuó", "rì", "jīn", "rú", "hé"],
      "translation": "昨日刚罢了官，如今大家会怎样看待你呢？",
      "noteIds": []
    }
  ],
