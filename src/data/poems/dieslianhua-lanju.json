  "lines": [
    {
      "text": "槛菊愁烟兰泣露，",
      "pinyin": ["jiàn", "jú", "chóu", "yān", "lán", "qì", "lù"],
      "translation": "栏杆外的菊花笼着雾气像在发愁，兰花沾着露水像在哭泣。",
      "noteIds": ["n-jian", "n-chouyan", "n-qilu"]
    },
    {
      "text": "罗幕轻寒，",
      "pinyin": ["luó", "mù", "qīng", "hán"],
      "translation": "丝罗的帘幕透进微微的寒意，",
      "noteIds": []
    },
    {
      "text": "燕子双飞去。",
      "pinyin": ["yàn", "zǐ", "shuāng", "fēi", "qù"],
      "translation": "燕子成双成对地飞走了。",
      "noteIds": []
    },
    {
      "text": "明月不谙离恨苦，",
      "pinyin": ["míng", "yuè", "bù", "ān", "lí", "hèn", "kǔ"],
      "translation": "明月不懂离别的痛苦，",
      "noteIds": ["n-an"]
    },
    {
      "text": "斜光到晓穿朱户。",
      "pinyin": ["xié", "guāng", "dào", "xiǎo", "chuān", "zhū", "hù"],
      "translation": "斜斜的月光一直照到天亮，穿过红漆的大门。",
      "noteIds": ["n-zhuhu"]
    },
    {
      "text": "昨夜西风凋碧树，",
      "pinyin": ["zuó", "yè", "xī", "fēng", "diāo", "bì", "shù"],
      "translation": "昨夜西风猛吹，把绿树都吹得凋零了，",
      "noteIds": ["n-diao"]
    },
    {
      "text": "独上高楼，",
      "pinyin": ["dú", "shàng", "gāo", "lóu"],
      "translation": "我独自登上高楼，",
      "noteIds": []
    },
    {
      "text": "望尽天涯路。",
      "pinyin": ["wàng", "jìn", "tiān", "yá", "lù"],
      "translation": "一直望着通向天边的那条路。",
      "noteIds": []
    },
    {
      "text": "欲寄彩笺兼尺素，",
      "pinyin": ["yù", "jì", "cǎi", "jiān", "jiān", "chǐ", "sù"],
      "translation": "想寄出彩色的信笺，再附上一封书信，",
      "noteIds": ["n-caijian", "n-chisu"]
    },
    {
      "text": "山长水阔知何处。",
      "pinyin": ["shān", "cháng", "shuǐ", "kuò", "zhī", "hé", "chù"],
      "translation": "可是山高路远、水天辽阔，那人究竟在哪儿呢？",
      "noteIds": []
    }
  ],
