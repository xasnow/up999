  "lines": [
    {
      "text": "大江东去，",
      "pinyin": ["dà", "jiāng", "dōng", "qù"],
      "translation": "大江日夜不停地向东奔流，",
      "noteIds": []
    },
    {
      "text": "浪淘尽，",
      "pinyin": ["làng", "táo", "jìn"],
      "translation": "江浪冲刷淘洗，",
      "noteIds": ["n-langtao"]
    },
    {
      "text": "千古风流人物。",
      "pinyin": ["qiān", "gǔ", "fēng", "liú", "rén", "wù"],
      "translation": "千百年来多少英雄人物都被它带走了。",
      "noteIds": []
    },
    {
      "text": "故垒西边，",
      "pinyin": ["gù", "lěi", "xī", "biān"],
