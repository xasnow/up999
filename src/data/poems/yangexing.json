{
  "id": "tang-shengtang-gaoshi-yangexing",
  "slug": "yangexing",
  "title": "燕歌行",
  "titlePinyin": "yān gē xíng",
  "dynasty": "tangshi",
  "era": "shengtang",
  "genre": "shi",
  "form": "七言乐府",
  "authorId": "gaoshi",
  "gradeBand": "ext",
  "tags": ["边塞", "七言乐府", "烽火", "大漠"],
  "difficulty": 3,
  "writtenYear": 738,
  "writtenLabel": "约公元 738 年（高适 34 岁，开元二十六年，感于边将征戍之事写成此诗）",
  "orderInAuthor": 1,
  "famousLines": ["战士军前半死生，美人帐下犹歌舞。"],
  "lines": [
    {
      "text": "汉家烟尘在东北，",
      "pinyin": ["hàn", "jiā", "yān", "chén", "zài", "dōng", "běi"],
      "translation": "唐家的边境战火在东北方燃起，",
      "noteIds": []
    },
    {
      "text": "汉将辞家破残贼。",
      "pinyin": ["hàn", "jiàng", "cí", "jiā", "pò", "cán", "zéi"],
      "translation": "将军们告别家人，去消灭凶残的敌寇。",
      "noteIds": []
    },
    {
      "text": "男儿本自重横行，",
      "pinyin": ["nán", "ér", "běn", "zì", "zhòng", "héng", "xíng"],
      "translation": "好男儿本来就看重纵横驰骋沙场，",
      "noteIds": []
    },
    {
      "text": "天子非常赐颜色。",
      "pinyin": ["tiān", "zǐ", "fēi", "cháng", "cì", "yán", "sè"],
      "translation": "皇帝又特别地加以褒奖恩赏。",
      "noteIds": []
    },
    {
      "text": "摐金伐鼓下榆关，",
      "pinyin": ["chuāng", "jīn", "fá", "gǔ", "xià", "yú", "guān"],
      "translation": "敲锣击鼓，大军浩浩荡荡开出榆关，",
      "noteIds": ["n-chuang", "n-yuguan"]
    },
    {
      "text": "旌旆逶迤碣石间。",
      "pinyin": ["jīng", "pèi", "wēi", "yí", "jié", "shí", "jiān"],
      "translation": "军旗像长龙一样蜿蜒在碣石山间。",
      "noteIds": ["n-jingpei", "n-weiyi", "n-jieshi"]
    },
    {
      "text": "校尉羽书飞瀚海，",
      "pinyin": ["xiào", "wèi", "yǔ", "shū", "fēi", "hàn", "hǎi"],
      "translation": "校尉送来的紧急军书飞越大沙漠，",
      "noteIds": ["n-yushu", "n-hanhai"]
    },
    {
      "text": "单于猎火照狼山。",
      "pinyin": ["chán", "yú", "liè", "huǒ", "zhào", "láng", "shān"],
      "translation": "单于的打猎火光已照到狼山。",
      "noteIds": ["n-chanyu"]
    },
    {
      "text": "山川萧条极边土，",
      "pinyin": ["shān", "chuān", "xiāo", "tiáo", "jí", "biān", "tǔ"],
      "translation": "山河荒凉萧条，一直延伸到边疆尽头，",
      "noteIds": []
    },
    {
      "text": "胡骑凭陵杂风雨。",
      "pinyin": ["hú", "jì", "píng", "líng", "zá", "fēng", "yǔ"],
      "translation": "敌人的骑兵像风雨一样猛烈来犯。",
      "noteIds": ["n-pingling"]
    },
    {
      "text": "战士军前半死生，",
      "pinyin": ["zhàn", "shì", "jūn", "qián", "bàn", "sǐ", "shēng"],
      "translation": "士兵们在阵前拼杀，一半人生死不明，",
      "noteIds": []
    },
    {
      "text": "美人帐下犹歌舞。",
      "pinyin": ["měi", "rén", "zhàng", "xià", "yóu", "gē", "wǔ"],
      "translation": "将领的帐篷里美人还在唱歌跳舞。",
      "noteIds": []
    },
    {
      "text": "大漠穷秋塞草腓，",
      "pinyin": ["dà", "mò", "qióng", "qiū", "sài", "cǎo", "féi"],
      "translation": "深秋的大漠里边塞草都枯黄了，",
      "noteIds": ["n-fei"]
    },
    {
      "text": "孤城落日斗兵稀。",
      "pinyin": ["gū", "chéng", "luò", "rì", "dòu", "bīng", "xī"],
      "translation": "孤城笼罩在落日里，能战斗的士兵越来越少。",
      "noteIds": []
    },
    {
      "text": "身当恩遇常轻敌，",
      "pinyin": ["shēn", "dāng", "ēn", "yù", "cháng", "qīng", "dí"],
      "translation": "将领身受皇恩却常常轻视敌人，",
      "noteIds": []
    },
    {
      "text": "力尽关山未解围。",
      "pinyin": ["lì", "jìn", "guān", "shān", "wèi", "jiě", "wéi"],
      "translation": "士兵用尽力气，还是解不开关山的重围。",
      "noteIds": []
    },
    {
      "text": "铁衣远戍辛勤久，",
      "pinyin": ["tiě", "yī", "yuǎn", "shù", "xīn", "qín", "jiǔ"],
      "translation": "穿铁甲的战士远戍边地，辛苦的日子太久，",
      "noteIds": []
    },
    {
      "text": "玉箸应啼别离后。",
      "pinyin": ["yù", "zhù", "yīng", "tí", "bié", "lí", "hòu"],
      "translation": "家中的妻子一定在分别后不停流泪。",
      "noteIds": ["n-yuzhu"]
    },
    {
      "text": "少妇城南欲断肠，",
      "pinyin": ["shào", "fù", "chéng", "nán", "yù", "duàn", "cháng"],
      "translation": "城南的少妇想得肝肠寸断，",
      "noteIds": []
    },
    {
      "text": "征人蓟北空回首。",
      "pinyin": ["zhēng", "rén", "jì", "běi", "kōng", "huí", "shǒu"],
      "translation": "远在蓟北的征人回头张望也是白望。",
      "noteIds": []
    },
    {
      "text": "边庭飘飖那可度，",
      "pinyin": ["biān", "tíng", "piāo", "yáo", "nǎ", "kě", "dù"],
      "translation": "边地的战局动荡不定，哪能料想得到，",
      "noteIds": ["n-piaoyao"]
    },
    {
      "text": "绝域苍茫更何有。",
      "pinyin": ["jué", "yù", "cāng", "máng", "gèng", "hé", "yǒu"],
      "translation": "荒远之地苍苍茫茫，还有什么可指望？",
      "noteIds": []
    },
    {
      "text": "杀气三时作阵云，",
      "pinyin": ["shā", "qì", "sān", "shí", "zuò", "zhèn", "yún"],
      "translation": "白天杀气腾腾，凝成阵阵乌云，",
      "noteIds": []
    },
    {
      "text": "寒声一夜传刁斗。",
      "pinyin": ["hán", "shēng", "yī", "yè", "chuán", "diāo", "dǒu"],
      "translation": "整夜里寒冷的刁斗声一阵阵传来。",
      "noteIds": ["n-diaodou"]
    },
    {
      "text": "相看白刃血纷纷，",
      "pinyin": ["xiāng", "kàn", "bái", "rèn", "xuè", "fēn", "fēn"],
      "translation": "相互看着刀刃上血迹斑斑，",
      "noteIds": []
    },
    {
      "text": "死节从来岂顾勋。",
      "pinyin": ["sǐ", "jié", "cóng", "lái", "qǐ", "gù", "xūn"],
      "translation": "为国死节的人哪曾考虑个人功勋？",
      "noteIds": ["n-sijie"]
    },
    {
      "text": "君不见沙场征战苦，",
      "pinyin": ["jūn", "bù", "jiàn", "shā", "chǎng", "zhēng", "zhàn", "kǔ"],
      "translation": "你没看见沙场上征战多么艰苦，",
      "noteIds": []
    },
    {
      "text": "至今犹忆李将军。",
      "pinyin": ["zhì", "jīn", "yóu", "yì", "lǐ", "jiāng", "jūn"],
      "translation": "人们至今还怀念着爱护士兵的李将军。",
      "noteIds": []
    }
  ],
  "notes": [
    { "id": "n-chuang", "word": "摐", "pinyin": "chuāng", "meaning": "敲击。" },
