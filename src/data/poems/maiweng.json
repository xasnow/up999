  ],
  "lines": [
    {
      "text": "卖炭翁，",
      "pinyin": ["mài", "tàn", "wēng"],
      "translation": "有一个卖炭的老翁，",
      "noteIds": []
    },
    {
      "text": "伐薪烧炭南山中。",
      "pinyin": ["fá", "xīn", "shāo", "tàn", "nán", "shān", "zhōng"],
      "translation": "整年在终南山里砍柴烧炭。",
      "noteIds": ["n-xin"]
    },
    {
      "text": "满面尘灰烟火色，",
      "pinyin": ["mǎn", "miàn", "chén", "huī", "yān", "huǒ", "sè"],
      "translation": "他满面灰尘，脸上全是烟熏火燎的颜色，",
      "noteIds": []
    },
    {
      "text": "两鬓苍苍十指黑。",
      "pinyin": ["liǎng", "bìn", "cāng", "cāng", "shí", "zhǐ", "hēi"],
      "translation": "两鬓头发花白，十个手指头被炭染得乌黑。",
      "noteIds": ["n-bin", "n-cangcang"]
    },
    {
      "text": "卖炭得钱何所营？",
      "pinyin": ["mài", "tàn", "dé", "qián", "hé", "suǒ", "yíng"],
      "translation": "卖炭得到的钱用来做什么？",
      "noteIds": ["n-ying"]
    },
    {
      "text": "身上衣裳口中食。",
      "pinyin": ["shēn", "shàng", "yī", "shang", "kǒu", "zhōng", "shí"],
      "translation": "只换身上的衣服和口中的饭食。",
      "noteIds": ["n-yishang"]
    },
    {
      "text": "可怜身上衣正单，",
      "pinyin": ["kě", "lián", "shēn", "shàng", "yī", "zhèng", "dān"],
      "translation": "可怜他身上的衣服那样单薄，",
      "noteIds": ["n-dan"]
    },
    {
      "text": "心忧炭贱愿天寒。",
      "pinyin": ["xīn", "yōu", "tàn", "jiàn", "yuàn", "tiān", "hán"],
      "translation": "心里却担心炭价太低，盼望天气更冷一些。",
      "noteIds": ["n-jian"]
    },
    {
      "text": "夜来城外一尺雪，",
      "pinyin": ["yè", "lái", "chéng", "wài", "yī", "chǐ", "xuě"],
      "translation": "昨夜城外下了一尺厚的大雪，",
      "noteIds": []
    },
    {
      "text": "晓驾炭车辗冰辙。",
      "pinyin": ["xiǎo", "jià", "tàn", "chē", "zhǎn", "bīng", "zhé"],
      "translation": "天刚亮他就赶着炭车，轧过结了冰的车辙。",
      "noteIds": ["n-zhan", "n-zhe"]
    },
    {
      "text": "牛困人饥日已高，",
      "pinyin": ["niú", "kùn", "rén", "jī", "rì", "yǐ", "gāo"],
      "translation": "牛累了，人饿了，太阳已经升得老高，",
      "noteIds": []
    },
    {
      "text": "市南门外泥中歇。",
      "pinyin": ["shì", "nán", "mén", "wài", "ní", "zhōng", "xiē"],
      "translation": "他只好在集市南门外的泥地里歇脚。",
      "noteIds": []
    },
    {
      "text": "翩翩两骑来是谁？",
      "pinyin": ["piān", "piān", "liǎng", "jì", "lái", "shì", "shuí"],
      "translation": "那轻快得意的两个骑马人是谁？",
      "noteIds": ["n-pianpian", "n-ji"]
    },
    {
      "text": "黄衣使者白衫儿。",
      "pinyin": ["huáng", "yī", "shǐ", "zhě", "bái", "shān", "ér"],
      "translation": "是穿黄衣的太监和穿白衫的差役。",
      "noteIds": ["n-huangyi", "n-baishan"]
    },
    {
      "text": "手把文书口称敕，",
      "pinyin": ["shǒu", "bǎ", "wén", "shū", "kǒu", "chēng", "chì"],
      "translation": "他们手里拿着文书，口口声声说是皇帝的命令，",
      "noteIds": ["n-chi"]
    },
    {
      "text": "回车叱牛牵向北。",
      "pinyin": ["huí", "chē", "chì", "niú", "qiān", "xiàng", "běi"],
      "translation": "吆喝着牛调转车头，把炭车往北边皇宫方向拉走。",
      "noteIds": ["n-chinu"]
    },
    {
      "text": "一车炭，千余斤，",
      "pinyin": ["yī", "chē", "tàn", "qiān", "yú", "jīn"],
      "translation": "一车炭，足有千多斤，",
      "noteIds": []
    },
    {
      "text": "宫使驱将惜不得。",
      "pinyin": ["gōng", "shǐ", "qū", "jiāng", "xī", "bù", "dé"],
      "translation": "宫使硬赶着走，老人心疼也留不住。",
      "noteIds": ["n-qu", "n-jiang"]
    },
    {
      "text": "半匹红纱一丈绫，",
      "pinyin": ["bàn", "pǐ", "hóng", "shā", "yī", "zhàng", "líng"],
      "translation": "那半匹红纱和一丈绫子，",
      "noteIds": ["n-sha", "n-ling"]
    },
    {
      "text": "系向牛头充炭直。",
      "pinyin": ["xì", "xiàng", "niú", "tóu", "chōng", "tàn", "zhí"],
      "translation": "被拴在牛头上，就算买炭的钱了。",
      "noteIds": ["n-xi", "n-zhi"]
    }
  ],
