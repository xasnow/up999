  "lines": [
    {
      "text": "高阁客竟去，",
      "pinyin": ["gāo", "gé", "kè", "jìng", "qù"],
      "translation": "高阁上的客人竟然都离去，",
      "noteIds": []
    },
    {
      "text": "小园花乱飞。",
      "pinyin": ["xiǎo", "yuán", "huā", "luàn", "fēi"],
      "translation": "小园里的花也开始纷纷乱飞。",
      "noteIds": []
    },
    {
      "text": "参差连曲陌，",
      "pinyin": ["cēn", "cī", "lián", "qū", "mò"],
      "translation": "花瓣高低错落，一路飘连着弯曲的小路，",
      "noteIds": ["n-cenci", "n-qumo"]
    },
    {
      "text": "迢递送斜晖。",
      "pinyin": ["tiáo", "dì", "sòng", "xié", "huī"],
      "translation": "远远地飘向天边，送走斜阳余晖。",
      "noteIds": ["n-tiaodi"]
    },
    {
      "text": "肠断未忍扫，",
      "pinyin": ["cháng", "duàn", "wèi", "rěn", "sǎo"],
      "translation": "伤心欲绝，还不忍心把落花扫去，",
      "noteIds": []
    },
    {
      "text": "眼穿仍欲归。",
      "pinyin": ["yǎn", "chuān", "réng", "yù", "guī"],
      "translation": "望眼欲穿盼春常在，春天却仍要归去。",
      "noteIds": ["n-yanchuan"]
    },
    {
      "text": "芳心向春尽，",
      "pinyin": ["fāng", "xīn", "xiàng", "chūn", "jìn"],
      "translation": "花的芳心随着春天一同逝去，",
      "noteIds": ["n-fangxin"]
    },
    {
      "text": "所得是沾衣。",
      "pinyin": ["suǒ", "dé", "shì", "zhān", "yī"],
      "translation": "它所得到的，只是沾湿人的衣裳。",
