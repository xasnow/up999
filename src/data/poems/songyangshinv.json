  "lines": [
    {
      "text": "永日方戚戚，",
      "pinyin": ["yǒng", "rì", "fāng", "qī", "qī"],
      "translation": "这些天整天忧愁不安，",
      "noteIds": []
    },
    {
      "text": "出行复悠悠。",
      "pinyin": ["chū", "xíng", "fù", "yōu", "yōu"],
      "translation": "因为女儿就要出门远行，路途那么遥远。",
      "noteIds": []
    },
    {
      "text": "女子今有行，",
      "pinyin": ["nǚ", "zǐ", "jīn", "yǒu", "xíng"],
      "translation": "女儿今天要出嫁了，",
      "noteIds": ["n-youhang"]
    },
    {
      "text": "大江溯轻舟。",
      "pinyin": ["dà", "jiāng", "sù", "qīng", "zhōu"],
      "translation": "乘着轻舟沿大江逆流而上。",
      "noteIds": ["n-su"]
    },
    {
      "text": "尔辈苦无恃，",
      "pinyin": ["ěr", "bèi", "kǔ", "wú", "shì"],
      "translation": "你们姐妹从小没了母亲，实为可怜，",
      "noteIds": ["n-shi"]
    },
    {
      "text": "抚念益慈柔。",
      "pinyin": ["fǔ", "niàn", "yì", "cí", "róu"],
      "translation": "我抱着这份心疼，只能加倍地慈爱温柔。",
      "noteIds": []
    },
    {
      "text": "幼为长所育，",
      "pinyin": ["yòu", "wéi", "zhǎng", "suǒ", "yù"],
      "translation": "妹妹从小是姐姐带大的，",
      "noteIds": []
    },
    {
      "text": "两别泣不休。",
      "pinyin": ["liǎng", "bié", "qì", "bù", "xiū"],
      "translation": "如今两人分别，哭个不停。",
      "noteIds": []
    },
    {
      "text": "对此结中肠，",
      "pinyin": ["duì", "cǐ", "jié", "zhōng", "cháng"],
      "translation": "看着这一切，我心里像打了结，",
      "noteIds": []
    },
    {
      "text": "义往难复留。",
      "pinyin": ["yì", "wǎng", "nán", "fù", "liú"],
      "translation": "按情理她该出嫁，实在难以再挽留。",
      "noteIds": []
    },
    {
      "text": "自小阙内训，",
      "pinyin": ["zì", "xiǎo", "què", "nèi", "xùn"],
      "translation": "她从小缺少母亲的家教，",
      "noteIds": ["n-que"]
    },
    {
      "text": "事姑贻我忧。",
      "pinyin": ["shì", "gū", "yí", "wǒ", "yōu"],
      "translation": "出嫁后能不能伺候好婆婆，让我担忧。",
      "noteIds": ["n-yi"]
    },
    {
      "text": "赖兹托令门，",
      "pinyin": ["lài", "zī", "tuō", "lìng", "mén"],
      "translation": "幸好她嫁的是好人家，",
      "noteIds": ["n-lingmen"]
    },
    {
      "text": "任恤庶无尤。",
      "pinyin": ["rèn", "xù", "shù", "wú", "yóu"],
      "translation": "杨家人仁厚体恤，希望她不受委屈。",
      "noteIds": ["n-renxu"]
    },
    {
      "text": "贫俭诚所尚，",
      "pinyin": ["pín", "jiǎn", "chéng", "suǒ", "shàng"],
      "translation": "我们家贫，节俭是本来崇尚的，",
      "noteIds": []
    },
    {
      "text": "资从岂待周。",
      "pinyin": ["zī", "cóng", "qǐ", "dài", "zhōu"],
      "translation": "嫁妆哪里能置办得周全？",
      "noteIds": ["n-zicong"]
    },
    {
      "text": "孝恭遵妇道，",
      "pinyin": ["xiào", "gōng", "zūn", "fù", "dào"],
      "translation": "只盼你孝顺恭谨、遵守妇道，",
      "noteIds": []
    },
    {
      "text": "容止顺其猷。",
      "pinyin": ["róng", "zhǐ", "shùn", "qí", "yóu"],
      "translation": "言行举止都合规矩。",
      "noteIds": ["n-you"]
    },
    {
      "text": "别离在今晨，",
      "pinyin": ["bié", "lí", "zài", "jīn", "chén"],
      "translation": "别离就在今天早晨，",
      "noteIds": []
    },
    {
      "text": "见尔当何秋。",
      "pinyin": ["jiàn", "ěr", "dāng", "hé", "qiū"],
      "translation": "再见到你要等到哪一年？",
      "noteIds": []
    },
    {
      "text": "居闲始自遣，",
      "pinyin": ["jū", "xián", "shǐ", "zì", "qiǎn"],
      "translation": "平日闲居还能自我排遣，",
      "noteIds": []
    },
    {
      "text": "临感忽难收。",
      "pinyin": ["lín", "gǎn", "hū", "nán", "shōu"],
      "translation": "临到分别忽然就忍不住了。",
      "noteIds": []
    },
    {
      "text": "归来视幼女，",
      "pinyin": ["guī", "lái", "shì", "yòu", "nǚ"],
      "translation": "送嫁回来看到小女儿，",
      "noteIds": []
    },
    {
      "text": "零泪缘缨流。",
      "pinyin": ["líng", "lèi", "yuán", "yīng", "liú"],
      "translation": "眼泪顺着帽带流了下来。",
      "noteIds": ["n-ying"]
    }
  ],
