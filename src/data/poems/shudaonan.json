        "wèn",
        "jūn",
        "xī",
        "yóu",
        "hé",
        "shí",
        "huán",
        "wèi",
        "tú",
        "chán",
        "yán",
        "bù",
        "kě",
        "pān"
      ],
      "translation": "问你这次西游什么时候回来？可怕的路和陡峭的山岩没法攀登。",
      "noteIds": [
        "n-chanyan"
      ]
    },
    {
      "text": "但见悲鸟号古木，雄飞雌从绕林间。",
      "pinyin": [
        "dàn",
        "jiàn",
        "bēi",
        "niǎo",
        "háo",
        "gǔ",
        "mù",
        "xióng",
        "fēi",
        "cí",
        "cóng",
        "rào",
        "lín",
        "jiān"
      ],
      "translation": "只看见悲伤的鸟在古树上啼叫，雄鸟飞在前，雌鸟跟着，绕着树林飞。",
      "noteIds": [
        "n-haogumu"
      ]
    },
    {
      "text": "又闻子规啼夜月，愁空山。",
      "pinyin": [
        "yòu",
        "wén",
        "zǐ",
        "guī",
        "tí",
        "yè",
        "yuè",
        "chóu",
        "kōng",
        "shān"
      ],
      "translation": "又听见杜鹃在月夜里啼叫，空山一片愁。",
      "noteIds": [
        "n-zigui"
      ]
    },
    {
      "text": "蜀道之难，难于上青天，使人听此凋朱颜！",
      "pinyin": [
        "shǔ",
        "dào",
        "zhī",
        "nán",
        "nán",
        "yú",
        "shàng",
        "qīng",
        "tiān",
        "shǐ",
        "rén",
        "tīng",
        "cǐ",
        "diāo",
        "zhū",
        "yán"
      ],
      "translation": "走蜀道的难处，比上天还难，听到这些就让人吓得脸色都变了！",
      "noteIds": [
        "n-diaozhuyan"
      ]
    },
    {
      "text": "连峰去天不盈尺，枯松倒挂倚绝壁。",
      "pinyin": [
        "lián",
        "fēng",
        "qù",
        "tiān",
        "bù",
        "yíng",
        "chǐ",
        "kū",
        "sōng",
        "dào",
        "guà",
        "yǐ",
        "jué",
        "bì"
      ],
      "translation": "山峰连着山峰，离天不满一尺，枯松倒挂在绝壁上。",
      "noteIds": []
    },
    {
      "text": "飞湍瀑流争喧豗，砯崖转石万壑雷。",
      "pinyin": [
        "fēi",
        "tuān",
        "pù",
        "liú",
        "zhēng",
        "xuān",
        "huī",
        "pīng",
        "yá",
        "zhuǎn",
        "shí",
        "wàn",
        "hè",
        "léi"
      ],
      "translation": "急流和瀑布争先轰响，冲击山崖、滚动石头，千山万谷里响声像打雷。",
      "noteIds": [
