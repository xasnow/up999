        "huáng",
        "hè",
        "zhī",
        "fēi",
        "shàng",
        "bù",
        "dé",
        "guò",
        "yuán",
        "náo",
        "yù",
        "dù",
        "chóu",
        "pān",
        "yuán"
      ],
      "translation": "黄鹤善飞也飞不过去，猿猴想攀过去也发愁。",
      "noteIds": [
        "n-nao"
      ]
    },
    {
      "text": "青泥何盘盘，百步九折萦岩峦。",
      "pinyin": [
        "qīng",
        "ní",
        "hé",
        "pán",
        "pán",
        "bǎi",
        "bù",
        "jiǔ",
        "zhé",
        "yíng",
        "yán",
        "luán"
      ],
      "translation": "青泥岭的山路多么曲折，走一百步就要转九道弯，绕着山岩盘旋。",
      "noteIds": [
        "n-qingni"
      ]
    },
    {
      "text": "扪参历井仰胁息，以手抚膺坐长叹。",
