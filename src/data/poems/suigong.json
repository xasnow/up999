  "lines": [
    {
      "text": "紫泉宫殿锁烟霞，",
      "pinyin": ["zǐ", "quán", "gōng", "diàn", "suǒ", "yān", "xiá"],
      "translation": "长安的宫殿闲置在烟霞之中，",
      "noteIds": ["n-ziquan"]
    },
    {
      "text": "欲取芜城作帝家。",
      "pinyin": ["yù", "qǔ", "wú", "chéng", "zuò", "dì", "jiā"],
      "translation": "隋炀帝却一心想把扬州当作帝都之家。",
      "noteIds": ["n-wucheng"]
    },
    {
      "text": "玉玺不缘归日角，",
      "pinyin": ["yù", "xǐ", "bù", "yuán", "guī", "rì", "jiǎo"],
      "translation": "要不是传国玉玺归了李渊，",
      "noteIds": ["n-yuxi", "n-rijiao"]
    },
    {
      "text": "锦帆应是到天涯。",
      "pinyin": ["jǐn", "fān", "yīng", "shì", "dào", "tiān", "yá"],
      "translation": "他的锦帆船队只怕要一直游到天涯海角。",
      "noteIds": ["n-jinfan"]
    },
    {
      "text": "于今腐草无萤火，",
      "pinyin": ["yú", "jīn", "fǔ", "cǎo", "wú", "yíng", "huǒ"],
      "translation": "如今腐草里再也放不出当年的萤火，",
      "noteIds": ["n-yinghuo"]
    },
    {
      "text": "终古垂杨有暮鸦。",
      "pinyin": ["zhōng", "gǔ", "chuí", "yáng", "yǒu", "mù", "yā"],
      "translation": "千年运河堤上的垂柳，只有黄昏的鸦群栖息。",
      "noteIds": ["n-chuiyang", "n-muya"]
    },
    {
      "text": "地下若逢陈后主，",
      "pinyin": ["dì", "xià", "ruò", "féng", "chén", "hòu", "zhǔ"],
      "translation": "他到了地下如果遇见陈后主，",
      "noteIds": ["n-chenhouzhu"]
    },
    {
      "text": "岂宜重问后庭花。",
      "pinyin": ["qǐ", "yí", "chóng", "wèn", "hòu", "tíng", "huā"],
      "translation": "难道还好意思再问《玉树后庭花》的曲子？",
      "noteIds": ["n-houtinghua", "n-chongwen"]
    }
  ],
