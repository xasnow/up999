    {
      "text": "池潢不敢顾。",
      "pinyin": ["chí", "huáng", "bù", "gǎn", "gù"],
      "translation": "连小小的池塘都不敢看一眼。",
      "noteIds": ["n-huang"]
    },
    {
      "text": "侧见双翠鸟，",
      "pinyin": ["cè", "jiàn", "shuāng", "cuì", "niǎo"],
      "translation": "侧眼看见一对翠鸟，",
      "noteIds": []
    },
    {
      "text": "巢在三珠树。",
      "pinyin": ["cháo", "zài", "sān", "zhū", "shù"],
      "translation": "把巢筑在华贵的三珠树上。",
      "noteIds": []
    },
    {
      "text": "矫矫珍木巅，",
      "pinyin": ["jiǎo", "jiǎo", "zhēn", "mù", "diān"],
      "translation": "它们高高地站在珍贵树木的顶端，",
      "noteIds": ["n-jiao"]
    },
    {
      "text": "得无金丸惧？",
      "pinyin": ["dé", "wú", "jīn", "wán", "jù"],
      "translation": "难道不怕猎人的弹丸打过来吗？",
      "noteIds": []
