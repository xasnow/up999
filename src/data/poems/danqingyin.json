  "writtenLabel": "公元 764 年（杜甫 52 岁，在成都与流落的宫廷画家曹霸重逢）",
  "orderInAuthor": 12,
  "famousLines": [
    "斯须九重真龙出，一洗万古凡马空。"
  ],
  "lines": [
    {
      "text": "将军魏武之子孙，",
      "pinyin": [
        "jiāng",
        "jūn",
        "wèi",
        "wǔ",
        "zhī",
        "zǐ",
        "sūn"
      ],
      "translation": "曹将军是魏武帝曹操的后代，",
      "noteIds": [
        "n-weiwu"
      ]
    },
    {
      "text": "于今为庶为清门。",
      "pinyin": [
        "yú",
        "jīn",
        "wéi",
        "shù",
        "wéi",
        "qīng",
        "mén"
      ],
      "translation": "如今却沦为平民，成了清寒的门第。",
      "noteIds": []
    },
    {
      "text": "英雄割据虽已矣，",
      "pinyin": [
        "yīng",
        "xióng",
        "gē",
        "jù",
        "suī",
        "yǐ",
        "yǐ"
      ],
      "translation": "英雄割据的霸业虽然早已过去，",
      "noteIds": []
    },
    {
      "text": "文彩风流今尚存。",
      "pinyin": [
        "wén",
        "cǎi",
        "fēng",
        "liú",
        "jīn",
        "shàng",
        "cún"
      ],
      "translation": "但文采风流到今天仍然保存。",
      "noteIds": []
    },
    {
      "text": "学书初学卫夫人，",
      "pinyin": [
        "xué",
        "shū",
        "chū",
        "xué",
        "wèi",
        "fū",
        "rén"
      ],
      "translation": "他学书法起初学卫夫人，",
      "noteIds": [
        "n-weifuren"
      ]
    },
    {
      "text": "但恨无过王右军。",
      "pinyin": [
        "dàn",
        "hèn",
        "wú",
        "guò",
        "wáng",
        "yòu",
        "jūn"
      ],
      "translation": "只遗憾没能超过王羲之。",
      "noteIds": []
    },
    {
      "text": "丹青不知老将至，",
      "pinyin": [
        "dān",
        "qīng",
        "bù",
        "zhī",
        "lǎo",
        "jiāng",
        "zhì"
      ],
      "translation": "他专心绘画，连衰老来临都不觉得，",
      "noteIds": []
    },
    {
      "text": "富贵于我如浮云。",
      "pinyin": [
        "fù",
        "guì",
        "yú",
        "wǒ",
        "rú",
        "fú",
        "yún"
      ],
      "translation": "把富贵看作天上的浮云。",
      "noteIds": []
    },
    {
      "text": "开元之中常引见，",
      "pinyin": [
        "kāi",
        "yuán",
        "zhī",
        "zhōng",
        "cháng",
        "yǐn",
        "jiàn"
      ],
      "translation": "开元年间他常被皇帝引见，",
      "noteIds": []
    },
    {
      "text": "承恩数上南熏殿。",
      "pinyin": [
        "chéng",
        "ēn",
        "shuò",
        "shàng",
        "nán",
        "xūn",
        "diàn"
      ],
      "translation": "多次蒙恩登上南熏殿作画。",
      "noteIds": []
    },
    {
      "text": "凌烟功臣少颜色，",
      "pinyin": [
        "líng",
        "yān",
        "gōng",
        "chén",
        "shǎo",
        "yán",
        "sè"
      ],
      "translation": "凌烟阁上功臣的画像褪了颜色，",
      "noteIds": [
        "n-lingyan"
      ]
    },
    {
      "text": "将军下笔开生面。",
      "pinyin": [
        "jiāng",
        "jūn",
        "xià",
        "bǐ",
        "kāi",
        "shēng",
        "miàn"
      ],
      "translation": "将军下笔重画，让功臣像别开生面。",
      "noteIds": []
    },
    {
      "text": "良相头上进贤冠，",
      "pinyin": [
        "liáng",
        "xiàng",
        "tóu",
        "shàng",
        "jìn",
        "xián",
        "guān"
      ],
      "translation": "良相头上戴着进贤冠，",
      "noteIds": [
        "n-jinxian"
      ]
    },
    {
      "text": "猛将腰间大羽箭。",
      "pinyin": [
        "měng",
        "jiàng",
        "yāo",
        "jiān",
        "dà",
        "yǔ",
        "jiàn"
      ],
      "translation": "猛将腰间插着大羽箭。",
      "noteIds": []
    },
    {
      "text": "褒公鄂公毛发动，",
      "pinyin": [
        "bāo",
        "gōng",
        "è",
        "gōng",
        "máo",
        "fà",
        "dòng"
      ],
      "translation": "褒国公、鄂国公的毛发仿佛都在飘动，",
      "noteIds": [
        "n-baoe"
      ]
    },
    {
      "text": "英姿飒爽来酣战。",
      "pinyin": [
        "yīng",
        "zī",
        "sà",
        "shuǎng",
        "lái",
        "hān",
        "zhàn"
      ],
      "translation": "英姿飒爽，好像正要投入酣战。",
      "noteIds": []
    },
    {
      "text": "先帝天马玉花骢，",
      "pinyin": [
        "xiān",
        "dì",
        "tiān",
        "mǎ",
        "yù",
        "huā",
        "cōng"
      ],
      "translation": "先帝有天马玉花骢，",
      "noteIds": [
        "n-yuhuacong"
      ]
    },
    {
      "text": "画工如山貌不同。",
      "pinyin": [
        "huà",
        "gōng",
        "rú",
        "shān",
        "mào",
        "bù",
        "tóng"
      ],
      "translation": "画工众多如山，画的却都不像。",
      "noteIds": []
    },
    {
      "text": "是日牵来赤墀下，",
      "pinyin": [
        "shì",
        "rì",
        "qiān",
        "lái",
        "chì",
        "chí",
        "xià"
      ],
      "translation": "这一天马被牵到宫殿的红台阶下，",
      "noteIds": [
        "n-chichi"
      ]
    },
    {
      "text": "迥立阊阖生长风。",
      "pinyin": [
        "jiǒng",
        "lì",
        "chāng",
        "hé",
        "shēng",
        "cháng",
        "fēng"
      ],
      "translation": "昂然立在宫门前，仿佛生出一阵长风。",
      "noteIds": [
        "n-changhe"
      ]
    },
    {
      "text": "诏谓将军拂绢素，",
      "pinyin": [
        "zhào",
        "wèi",
        "jiāng",
        "jūn",
        "fú",
        "juàn",
        "sù"
      ],
      "translation": "皇帝下诏让将军展开画绢，",
      "noteIds": []
    },
    {
      "text": "意匠惨淡经营中。",
      "pinyin": [
        "yì",
        "jiàng",
        "cǎn",
        "dàn",
        "jīng",
        "yíng",
        "zhōng"
      ],
      "translation": "他匠心经营，苦苦构思。",
      "noteIds": [
        "n-yijiang"
      ]
    },
    {
      "text": "斯须九重真龙出，",
      "pinyin": [
        "sī",
        "xū",
        "jiǔ",
        "chóng",
        "zhēn",
        "lóng",
        "chū"
      ],
      "translation": "不一会儿，深宫里出现了一匹真龙般的骏马，",
      "noteIds": []
    },
    {
      "text": "一洗万古凡马空。",
      "pinyin": [
        "yī",
        "xǐ",
        "wàn",
        "gǔ",
        "fán",
        "mǎ",
        "kōng"
      ],
      "translation": "一下子让万古以来的凡马都黯然失色。",
      "noteIds": []
    },
    {
      "text": "玉花却在御榻上，",
      "pinyin": [
        "yù",
        "huā",
        "què",
        "zài",
        "yù",
        "tà",
        "shàng"
      ],
      "translation": "画上的玉花骢立在皇帝的坐榻上，",
      "noteIds": []
    },
    {
      "text": "榻上庭前屹相向。",
      "pinyin": [
        "tà",
        "shàng",
        "tíng",
        "qián",
        "yì",
        "xiāng",
        "xiàng"
      ],
      "translation": "榻上画马与庭前真马昂然相对。",
      "noteIds": []
    },
    {
      "text": "至尊含笑催赐金，",
      "pinyin": [
        "zhì",
        "zūn",
        "hán",
        "xiào",
        "cuī",
        "cì",
        "jīn"
      ],
      "translation": "皇帝含笑催促赏赐金钱，",
      "noteIds": []
    },
    {
      "text": "圉人太仆皆惆怅。",
      "pinyin": [
        "yǔ",
        "rén",
        "tài",
        "pú",
        "jiē",
        "chóu",
        "chàng"
      ],
      "translation": "马倌和马官都惆怅：画马比真马还要神骏。",
      "noteIds": [
        "n-yuren"
      ]
    },
    {
      "text": "弟子韩干早入室，",
      "pinyin": [
        "dì",
        "zǐ",
        "hán",
        "gān",
        "zǎo",
        "rù",
        "shì"
      ],
      "translation": "弟子韩干早已学得他的真传，",
      "noteIds": []
    },
    {
      "text": "亦能画马穷殊相。",
      "pinyin": [
        "yì",
        "néng",
        "huà",
        "mǎ",
        "qióng",
        "shū",
        "xiàng"
      ],
      "translation": "也能画尽马的种种姿态。",
      "noteIds": []
    },
    {
      "text": "干惟画肉不画骨，",
      "pinyin": [
        "gān",
        "wéi",
        "huà",
        "ròu",
        "bù",
        "huà",
        "gǔ"
      ],
      "translation": "可韩干只画出马的肥肉，画不出马的筋骨，",
      "noteIds": []
    },
    {
      "text": "忍使骅骝气凋丧。",
      "pinyin": [
        "rěn",
        "shǐ",
        "huá",
        "liú",
        "qì",
        "diāo",
        "sàng"
      ],
      "translation": "忍心让名马的气概荡然无存。",
      "noteIds": [
        "n-hualiu"
      ]
    },
    {
      "text": "将军善画盖有神，",
      "pinyin": [
        "jiāng",
        "jūn",
        "shàn",
        "huà",
        "gài",
        "yǒu",
        "shén"
      ],
      "translation": "将军擅长绘画，笔下自有神韵，",
      "noteIds": []
    },
    {
      "text": "必逢佳士亦写真。",
      "pinyin": [
        "bì",
        "féng",
        "jiā",
        "shì",
        "yì",
        "xiě",
        "zhēn"
      ],
      "translation": "遇到品德好的人才肯画像写真。",
      "noteIds": []
    },
    {
      "text": "即今漂泊干戈际，",
      "pinyin": [
        "jí",
        "jīn",
        "piāo",
        "bó",
        "gān",
        "gē",
        "jì"
      ],
      "translation": "如今在战乱中漂泊流离，",
      "noteIds": []
    },
    {
      "text": "屡貌寻常行路人。",
      "pinyin": [
        "lǚ",
        "mào",
        "xún",
        "cháng",
        "xíng",
        "lù",
        "rén"
      ],
      "translation": "只好一次次为普通的过路人画像谋生。",
      "noteIds": []
    },
    {
      "text": "途穷反遭俗眼白，",
      "pinyin": [
        "tú",
        "qióng",
        "fǎn",
        "zāo",
        "sú",
        "yǎn",
        "bái"
      ],
      "translation": "穷困潦倒，反而遭俗人白眼相待，",
      "noteIds": []
    },
    {
      "text": "世上未有如公贫。",
      "pinyin": [
        "shì",
        "shàng",
        "wèi",
        "yǒu",
        "rú",
        "gōng",
        "pín"
      ],
      "translation": "世上还没有像您这样穷困的大画家。",
      "noteIds": []
    },
    {
      "text": "但看古来盛名下，",
      "pinyin": [
        "dàn",
        "kàn",
        "gǔ",
        "lái",
        "shèng",
        "míng",
        "xià"
      ],
      "translation": "看看自古以来背负盛名的人，",
      "noteIds": []
    },
    {
      "text": "终日坎壈缠其身。",
      "pinyin": [
        "zhōng",
        "rì",
        "kǎn",
        "lǎn",
        "chán",
        "qí",
        "shēn"
      ],
      "translation": "终日被困顿失意缠绕着一生。",
      "noteIds": [
        "n-kanlan"
      ]
    }
  ],
