  "lines": [
    {
      "text": "昔有佳人公孙氏，",
      "pinyin": [
        "xī",
        "yǒu",
        "jiā",
        "rén",
        "gōng",
        "sūn",
        "shì"
      ],
      "translation": "从前有一位美丽的女子公孙氏，",
      "noteIds": [
        "n-gongsun"
      ]
    },
    {
      "text": "一舞剑器动四方。",
      "pinyin": [
        "yī",
        "wǔ",
        "jiàn",
        "qì",
        "dòng",
        "sì",
        "fāng"
      ],
      "translation": "她一舞起剑器，就震动四方。",
      "noteIds": [
        "n-jianqi"
      ]
    },
    {
      "text": "观者如山色沮丧，",
      "pinyin": [
        "guān",
        "zhě",
        "rú",
        "shān",
        "sè",
        "jǔ",
        "sàng"
      ],
      "translation": "观看的人多得像山一样，个个看得神色惊动，",
      "noteIds": []
    },
    {
      "text": "天地为之久低昂。",
      "pinyin": [
        "tiān",
        "dì",
        "wèi",
        "zhī",
        "jiǔ",
        "dī",
        "áng"
      ],
      "translation": "天地也仿佛随着她的舞姿长久地起伏。",
      "noteIds": []
    },
    {
      "text": "霍如羿射九日落，",
      "pinyin": [
        "huò",
        "rú",
        "yì",
        "shè",
        "jiǔ",
        "rì",
        "luò"
      ],
      "translation": "剑光闪动，快得像后羿射落九个太阳，",
      "noteIds": [
        "n-yi"
      ]
    },
    {
      "text": "矫如群帝骖龙翔。",
      "pinyin": [
        "jiǎo",
        "rú",
        "qún",
        "dì",
        "cān",
        "lóng",
        "xiáng"
      ],
      "translation": "身姿矫健，像天帝们驾着龙车飞翔。",
      "noteIds": [
        "n-can"
      ]
    },
    {
      "text": "来如雷霆收震怒，",
      "pinyin": [
        "lái",
        "rú",
        "léi",
        "tíng",
        "shōu",
        "zhèn",
        "nù"
      ],
      "translation": "舞势一起，像雷霆收住了满腔的震怒，",
      "noteIds": []
    },
    {
      "text": "罢如江海凝清光。",
      "pinyin": [
        "bà",
        "rú",
        "jiāng",
        "hǎi",
        "níng",
        "qīng",
        "guāng"
      ],
      "translation": "舞势一收，像江海凝聚着一片清光。",
      "noteIds": []
    },
    {
      "text": "绛唇珠袖两寂寞，",
      "pinyin": [
        "jiàng",
        "chún",
        "zhū",
        "xiù",
        "liǎng",
        "jì",
        "mò"
      ],
      "translation": "如今红唇和舞袖都已沉寂无人知晓，",
      "noteIds": []
    },
    {
      "text": "晚有弟子传芬芳。",
      "pinyin": [
        "wǎn",
        "yǒu",
        "dì",
        "zǐ",
        "chuán",
        "fēn",
        "fāng"
      ],
      "translation": "晚年幸好有弟子把这份技艺传承下来。",
      "noteIds": []
    },
    {
      "text": "临颍美人在白帝，",
      "pinyin": [
        "lín",
        "yǐng",
        "měi",
        "rén",
        "zài",
        "bái",
        "dì"
      ],
      "translation": "临颍来的李十二娘，如今就在白帝城献艺，",
      "noteIds": [
        "n-linying",
        "n-baidi"
      ]
    },
    {
      "text": "妙舞此曲神扬扬。",
      "pinyin": [
        "miào",
        "wǔ",
        "cǐ",
        "qǔ",
        "shén",
        "yáng",
        "yáng"
      ],
      "translation": "她跳起这支剑器舞，神情飞扬。",
      "noteIds": []
    },
    {
      "text": "与余问答既有以，",
      "pinyin": [
        "yǔ",
        "yú",
        "wèn",
        "dá",
        "jì",
        "yǒu",
        "yǐ"
      ],
      "translation": "她与我一番问答，说出了师承来历，",
      "noteIds": []
    },
    {
      "text": "感时抚事增惋伤。",
      "pinyin": [
        "gǎn",
        "shí",
        "fǔ",
        "shì",
        "zēng",
        "wǎn",
        "shāng"
      ],
      "translation": "我感念时事、追忆往事，更添惋惜和感伤。",
      "noteIds": []
    },
    {
      "text": "先帝侍女八千人，",
      "pinyin": [
