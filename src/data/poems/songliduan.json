    },
    {
      "text": "离别自堪悲。",
      "pinyin": ["lí", "bié", "zì", "kān", "bēi"],
      "translation": "离别本来就让人悲伤。",
      "noteIds": []
    },
    {
      "text": "路出寒云外，",
      "pinyin": ["lù", "chū", "hán", "yún", "wài"],
      "translation": "朋友要走的路伸向寒云深处，",
      "noteIds": []
    },
    {
      "text": "人归暮雪时。",
      "pinyin": ["rén", "guī", "mù", "xuě", "shí"],
      "translation": "我回家时，傍晚的雪已经飘了起来。",
      "noteIds": []
    },
    {
      "text": "少孤为客早，",
      "pinyin": ["shào", "gū", "wéi", "kè", "zǎo"],
      "translation": "我从小失去父亲，很早就出门漂泊，",
      "noteIds": ["n-shaogu"]
    },
    {
      "text": "多难识君迟。",
      "pinyin": ["duō", "nàn", "shí", "jūn", "chí"],
      "translation": "经过那么多磨难才认识你，觉得太迟了。",
      "noteIds": ["n-duonan"]
    },
    {
      "text": "掩泪空相向，",
      "pinyin": ["yǎn", "lèi", "kōng", "xiāng", "xiàng"],
      "translation": "擦着眼泪白白地望着你远去，",
      "noteIds": ["n-yanlei"]
    },
