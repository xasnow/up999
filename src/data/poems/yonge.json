  "translation": "鹅呀，鹅呀，鹅呀，弯着脖子对着天空唱歌。雪白的羽毛浮在绿水上，红红的脚掌拨动清清的水波。",
  "appreciation": "这首诗是骆宾王七岁时写的。他看见池塘里的白鹅，就把它唱成了一首歌。开头连喊三声“鹅”，像小朋友惊喜地叫起来。“曲项向天歌”写鹅伸着脖子大声叫。后两句用颜色作画：白毛、绿水、红掌、清波。四种颜色放在一起，画面特别鲜亮。读的时候，眼前就像有一只鹅在游水。",
  "background": "骆宾王小时候住在浙江义乌的村子里。有一天，家里来了客人，想考考这个小孩。客人指着池塘里游泳的白鹅，让他作一首诗。七岁的骆宾王看了一会儿，张嘴就念出了这首诗。",
  "storyline": [
    {
      "step": 1,
      "title": "村里有个池塘",
      "text": "骆宾王的家门口有一个池塘，水清清的，常有大白鹅在游。"
    },
    {
      "step": 2,
      "title": "客人来考孩子",
      "text": "家里来了客人，客人指着池塘里的鹅，让七岁的小宾王作诗。"
    },
    {
      "step": 3,
      "title": "白鹅仰头唱歌",
      "text": "大白鹅弯着脖子，对着天空大声叫：鹅，鹅，鹅。"
    },
    {
      "step": 4,
      "title": "红掌拨着水波",
      "text": "白羽毛浮在绿水上，红脚掌一下一下地划，水面荡开一圈圈波纹。"
    }
  ],
