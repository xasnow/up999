  "lines": [
    {
      "text": "男儿事长征，",
      "pinyin": ["nán", "ér", "shì", "cháng", "zhēng"],
      "translation": "好男儿去从军远征，",
      "noteIds": ["n-changzheng"]
    },
    {
      "text": "少小幽燕客。",
      "pinyin": ["shào", "xiǎo", "yōu", "yān", "kè"],
      "translation": "年纪轻轻就闯荡幽燕边地。",
      "noteIds": ["n-youyan"]
    },
    {
      "text": "赌胜马蹄下，",
      "pinyin": ["dǔ", "shèng", "mǎ", "tí", "xià"],
      "translation": "他们在马蹄下比武争胜，",
      "noteIds": []
    },
    {
      "text": "由来轻七尺。",
      "pinyin": ["yóu", "lái", "qīng", "qī", "chǐ"],
      "translation": "从来不把性命看得多重。",
      "noteIds": ["n-qichi"]
    },
    {
      "text": "杀人莫敢前，",
      "pinyin": ["shā", "rén", "mò", "gǎn", "qián"],
      "translation": "打起仗来勇猛得敌人不敢上前，",
      "noteIds": []
    },
    {
      "text": "须如猬毛磔。",
      "pinyin": ["xū", "rú", "wèi", "máo", "zhé"],
      "translation": "胡须张开，像刺猬的毛一样根根竖起。",
      "noteIds": ["n-weimaoze"]
    },
    {
      "text": "黄云陇底白云飞，",
      "pinyin": ["huáng", "yún", "lǒng", "dǐ", "bái", "yún", "fēi"],
      "translation": "边地黄土上黄云低垂，白云飞掠，",
      "noteIds": ["n-long"]
    },
    {
      "text": "未得报恩不能归。",
      "pinyin": ["wèi", "dé", "bào", "ēn", "bù", "néng", "guī"],
      "translation": "没能报答君恩，就不能回家。",
      "noteIds": []
    },
    {
      "text": "辽东小妇年十五，",
      "pinyin": ["liáo", "dōng", "xiǎo", "fù", "nián", "shí", "wǔ"],
      "translation": "辽东的小妇人才十五岁，",
      "noteIds": []
    },
    {
      "text": "惯弹琵琶解歌舞。",
      "pinyin": ["guàn", "tán", "pí", "pá", "jiě", "gē", "wǔ"],
      "translation": "弹惯了琵琶，又会唱歌跳舞。",
      "noteIds": ["n-jie"]
    },
    {
      "text": "今为羌笛出塞声，",
      "pinyin": ["jīn", "wéi", "qiāng", "dí", "chū", "sài", "shēng"],
      "translation": "今天她吹起羌笛，奏出出塞的曲调，",
      "noteIds": ["n-qiangdi", "n-chusai"]
    },
    {
      "text": "使我三军泪如雨。",
      "pinyin": ["shǐ", "wǒ", "sān", "jūn", "lèi", "rú", "yǔ"],
      "translation": "全军将士听了，眼泪像下雨一样落下来。",
      "noteIds": []
    }
  ],
