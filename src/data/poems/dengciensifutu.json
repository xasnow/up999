  "famousLines": [
    "塔势如涌出，孤高耸天宫。",
    "下窥指高鸟，俯听闻惊风。"
  ],
  "lines": [
    {
      "text": "塔势如涌出，",
      "pinyin": ["tǎ", "shì", "rú", "yǒng", "chū"],
      "translation": "宝塔的气势像从地下涌出来一样，",
      "noteIds": []
    },
    {
      "text": "孤高耸天宫。",
      "pinyin": ["gū", "gāo", "sǒng", "tiān", "gōng"],
      "translation": "孤零零地高耸在天上宫殿之间。",
      "noteIds": []
    },
    {
      "text": "登临出世界，",
      "pinyin": ["dēng", "lín", "chū", "shì", "jiè"],
      "translation": "登上塔顶，就像走出了人间世界。",
      "noteIds": []
    },
    {
      "text": "磴道盘虚空。",
      "pinyin": ["dèng", "dào", "pán", "xū", "kōng"],
      "translation": "石阶在虚空里盘旋而上。",
      "noteIds": ["n-dengdao"]
    },
    {
      "text": "突兀压神州，",
      "pinyin": ["tū", "wù", "yā", "shén", "zhōu"],
      "translation": "塔高耸突出，像压住了神州大地。",
      "noteIds": ["n-tuwu"]
    },
    {
      "text": "峥嵘如鬼工。",
      "pinyin": ["zhēng", "róng", "rú", "guǐ", "gōng"],
      "translation": "雄伟高峻，像是鬼斧神工。",
      "noteIds": ["n-zhengrong"]
    },
    {
      "text": "四角碍白日，",
      "pinyin": ["sì", "jiǎo", "ài", "bái", "rì"],
      "translation": "塔的四角能挡住太阳。",
      "noteIds": []
    },
    {
      "text": "七层摩苍穹。",
      "pinyin": ["qī", "céng", "mó", "cāng", "qióng"],
      "translation": "七层塔顶几乎碰到天空。",
      "noteIds": ["n-cangqiong"]
    },
    {
      "text": "下窥指高鸟，",
      "pinyin": ["xià", "kuī", "zhǐ", "gāo", "niǎo"],
      "translation": "往下一看，能指认出高飞的鸟。",
      "noteIds": ["n-kui"]
    },
    {
      "text": "俯听闻惊风。",
      "pinyin": ["fǔ", "tīng", "wén", "jīng", "fēng"],
      "translation": "侧耳一听，能听到猛烈的风声。",
      "noteIds": []
    },
    {
      "text": "连山若波涛，",
      "pinyin": ["lián", "shān", "ruò", "bō", "tāo"],
      "translation": "连绵的群山像波涛一样，",
      "noteIds": []
    },
    {
      "text": "奔凑似朝东。",
      "pinyin": ["bēn", "còu", "sì", "cháo", "dōng"],
      "translation": "奔流着好像一起涌向东方。",
      "noteIds": ["n-bencou"]
    },
    {
      "text": "青槐夹驰道，",
      "pinyin": ["qīng", "huái", "jiā", "chí", "dào"],
      "translation": "青青的槐树夹着皇帝的御道。",
      "noteIds": ["n-chidao"]
    },
    {
      "text": "宫馆何玲珑。",
      "pinyin": ["gōng", "guǎn", "hé", "líng", "lóng"],
      "translation": "宫殿楼馆多么精巧玲珑。",
      "noteIds": []
    },
    {
      "text": "秋色从西来，",
      "pinyin": ["qiū", "sè", "cóng", "xī", "lái"],
      "translation": "秋色从西边吹来，",
      "noteIds": []
    },
    {
      "text": "苍然满关中。",
      "pinyin": ["cāng", "rán", "mǎn", "guān", "zhōng"],
      "translation": "苍苍茫茫铺满了关中平原。",
      "noteIds": []
    },
    {
      "text": "五陵北原上，",
      "pinyin": ["wǔ", "líng", "běi", "yuán", "shàng"],
      "translation": "北面原野上的五座汉朝皇陵，",
      "noteIds": ["n-wuling"]
    },
    {
      "text": "万古青濛濛。",
      "pinyin": ["wàn", "gǔ", "qīng", "méng", "méng"],
      "translation": "千万年来都是一片青濛濛。",
      "noteIds": ["n-mengmeng"]
    },
    {
      "text": "净理了可悟，",
      "pinyin": ["jìng", "lǐ", "liǎo", "kě", "wù"],
      "translation": "佛家清净的道理，现在完全能够领悟，",
      "noteIds": ["n-jingli"]
    },
    {
      "text": "胜因夙所宗。",
      "pinyin": ["shèng", "yīn", "sù", "suǒ", "zōng"],
      "translation": "佛家的善因是我素来尊崇的。",
      "noteIds": ["n-shengyin", "n-su"]
    },
    {
      "text": "誓将挂冠去，",
      "pinyin": ["shì", "jiāng", "guà", "guān", "qù"],
      "translation": "我发誓要摘下官帽离去，",
      "noteIds": ["n-guaguan"]
    },
    {
      "text": "觉道资无穷。",
      "pinyin": ["jué", "dào", "zī", "wú", "qióng"],
      "translation": "觉悟之道会给我无穷的力量。",
      "noteIds": ["n-juedao"]
    }
  ],
