  "lines": [
    {
      "text": "迢递三巴路，",
      "pinyin": ["tiáo", "dì", "sān", "bā", "lù"],
      "translation": "遥远的巴蜀山路上，",
      "noteIds": ["n-tiaodi", "n-sanba"]
    },
    {
      "text": "羁危万里身。",
      "pinyin": ["jī", "wēi", "wàn", "lǐ", "shēn"],
      "translation": "我漂泊万里、身处险途。",
      "noteIds": ["n-jiwei"]
    },
    {
      "text": "乱山残雪夜，",
      "pinyin": ["luàn", "shān", "cán", "xuě", "yè"],
      "translation": "乱山围绕，残雪未消的夜里，",
      "noteIds": []
    },
    {
      "text": "孤烛异乡人。",
      "pinyin": ["gū", "zhú", "yì", "xiāng", "rén"],
      "translation": "一支孤烛，照着异乡人。",
      "noteIds": []
    },
    {
      "text": "渐与骨肉远，",
      "pinyin": ["jiàn", "yǔ", "gǔ", "ròu", "yuǎn"],
      "translation": "渐渐地和骨肉亲人离得远了，",
      "noteIds": []
    },
    {
      "text": "转于僮仆亲。",
      "pinyin": ["zhuǎn", "yú", "tóng", "pú", "qīn"],
      "translation": "反倒跟僮仆日益亲近。",
      "noteIds": ["n-tongpu"]
    },
    {
      "text": "那堪正飘泊，",
      "pinyin": ["nǎ", "kān", "zhèng", "piāo", "bó"],
      "translation": "哪里受得了这样的漂泊啊——",
      "noteIds": []
    },
