  ],
  "lines": [
    {
      "text": "怀君属秋夜，",
      "pinyin": ["huái", "jūn", "shǔ", "qiū", "yè"],
      "translation": "想念你呀，正赶上这秋凉之夜，",
      "noteIds": ["n-huai", "n-shu"]
    },
    {
      "text": "散步咏凉天。",
      "pinyin": ["sàn", "bù", "yǒng", "liáng", "tiān"],
      "translation": "我一边散步，一边吟着凉天的诗。",
      "noteIds": ["n-yong"]
    },
    {
      "text": "空山松子落，",
      "pinyin": ["kōng", "shān", "sōng", "zǐ", "luò"],
      "translation": "空寂的山里，松子落下来了，",
      "noteIds": []
    },
    {
      "text": "幽人应未眠。",
      "pinyin": ["yōu", "rén", "yīng", "wèi", "mián"],
      "translation": "隐居的你，大概也还没睡吧。",
      "noteIds": ["n-youren", "n-mian"]
    }
  ],
