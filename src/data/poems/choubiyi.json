  "lines": [
    {
      "text": "猿鸟犹疑畏简书，",
      "pinyin": ["yuán", "niǎo", "yóu", "yí", "wèi", "jiǎn", "shū"],
      "translation": "猿猴飞鸟至今仍像畏惧当年的军令，",
      "noteIds": ["n-jianshu", "n-choubiyi"]
    },
    {
      "text": "风云常为护储胥。",
      "pinyin": ["fēng", "yún", "cháng", "wèi", "hù", "chǔ", "xū"],
      "translation": "风云仿佛常常守护着旧日的营垒。",
      "noteIds": ["n-chuxu"]
    },
    {
      "text": "徒令上将挥神笔，",
      "pinyin": ["tú", "lìng", "shàng", "jiàng", "huī", "shén", "bǐ"],
      "translation": "只可惜诸葛亮空自挥动运筹的神笔，",
      "noteIds": ["n-shangjiang"]
    },
    {
      "text": "终见降王走传车。",
      "pinyin": ["zhōng", "jiàn", "xiáng", "wáng", "zǒu", "zhuàn", "chē"],
      "translation": "终究还是看着后主被装入驿车送往洛阳。",
      "noteIds": ["n-jiangwang", "n-zhuanche"]
    },
    {
      "text": "管乐有才原不忝，",
      "pinyin": ["guǎn", "yuè", "yǒu", "cái", "yuán", "bù", "tiǎn"],
      "translation": "他比管仲、乐毅，才华确实毫不逊色，",
      "noteIds": ["n-guanyue", "n-butian"]
    },
    {
      "text": "关张无命欲何如。",
      "pinyin": ["guān", "zhāng", "wú", "mìng", "yù", "hé", "rú"],
      "translation": "可关羽、张飞命丧身死，又能怎样呢？",
      "noteIds": ["n-guanzhang"]
    },
    {
      "text": "他年锦里经祠庙，",
      "pinyin": ["tā", "nián", "jǐn", "lǐ", "jīng", "cí", "miào"],
      "translation": "来年我在成都锦里经过武侯祠，",
      "noteIds": ["n-jinli"]
    },
    {
      "text": "梁父吟成恨有余。",
      "pinyin": ["liáng", "fù", "yín", "chéng", "hèn", "yǒu", "yú"],
      "translation": "吟罢诸葛亮爱唱的《梁父吟》，遗恨绵绵不尽。",
      "noteIds": ["n-liangfuyin"]
    }
  ],
