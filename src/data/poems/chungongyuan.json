  "lines": [
    {
      "text": "早被婵娟误，",
      "pinyin": ["zǎo", "bèi", "chán", "juān", "wù"],
      "translation": "早年因为美貌被选进宫里，反而耽误了自己。",
      "noteIds": ["n-chanjuan"]
    },
    {
      "text": "欲妆临镜慵。",
      "pinyin": ["yù", "zhuāng", "lín", "jìng", "yōng"],
      "translation": "想梳妆打扮，对着镜子却懒洋洋没有心思。",
      "noteIds": ["n-yong"]
    },
    {
      "text": "承恩不在貌，",
      "pinyin": ["chéng", "ēn", "bú", "zài", "mào"],
      "translation": "得到宠爱并不在于容貌，",
      "noteIds": ["n-chengen"]
    },
    {
      "text": "教妾若为容。",
      "pinyin": ["jiào", "qiè", "ruò", "wéi", "róng"],
      "translation": "又叫我怎样去修饰打扮呢？",
      "noteIds": ["n-ruowei"]
    },
    {
      "text": "风暖鸟声碎，",
      "pinyin": ["fēng", "nuǎn", "niǎo", "shēng", "suì"],
