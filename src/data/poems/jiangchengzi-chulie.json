  "lines": [
    {
      "text": "老夫聊发少年狂，",
      "pinyin": ["lǎo", "fū", "liáo", "fā", "shào", "nián", "kuáng"],
      "translation": "我这老头子也来学年轻人，狂放一回，",
      "noteIds": ["n-liaofa"]
    },
    {
      "text": "左牵黄，",
      "pinyin": ["zuǒ", "qiān", "huáng"],
      "translation": "左手牵着黄狗，",
      "noteIds": []
    },
    {
      "text": "右擎苍，",
      "pinyin": ["yòu", "qíng", "cāng"],
      "translation": "右臂托着苍鹰。",
      "noteIds": []
    },
    {
      "text": "锦帽貂裘，",
      "pinyin": ["jǐn", "mào", "diāo", "qiú"],
      "translation": "随从们戴着锦蒙帽，穿着貂皮袍，",
      "noteIds": ["n-diaoqiu"]
    },
    {
      "text": "千骑卷平冈。",
      "pinyin": ["qiān", "jì", "juǎn", "píng", "gāng"],
      "translation": "大队人马像一阵风卷过平坦的山冈。",
      "noteIds": ["n-qianqi"]
    },
    {
      "text": "为报倾城随太守，",
      "pinyin": ["wèi", "bào", "qīng", "chéng", "suí", "tài", "shǒu"],
      "translation": "为了回报全城人来看打猎的情意，我要像孙权一样，",
      "noteIds": ["n-taishou"]
    },
    {
      "text": "亲射虎，",
      "pinyin": ["qīn", "shè", "hǔ"],
      "translation": "亲手射杀猛虎，",
      "noteIds": []
    },
    {
      "text": "看孙郎。",
      "pinyin": ["kàn", "sūn", "láng"],
      "translation": "让大家看看这位“孙郎”。",
      "noteIds": ["n-sunlang"]
    },
    {
      "text": "酒酣胸胆尚开张，",
      "pinyin": ["jiǔ", "hān", "xiōng", "dǎn", "shàng", "kāi", "zhāng"],
      "translation": "喝到畅快时，胸怀和胆气更加豪壮，",
      "noteIds": ["n-jiuhan"]
    },
    {
      "text": "鬓微霜，",
      "pinyin": ["bìn", "wēi", "shuāng"],
      "translation": "鬓角虽然白了些，",
      "noteIds": []
    },
    {
      "text": "又何妨！",
      "pinyin": ["yòu", "hé", "fáng"],
      "translation": "那又有什么关系！",
      "noteIds": []
    },
    {
      "text": "持节云中，",
      "pinyin": ["chí", "jié", "yún", "zhōng"],
      "translation": "像朝廷拿着符节到云中去赦免魏尚那样，",
      "noteIds": ["n-chijie"]
    },
    {
      "text": "何日遣冯唐？",
      "pinyin": ["hé", "rì", "qiǎn", "féng", "táng"],
      "translation": "什么时候才能派冯唐来重新起用我呢？",
      "noteIds": ["n-fengtang"]
    },
    {
      "text": "会挽雕弓如满月，",
      "pinyin": ["huì", "wǎn", "diāo", "gōng", "rú", "mǎn", "yuè"],
      "translation": "到那时我一定把雕弓拉得像满月一样，",
      "noteIds": []
    },
    {
      "text": "西北望，",
      "pinyin": ["xī", "běi", "wàng"],
      "translation": "朝着西北方向瞄准，",
      "noteIds": []
    },
    {
      "text": "射天狼。",
      "pinyin": ["shè", "tiān", "láng"],
      "translation": "把来犯的天狼星射下来。",
      "noteIds": ["n-tianlang"]
    }
  ],
