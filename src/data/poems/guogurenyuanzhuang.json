  "famousLines": [
    "绿树村边合，青山郭外斜。"
  ],
  "lines": [
    {
      "text": "故人具鸡黍，",
      "pinyin": ["gù", "rén", "jù", "jī", "shǔ"],
      "translation": "老朋友备好了饭菜，等我去做客。",
      "noteIds": ["n-shu"]
    },
    {
      "text": "邀我至田家。",
      "pinyin": ["yāo", "wǒ", "zhì", "tián", "jiā"],
      "translation": "热情地邀请我到他的田家小院。",
      "noteIds": []
    },
    {
      "text": "绿树村边合，",
      "pinyin": ["lǜ", "shù", "cūn", "biān", "hé"],
      "translation": "绿树把村庄团团围在中间。",
      "noteIds": []
    },
    {
      "text": "青山郭外斜。",
      "pinyin": ["qīng", "shān", "guō", "wài", "xié"],
      "translation": "村外还有青青的山，斜斜地伸向远方。",
      "noteIds": []
    },
    {
      "text": "开轩面场圃，",
      "pinyin": ["kāi", "xuān", "miàn", "cháng", "pǔ"],
      "translation": "推开窗户，正对着打谷场和菜园。",
      "noteIds": ["n-xuan", "n-changpu"]
    },
    {
      "text": "把酒话桑麻。",
      "pinyin": ["bǎ", "jiǔ", "huà", "sāng", "má"],
      "translation": "端起酒杯，聊着种庄稼的事。",
      "noteIds": []
    },
    {
      "text": "待到重阳日，",
      "pinyin": ["dài", "dào", "chóng", "yáng", "rì"],
      "translation": "等到九月九日重阳节那天，",
      "noteIds": []
    },
    {
      "text": "还来就菊花。",
      "pinyin": ["huán", "lái", "jiù", "jú", "huā"],
      "translation": "我还要再来，和你一起赏菊花。",
      "noteIds": ["n-huan"]
    }
  ],
