  ],
  "lines": [
    {
      "text": "联步趋丹陛，",
      "pinyin": ["lián", "bù", "qū", "dān", "bì"],
      "translation": "我们并肩快步，走上宫殿的红台阶。",
      "noteIds": ["n-danbi"]
    },
    {
      "text": "分曹限紫微。",
      "pinyin": ["fēn", "cáo", "xiàn", "zǐ", "wēi"],
      "translation": "分属两个衙门，隔在中书省的两边。",
      "noteIds": ["n-fencao", "n-ziwei"]
    },
    {
      "text": "晓随天仗入，",
      "pinyin": ["xiǎo", "suí", "tiān", "zhàng", "rù"],
      "translation": "清晨跟着皇帝的仪仗进宫。",
      "noteIds": ["n-tianzhang"]
    },
    {
      "text": "暮惹御香归。",
      "pinyin": ["mù", "rě", "yù", "xiāng", "guī"],
      "translation": "傍晚带着宫殿里的香气回家。",
      "noteIds": ["n-yuxiang"]
    },
    {
      "text": "白发悲花落，",
      "pinyin": ["bái", "fà", "bēi", "huā", "luò"],
      "translation": "头发白了，看见花落就心生悲伤。",
      "noteIds": []
    },
    {
      "text": "青云羡鸟飞。",
      "pinyin": ["qīng", "yún", "xiàn", "niǎo", "fēi"],
      "translation": "仰望青云，羡慕鸟儿还能自由飞翔。",
      "noteIds": ["n-qingyun"]
    },
    {
      "text": "圣朝无阙事，",
      "pinyin": ["shèng", "cháo", "wú", "què", "shì"],
      "translation": "圣明的朝廷没有什么缺失的事。",
      "noteIds": ["n-queshi"]
    },
    {
      "text": "自觉谏书稀。",
      "pinyin": ["zì", "jué", "jiàn", "shū", "xī"],
      "translation": "自己也觉得进谏的奏章越来越少了。",
      "noteIds": ["n-jianshu"]
    }
  ],
