---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PoemDetail from '../../../../components/PoemDetail.astro';
import { poemsOfDynasty, getAuthor, getDynasty, getEra, getCover } from '../../../../lib/content';
import { poemKeywords, poemJsonLd } from '../../../../lib/seo';

export function getStaticPaths() {
  return poemsOfDynasty('qita').map((poem) => ({
    params: { era: poem.era, author: poem.authorId, poem: poem.slug },
    props: { poem }
  }));
}
const { poem } = Astro.props;
const author = getAuthor(poem.authorId);
const dynasty = getDynasty('qita');
const era = getEra('qita', poem.era);
const cover = getCover(poem);
---

<BaseLayout
  title={`${poem.title} · ${author.name} · 每天一首小古诗`}
  description={`${poem.title}（${author.name}）：带拼音、注释、译文和时间线讲解，小学生也能读懂。`}
  keywords={poemKeywords(poem, author)}
  jsonLd={poemJsonLd(poem, author, dynasty.label, era.label, cover?.src)}
>
  <PoemDetail poem={poem} />
</BaseLayout>
