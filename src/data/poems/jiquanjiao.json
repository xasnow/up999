  "lines": [
    {
      "text": "今朝郡斋冷，",
      "pinyin": ["jīn", "zhāo", "jùn", "zhāi", "lěng"],
      "translation": "今天早晨郡斋里透着寒气，",
      "noteIds": ["n-junzhai"]
    },
    {
      "text": "忽念山中客。",
      "pinyin": ["hū", "niàn", "shān", "zhōng", "kè"],
      "translation": "我忽然想念起住在山中的朋友。",
      "noteIds": []
    },
    {
      "text": "涧底束荆薪，",
      "pinyin": ["jiàn", "dǐ", "shù", "jīng", "xīn"],
      "translation": "这时他大概在山涧底捆柴，",
      "noteIds": ["n-jingxin"]
    },
    {
      "text": "归来煮白石。",
      "pinyin": ["guī", "lái", "zhǔ", "bái", "shí"],
      "translation": "回来用白石当粮煮着吃。",
      "noteIds": ["n-baishi"]
    },
    {
      "text": "欲持一瓢酒，",
      "pinyin": ["yù", "chí", "yī", "piáo", "jiǔ"],
      "translation": "我想带上一瓢酒，",
      "noteIds": ["n-piao"]
    },
    {
      "text": "远慰风雨夕。",
      "pinyin": ["yuǎn", "wèi", "fēng", "yǔ", "xī"],
      "translation": "在风雨的傍晚去远方慰问他。",
      "noteIds": []
    },
    {
      "text": "落叶满空山，",
      "pinyin": ["luò", "yè", "mǎn", "kōng", "shān"],
      "translation": "可是落叶铺满了空寂的山，",
      "noteIds": []
    },
    {
      "text": "何处寻行迹。",
      "pinyin": ["hé", "chù", "xún", "xíng", "jì"],
      "translation": "到哪里去寻找他的踪迹呢？",
