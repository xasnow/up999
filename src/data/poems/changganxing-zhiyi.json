  "genre": "shi",
  "form": "五言乐府",
  "authorId": "libai",
  "gradeBand": "ext",
  "difficulty": 3,
  "tags": ["思念", "五言乐府", "青梅", "绿苔"],
  "writtenYear": 726,
  "writtenLabel": "约公元 726 年（李白 26 岁，初游金陵长干里一带时所作）",
  "orderInAuthor": 4,
  "famousLines": [
    "郎骑竹马来，绕床弄青梅。",
    "同居长干里，两小无嫌猜。"
  ],
  "lines": [
    {
      "text": "妾发初覆额，",
      "pinyin": ["qiè", "fà", "chū", "fù", "é"],
      "translation": "我的头发刚刚盖过额头，",
      "noteIds": []
    },
    {
      "text": "折花门前剧。",
      "pinyin": ["zhé", "huā", "mén", "qián", "jù"],
      "translation": "折着花枝在门前游戏。",
      "noteIds": ["n-ju"]
    },
    {
      "text": "郎骑竹马来，",
      "pinyin": ["láng", "qí", "zhú", "mǎ", "lái"],
      "translation": "你骑着竹马跑来，",
      "noteIds": ["n-zhuma"]
    },
    {
      "text": "绕床弄青梅。",
      "pinyin": ["rào", "chuáng", "nòng", "qīng", "méi"],
      "translation": "绕着井栏逗弄青梅。",
      "noteIds": ["n-nongqingmei"]
    },
    {
      "text": "同居长干里，",
      "pinyin": ["tóng", "jū", "cháng", "gān", "lǐ"],
      "translation": "我们同住在长干里，",
      "noteIds": ["n-changganli"]
    },
    {
      "text": "两小无嫌猜。",
      "pinyin": ["liǎng", "xiǎo", "wú", "xián", "cāi"],
      "translation": "两个孩子没有一点猜疑。",
      "noteIds": []
    },
    {
      "text": "十四为君妇，",
      "pinyin": ["shí", "sì", "wéi", "jūn", "fù"],
      "translation": "十四岁嫁给你做妻子，",
      "noteIds": []
    },
    {
      "text": "羞颜未尝开。",
      "pinyin": ["xiū", "yán", "wèi", "cháng", "kāi"],
      "translation": "羞涩的脸不曾露出笑容。",
      "noteIds": []
    },
    {
      "text": "低头向暗壁，",
      "pinyin": ["dī", "tóu", "xiàng", "àn", "bì"],
      "translation": "低头对着昏暗的墙壁，",
      "noteIds": []
    },
    {
      "text": "千唤不一回。",
      "pinyin": ["qiān", "huàn", "bù", "yì", "huí"],
      "translation": "千遍呼唤也不肯回一次头。",
      "noteIds": []
    },
    {
      "text": "十五始展眉，",
      "pinyin": ["shǐ", "wǔ", "shǐ", "zhǎn", "méi"],
      "translation": "十五岁才舒展开眉头，",
      "noteIds": []
    },
    {
      "text": "愿同尘与灰。",
      "pinyin": ["yuàn", "tóng", "chén", "yǔ", "huī"],
      "translation": "愿与你化作灰尘也在一起。",
      "noteIds": []
    },
    {
      "text": "常存抱柱信，",
      "pinyin": ["cháng", "cún", "bào", "zhù", "xìn"],
      "translation": "我常存着尾生抱柱那样的信念，",
      "noteIds": ["n-baozhu"]
    },
    {
      "text": "岂上望夫台。",
      "pinyin": ["qǐ", "shàng", "wàng", "fū", "tái"],
      "translation": "哪里想到真会登上望夫台？",
      "noteIds": ["n-wangfutai"]
    },
    {
      "text": "十六君远行，",
      "pinyin": ["shí", "liù", "jūn", "yuǎn", "xíng"],
      "translation": "十六岁你离家远行，",
      "noteIds": []
    },
    {
      "text": "瞿塘滟滪堆。",
      "pinyin": ["qú", "táng", "yàn", "yù", "duī"],
      "translation": "要经过瞿塘峡可怕的滟滪堆。",
      "noteIds": ["n-yanyudui"]
    },
    {
      "text": "五月不可触，",
      "pinyin": ["wǔ", "yuè", "bù", "kě", "chù"],
      "translation": "五月江水暴涨，船万不可靠近，",
      "noteIds": []
    },
    {
      "text": "猿声天上哀。",
      "pinyin": ["yuán", "shēng", "tiān", "shàng", "āi"],
      "translation": "两岸猿声在天上哀哀啼叫。",
      "noteIds": []
    },
    {
      "text": "门前迟行迹，",
      "pinyin": ["mén", "qián", "chí", "xíng", "jì"],
      "translation": "门前你离家时留下的足迹，",
      "noteIds": ["n-chixingji"]
    },
    {
      "text": "一一生绿苔。",
      "pinyin": ["yì", "yì", "shēng", "lǜ", "tái"],
      "translation": "如今一处一处都生满了绿苔。",
      "noteIds": []
    },
    {
      "text": "苔深不能扫，",
      "pinyin": ["tái", "shēn", "bù", "néng", "sǎo"],
      "translation": "苔太深了，扫也扫不尽，",
      "noteIds": []
    },
    {
      "text": "落叶秋风早。",
      "pinyin": ["luò", "yè", "qiū", "fēng", "zǎo"],
      "translation": "秋风一起，落叶早早飘下来。",
      "noteIds": []
    },
    {
      "text": "八月蝴蝶来，",
      "pinyin": ["bā", "yuè", "hú", "dié", "lái"],
      "translation": "八月里蝴蝶飞来，",
      "noteIds": []
    },
    {
      "text": "双飞西园草。",
      "pinyin": ["shuāng", "fēi", "xī", "yuán", "cǎo"],
      "translation": "成双成对飞过西园的草丛。",
      "noteIds": []
    },
    {
      "text": "感此伤妾心，",
      "pinyin": ["gǎn", "cǐ", "shāng", "qiè", "xīn"],
      "translation": "看到这情景我伤心难过，",
      "noteIds": []
    },
    {
      "text": "坐愁红颜老。",
      "pinyin": ["zuò", "chóu", "hóng", "yán", "lǎo"],
      "translation": "忧愁得红颜都快衰老了。",
      "noteIds": ["n-zuo"]
    },
    {
      "text": "早晚下三巴，",
      "pinyin": ["zǎo", "wǎn", "xià", "sān", "bā"],
      "translation": "你什么时候能顺流下三巴回家？",
      "noteIds": ["n-sanba"]
    },
    {
      "text": "预将书报家。",
      "pinyin": ["yù", "jiāng", "shū", "bào", "jiā"],
      "translation": "请预先把书信捎到家里。",
      "noteIds": []
    },
    {
      "text": "相迎不道远，",
      "pinyin": ["xiāng", "yíng", "bú", "dào", "yuǎn"],
      "translation": "我去迎接你，不管路有多远，",
      "noteIds": ["n-budao"]
    },
    {
      "text": "直至长风沙。",
      "pinyin": ["zhí", "zhì", "cháng", "fēng", "shā"],
      "translation": "哪怕一直走到长风沙。",
      "noteIds": ["n-changfengsha"]
    }
  ],
