  ],
  "lines": [
    {
      "text": "轮台城头夜吹角，",
      "pinyin": ["lún", "tái", "chéng", "tóu", "yè", "chuī", "jiǎo"],
      "translation": "轮台城头，夜里吹响了号角，",
      "noteIds": ["n-chuijiao"]
    },
    {
      "text": "轮台城北旄头落。",
      "pinyin": ["lún", "tái", "chéng", "běi", "máo", "tóu", "luò"],
      "translation": "轮台城北，旄头星正在隐落。",
      "noteIds": ["n-maotou"]
    },
    {
      "text": "羽书昨夜过渠黎，",
      "pinyin": ["yǔ", "shū", "zuó", "yè", "guò", "qú", "lí"],
      "translation": "紧急的军书昨夜经过渠黎，",
      "noteIds": ["n-yushu", "n-quli"]
    },
    {
      "text": "单于已在金山西。",
      "pinyin": ["chán", "yú", "yǐ", "zài", "jīn", "shān", "xī"],
      "translation": "敌军首领已在金山的西面。",
      "noteIds": ["n-chanyu", "n-jinshan"]
    },
    {
      "text": "戍楼西望烟尘黑，",
      "pinyin": ["shù", "lóu", "xī", "wàng", "yān", "chén", "hēi"],
      "translation": "登上戍楼向西望，烟尘一片漆黑，",
      "noteIds": ["n-shulou"]
    },
    {
      "text": "汉军屯在轮台北。",
      "pinyin": ["hàn", "jūn", "tún", "zài", "lún", "tái", "běi"],
      "translation": "汉家的军队驻扎在轮台北面。",
      "noteIds": []
    },
    {
      "text": "上将拥旄西出征，",
      "pinyin": ["shàng", "jiàng", "yōng", "máo", "xī", "chū", "zhēng"],
      "translation": "主将手持旄节向西出征，",
      "noteIds": ["n-yongmao"]
    },
    {
      "text": "平明吹笛大军行。",
      "pinyin": ["píng", "míng", "chuī", "dí", "dà", "jūn", "xíng"],
      "translation": "天亮时笛声响起，大军开拔。",
      "noteIds": []
    },
    {
      "text": "四边伐鼓雪海涌，",
      "pinyin": ["sì", "biān", "fá", "gǔ", "xuě", "hǎi", "yǒng"],
      "translation": "四面战鼓擂动，像雪海在翻涌，",
      "noteIds": ["n-xuehai"]
    },
    {
      "text": "三军大呼阴山动。",
      "pinyin": ["sān", "jūn", "dà", "hū", "yīn", "shān", "dòng"],
      "translation": "三军齐声呐喊，连阴山都震动了。",
      "noteIds": ["n-yinshan"]
    },
    {
      "text": "虏塞兵气连云屯，",
      "pinyin": ["lǔ", "sài", "bīng", "qì", "lián", "yún", "tún"],
      "translation": "敌人的要塞上，兵气冲天连着云，",
      "noteIds": ["n-lusai"]
    },
    {
      "text": "战场白骨缠草根。",
      "pinyin": ["zhàn", "chǎng", "bái", "gǔ", "chán", "cǎo", "gēn"],
      "translation": "战场上白骨缠绕着草根。",
      "noteIds": []
    },
    {
      "text": "剑河风急雪片阔，",
      "pinyin": ["jiàn", "hé", "fēng", "jí", "xuě", "piàn", "kuò"],
      "translation": "剑河上风急雪大片，",
      "noteIds": ["n-jianhe"]
    },
    {
      "text": "沙口石冻马蹄脱。",
      "pinyin": ["shā", "kǒu", "shí", "dòng", "mǎ", "tí", "tuō"],
      "translation": "沙口的石头冻裂，马蹄都脱落。",
      "noteIds": []
    },
    {
      "text": "亚相勤王甘苦辛，",
      "pinyin": ["yà", "xiàng", "qín", "wáng", "gān", "kǔ", "xīn"],
      "translation": "亚相封常清为王事甘愿辛苦，",
      "noteIds": ["n-yaxiang", "n-qinwang"]
    },
    {
      "text": "誓将报主静边尘。",
      "pinyin": ["shì", "jiāng", "bào", "zhǔ", "jìng", "biān", "chén"],
      "translation": "发誓报答君主，扫平边地的烟尘。",
      "noteIds": []
    },
    {
      "text": "古来青史谁不见，",
      "pinyin": ["gǔ", "lái", "qīng", "shǐ", "shuí", "bú", "jiàn"],
      "translation": "自古史书上的功名谁没见过？",
      "noteIds": ["n-qingshi"]
    },
    {
      "text": "今见功名胜古人。",
      "pinyin": ["jīn", "jiàn", "gōng", "míng", "shèng", "gǔ", "rén"],
      "translation": "如今看见的功名，胜过了古人。",
      "noteIds": []
    }
  ],
