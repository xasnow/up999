  "lines": [
    {
      "text": "南山截竹为觱篥，",
      "pinyin": ["nán", "shān", "jié", "zhú", "wéi", "bì", "lì"],
      "translation": "从南山砍下竹子做成觱篥，",
      "noteIds": ["n-bili"]
    },
    {
      "text": "此乐本自龟兹出。",
      "pinyin": ["cǐ", "yuè", "běn", "zì", "qiū", "cí", "chū"],
      "translation": "这种乐器原本出自龟兹。",
      "noteIds": ["n-qiuci"]
    },
    {
      "text": "流传汉地曲转奇，",
      "pinyin": ["liú", "chuán", "hàn", "dì", "qǔ", "zhuǎn", "qí"],
      "translation": "传到中原后，曲调越发奇妙，",
      "noteIds": []
    },
    {
      "text": "凉州胡人为我吹。",
      "pinyin": ["liáng", "zhōu", "hú", "rén", "wèi", "wǒ", "chuī"],
      "translation": "凉州来的乐师安万善为我们吹奏。",
      "noteIds": []
    },
    {
      "text": "旁邻闻者多叹息，",
      "pinyin": ["páng", "lín", "wén", "zhě", "duō", "tàn", "xī"],
      "translation": "邻近听到的多是叹息，",
      "noteIds": []
    },
    {
      "text": "远客思乡皆泪垂。",
      "pinyin": ["yuǎn", "kè", "sī", "xiāng", "jiē", "lèi", "chuí"],
      "translation": "远来的客人想起家乡，个个落泪。",
      "noteIds": []
    },
    {
      "text": "世人解听不解赏，",
      "pinyin": ["shì", "rén", "jiě", "tīng", "bù", "jiě", "shǎng"],
      "translation": "世人只会听，不懂得欣赏，",
      "noteIds": ["n-jie"]
    },
    {
      "text": "长飙风中自来往。",
      "pinyin": ["cháng", "biāo", "fēng", "zhōng", "zì", "lái", "wǎng"],
      "translation": "乐声就像狂风里自由来去的气浪。",
      "noteIds": ["n-biao"]
    },
    {
      "text": "枯桑老柏寒飕飗，",
      "pinyin": ["kū", "sāng", "lǎo", "bǎi", "hán", "sōu", "liú"],
      "translation": "一会儿像寒风吹过枯桑老柏，飕飗作响，",
      "noteIds": ["n-souliu"]
    },
    {
      "text": "九雏鸣凤乱啾啾。",
      "pinyin": ["jiǔ", "chú", "míng", "fèng", "luàn", "jiū", "jiū"],
      "translation": "一会儿像九只小凤凰啾啾乱鸣。",
      "noteIds": []
    },
    {
      "text": "龙吟虎啸一时发，",
      "pinyin": ["lóng", "yín", "hǔ", "xiào", "yī", "shí", "fā"],
      "translation": "又像龙吟虎啸一齐迸发，",
      "noteIds": []
    },
    {
      "text": "万籁百泉相与秋。",
      "pinyin": ["wàn", "lài", "bǎi", "quán", "xiāng", "yǔ", "qiū"],
      "translation": "万种声响、百道泉水，一同在秋色里轰鸣。",
      "noteIds": ["n-wanlai"]
    },
    {
      "text": "忽然更作渔阳掺，",
      "pinyin": ["hū", "rán", "gèng", "zuò", "yú", "yáng", "càn"],
      "translation": "忽然改吹急促悲壮的《渔阳掺》，",
      "noteIds": ["n-yuyangcan"]
    },
    {
      "text": "黄云萧条白日暗。",
      "pinyin": ["huáng", "yún", "xiāo", "tiáo", "bái", "rì", "àn"],
      "translation": "天上黄云萧条，白日也昏暗下来。",
      "noteIds": []
    },
    {
      "text": "变调如闻杨柳春，",
      "pinyin": ["biàn", "diào", "rú", "wén", "yáng", "liǔ", "chūn"],
      "translation": "曲调一转，又像春天的《折杨柳》，",
      "noteIds": ["n-yangliu"]
    },
    {
      "text": "上林繁花照眼新。",
      "pinyin": ["shàng", "lín", "fán", "huā", "zhào", "yǎn", "xīn"],
      "translation": "像上林苑的繁花，照得眼前一片明艳。",
      "noteIds": ["n-shanglin"]
    },
    {
      "text": "岁夜高堂列明烛，",
      "pinyin": ["suì", "yè", "gāo", "táng", "liè", "míng", "zhú"],
      "translation": "除夕夜的高堂上点起明烛，",
      "noteIds": ["n-suiye"]
    },
    {
      "text": "美酒一杯声一曲。",
      "pinyin": ["měi", "jiǔ", "yī", "bēi", "shēng", "yī", "qǔ"],
      "translation": "喝一杯美酒，就听一曲觱篥。",
      "noteIds": []
    }
  ],
