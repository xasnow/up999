  "lines": [
    {
      "text": "锦瑟无端五十弦，",
      "pinyin": ["jǐn", "sè", "wú", "duān", "wǔ", "shí", "xián"],
      "translation": "锦瑟啊，你为什么平白有五十根弦？",
      "noteIds": ["n-jinse", "n-wuduan"]
    },
    {
      "text": "一弦一柱思华年。",
      "pinyin": ["yī", "xián", "yī", "zhù", "sī", "huá", "nián"],
      "translation": "一根弦一根柱，都让人思念逝去的年华。",
      "noteIds": []
    },
    {
      "text": "庄生晓梦迷蝴蝶，",
      "pinyin": ["zhuāng", "shēng", "xiǎo", "mèng", "mí", "hú", "dié"],
      "translation": "庄子清晨梦中，分不清是自己变成蝴蝶，还是蝴蝶变成自己，",
      "noteIds": ["n-zhuangsheng"]
    },
    {
      "text": "望帝春心托杜鹃。",
      "pinyin": ["wàng", "dì", "chūn", "xīn", "tuō", "dù", "juān"],
      "translation": "望帝的一片春心，死后托付给了啼血的杜鹃。",
      "noteIds": ["n-wangdi"]
    },
    {
      "text": "沧海月明珠有泪，",
      "pinyin": ["cāng", "hǎi", "yuè", "míng", "zhū", "yǒu", "lèi"],
      "translation": "月明之夜，大海里鲛人的泪珠化成了明珠，",
      "noteIds": ["n-zhuyoulei"]
    },
    {
      "text": "蓝田日暖玉生烟。",
      "pinyin": ["lán", "tián", "rì", "nuǎn", "yù", "shēng", "yān"],
      "translation": "日暖之时，蓝田美玉升起袅袅轻烟。",
      "noteIds": ["n-lantian"]
    },
    {
      "text": "此情可待成追忆，",
      "pinyin": ["cǐ", "qíng", "kě", "dài", "chéng", "zhuī", "yì"],
      "translation": "这样的情怀，哪里用得着等到今天才追忆？",
      "noteIds": []
    },
    {
      "text": "只是当时已惘然。",
      "pinyin": ["zhǐ", "shì", "dāng", "shí", "yǐ", "wǎng", "rán"],
      "translation": "只是身在当时，就已经怅然若失了。",
      "noteIds": ["n-wangran"]
    }
