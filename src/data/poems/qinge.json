  "lines": [
    {
      "text": "主人有酒欢今夕，",
      "pinyin": ["zhǔ", "rén", "yǒu", "jiǔ", "huān", "jīn", "xī"],
      "translation": "主人备好了酒，今晚大家欢聚，",
      "noteIds": []
    },
    {
      "text": "请奏鸣琴广陵客。",
      "pinyin": ["qǐng", "zòu", "míng", "qín", "guǎng", "líng", "kè"],
      "translation": "请来一位善弹琴的高手奏琴。",
      "noteIds": ["n-guanglingke"]
    },
    {
      "text": "月照城头乌半飞，",
      "pinyin": ["yuè", "zhào", "chéng", "tóu", "wū", "bàn", "fēi"],
      "translation": "月光照着城头，乌鸦被惊起飞散，",
      "noteIds": ["n-wu"]
    },
    {
      "text": "霜凄万木风入衣。",
      "pinyin": ["shuāng", "qī", "wàn", "mù", "fēng", "rù", "yī"],
      "translation": "寒霜让万木凄清，冷风钻进了衣裳。",
      "noteIds": []
    },
    {
      "text": "铜炉华烛烛增辉，",
      "pinyin": ["tóng", "lú", "huá", "zhú", "zhú", "zēng", "huī"],
      "translation": "铜香炉和华丽蜡烛的火光越烧越亮，",
      "noteIds": []
    },
    {
      "text": "初弹渌水后楚妃。",
      "pinyin": ["chū", "tán", "lù", "shuǐ", "hòu", "chǔ", "fēi"],
      "translation": "琴师先弹《渌水》，又弹《楚妃》。",
      "noteIds": ["n-lvshui", "n-chufei"]
    },
    {
      "text": "一声已动物皆静，",
      "pinyin": ["yī", "shēng", "yǐ", "dòng", "wù", "jiē", "jìng"],
      "translation": "琴声一响，万物都安静下来，",
