  "translation": "秦地有位像罗敷那样的姑娘，正在碧绿的江水边采桑叶。雪白的手伸在青青的桑枝上，红妆映着太阳格外鲜亮。她说：家里的蚕饿了，我要回去了，驾着五马大车的官老爷请别纠缠。",
  "appreciation": "这首诗借乐府《陌上桑》里的罗敷故事写春日采桑：素手、青条、红妆、白日，四种颜色互相映衬，画面明亮得像春天的太阳。妙在结尾借姑娘之口一句“蚕饥妾欲去”，又巧又俏皮，既找了回家的理由，又婉转地回绝了纠缠的贵人，把姑娘的聪慧大方写得活灵活现。",
  "background": "《子夜吴歌》原是南朝乐府《子夜四时歌》，分春、夏、秋、冬四首。李白借用旧题重新创作，这一首化用汉代采桑女罗敷的传说，写秦地春日的采桑姑娘。一般认为作于开元年间他漫游四方的时候。",
  "storyline": [
    {
      "step": 1,
      "title": "春江采桑",
      "text": "春水碧绿，像罗敷一样的姑娘在江边采桑叶。"
    },
    {
      "step": 2,
      "title": "素手红妆",
      "text": "白手伸上青枝，红妆映着白日，人比春光还鲜亮。"
    },
    {
      "step": 3,
      "title": "蚕饥欲归",
      "text": "姑娘说家里的蚕饿了，要赶回去喂蚕。"
    },
    {
      "step": 4,
      "title": "婉拒贵人",
      "text": "面对五马车的官老爷，她巧妙地说：请别留难。"
    }
  ],
