  ],
  "lines": [
    {
      "text": "移家虽带郭，",
      "pinyin": ["yí", "jiā", "suī", "dài", "guō"],
      "translation": "陆羽虽然刚搬了家，但住得离城不远。",
      "noteIds": ["n-daiguo"]
    },
    {
      "text": "野径入桑麻。",
      "pinyin": ["yě", "jìng", "rù", "sāng", "má"],
      "translation": "一条小路穿过桑树和麻田，通向他的住处。",
      "noteIds": []
    },
    {
      "text": "近种篱边菊，",
      "pinyin": ["jìn", "zhòng", "lí", "biān", "jú"],
      "translation": "篱笆边新种的菊花，",
      "noteIds": []
    },
    {
      "text": "秋来未著花。",
      "pinyin": ["qiū", "lái", "wèi", "zhuó", "huā"],
      "translation": "到了秋天还没有开花。",
      "noteIds": ["n-zhuohua"]
    },
    {
      "text": "扣门无犬吠，",
      "pinyin": ["kòu", "mén", "wú", "quǎn", "fèi"],
      "translation": "我敲门没有人应，连狗叫都没有。",
      "noteIds": ["n-quanfei"]
    },
    {
      "text": "欲去问西家。",
      "pinyin": ["yù", "qù", "wèn", "xī", "jiā"],
      "translation": "正想离开，就去问西边的邻居。",
      "noteIds": ["n-xijia"]
    },
    {
      "text": "报道山中去，",
      "pinyin": ["bào", "dào", "shān", "zhōng", "qù"],
      "translation": "邻居说他进山里去了，",
      "noteIds": ["n-baodao"]
    },
    {
      "text": "归时每日斜。",
      "pinyin": ["guī", "shí", "měi", "rì", "xié"],
      "translation": "常常要到太阳落山才回来。",
      "noteIds": []
    }
  ],
