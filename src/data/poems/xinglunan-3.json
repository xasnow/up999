  "famousLines": [
    "且乐生前一杯酒，何须身后千载名？"
  ],
  "lines": [
    {
      "text": "有耳莫洗颍川水，",
      "pinyin": [
        "yǒu",
        "ěr",
        "mò",
        "xǐ",
        "yǐng",
        "chuān",
        "shuǐ"
      ],
      "translation": "有耳朵就别去颍川水里洗，",
      "noteIds": [
        "n-yingchuan"
      ]
    },
    {
      "text": "有口莫食首阳蕨。",
      "pinyin": [
        "yǒu",
        "kǒu",
        "mò",
        "shí",
        "shǒu",
        "yáng",
        "jué"
      ],
      "translation": "有嘴就别去吃首阳山的蕨菜。",
      "noteIds": [
        "n-shouyang"
      ]
    },
    {
      "text": "含光混世贵无名，",
      "pinyin": [
        "hán",
        "guāng",
        "hùn",
        "shì",
        "guì",
        "wú",
        "míng"
      ],
      "translation": "把才华藏在身上、混同世俗，可贵的是不求名声，",
      "noteIds": [
        "n-hanguang"
      ]
    },
    {
      "text": "何用孤高比云月？",
      "pinyin": [
        "hé",
        "yòng",
        "gū",
        "gāo",
        "bǐ",
        "yún",
        "yuè"
      ],
      "translation": "何必孤芳自赏，自比天上的云和月？",
      "noteIds": []
    },
    {
      "text": "吾观自古贤达人，",
      "pinyin": [
        "wú",
        "guān",
        "zì",
        "gǔ",
        "xián",
        "dá",
        "rén"
      ],
      "translation": "我看自古以来的贤能通达之人，",
      "noteIds": []
    },
    {
      "text": "功成不退皆殒身。",
      "pinyin": [
        "gōng",
        "chéng",
        "bù",
        "tuì",
        "jiē",
        "yǔn",
        "shēn"
      ],
      "translation": "功成名就却不肯退身的，都丢了性命。",
      "noteIds": [
        "n-yunshen"
      ]
    },
    {
      "text": "子胥既弃吴江上，",
      "pinyin": [
        "zǐ",
        "xū",
        "jì",
        "qì",
        "wú",
        "jiāng",
        "shàng"
      ],
      "translation": "伍子胥被抛弃，尸身抛在吴江上，",
      "noteIds": [
        "n-zixu"
      ]
    },
    {
      "text": "屈原终投湘水滨。",
      "pinyin": [
        "qū",
        "yuán",
        "zhōng",
        "tóu",
        "xiāng",
        "shuǐ",
        "bīn"
      ],
      "translation": "屈原最终投进了湘水之滨。",
      "noteIds": []
    },
    {
      "text": "陆机雄才岂自保？",
      "pinyin": [
        "lù",
        "jī",
        "xióng",
        "cái",
        "qǐ",
        "zì",
        "bǎo"
      ],
      "translation": "陆机这样的大才子，难道能保住自己？",
      "noteIds": [
        "n-luji"
      ]
    },
    {
      "text": "李斯税驾苦不早。",
      "pinyin": [
        "lǐ",
        "sī",
        "shuì",
        "jià",
        "kǔ",
        "bù",
        "zǎo"
      ],
      "translation": "李斯叹息想卸下重担，只恨退身太晚了。",
      "noteIds": [
        "n-lisi"
      ]
    },
    {
      "text": "华亭鹤唳讵可闻？",
      "pinyin": [
        "huá",
        "tíng",
        "hè",
        "lì",
        "jù",
        "kě",
        "wén"
      ],
      "translation": "华亭的鹤鸣，陆机临刑前还能再听到吗？",
      "noteIds": [
        "n-huating"
      ]
    },
    {
      "text": "上蔡苍鹰何足道？",
      "pinyin": [
        "shàng",
        "cài",
        "cāng",
        "yīng",
        "hé",
        "zú",
        "dào"
      ],
      "translation": "上蔡东门的苍鹰，李斯再也牵不到了，还有什么可说？",
      "noteIds": [
        "n-shangcai"
      ]
    },
    {
      "text": "君不见吴中张翰称达生，",
      "pinyin": [
        "jūn",
        "bú",
        "jiàn",
        "wú",
        "zhōng",
        "zhāng",
        "hàn",
        "chēng",
        "dá",
        "shēng"
      ],
      "translation": "你难道没看见吴中的张翰被人称赞为通达之人，",
      "noteIds": [
        "n-zhanghan"
      ]
    },
    {
      "text": "秋风忽忆江东行。",
      "pinyin": [
        "qiū",
        "fēng",
        "hū",
        "yì",
        "jiāng",
        "dōng",
        "xíng"
      ],
      "translation": "秋风一起，他就想起家乡，立刻动身回江东去。",
      "noteIds": []
    },
    {
      "text": "且乐生前一杯酒，",
      "pinyin": [
        "qiě",
        "lè",
        "shēng",
        "qián",
        "yì",
        "bēi",
        "jiǔ"
      ],
      "translation": "不如快活地在生前喝下一杯酒，",
      "noteIds": []
    },
    {
      "text": "何须身后千载名？",
      "pinyin": [
        "hé",
        "xū",
        "shēn",
        "hòu",
        "qiān",
        "zǎi",
        "míng"
      ],
      "translation": "何必在乎死后千年的名声？",
      "noteIds": [
        "n-qianzai"
      ]
    }
  ],
