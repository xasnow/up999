      "pinyin": "shuò qì",
      "meaning": "北方的寒气。朔指北方，读 shuò。"
    },
    {
      "id": "n-jintuo",
      "word": "金柝",
      "pinyin": "jīn tuò",
      "meaning": "军中夜里打更用的梆子。柝读 tuò。"
    },
    {
      "id": "n-cexun",
      "word": "策勋",
      "pinyin": "cè xūn",
      "meaning": "记功。策是记录的意思。"
    },
    {
      "id": "n-zhuan",
      "word": "转",
      "pinyin": "zhuǎn",
      "meaning": "勋级每升一级叫“一转”，十二转表示功劳极高。"
    },
    {
      "id": "n-qiang",
      "word": "强",
      "pinyin": "qiáng",
      "meaning": "有余。“百千强”就是比百千还要多。"
    },
    {
      "id": "n-shangshu",
      "word": "尚书郎",
      "pinyin": "shàng shū láng",
      "meaning": "尚书省的官员，泛指朝廷里的高官。"
    },
