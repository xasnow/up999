    "黄叶仍风雨，青楼自管弦。"
  ],
  "lines": [
    {
      "text": "凄凉宝剑篇，",
      "pinyin": ["qī", "liáng", "bǎo", "jiàn", "piān"],
      "translation": "我空有《宝剑篇》那样的才志，却落得凄凉，",
      "noteIds": ["n-baojianpian"]
    },
    {
      "text": "羁泊欲穷年。",
      "pinyin": ["jī", "bó", "yù", "qióng", "nián"],
      "translation": "漂泊在外，仿佛要穷尽一生。",
      "noteIds": ["n-jibo"]
    },
    {
      "text": "黄叶仍风雨，",
      "pinyin": ["huáng", "yè", "réng", "fēng", "yǔ"],
      "translation": "枯黄的树叶，仍遭风雨摧残，",
      "noteIds": []
    },
    {
      "text": "青楼自管弦。",
      "pinyin": ["qīng", "lóu", "zì", "guǎn", "xián"],
      "translation": "高楼上富贵人家，照旧奏乐作乐。",
      "noteIds": ["n-qinglou"]
    },
    {
      "text": "新知遭薄俗，",
      "pinyin": ["xīn", "zhī", "zāo", "bó", "sú"],
      "translation": "新结交的知己，也遭受浇薄的世情排挤，",
      "noteIds": ["n-xinzhi", "n-bosu"]
    },
    {
      "text": "旧好隔良缘。",
      "pinyin": ["jiù", "hǎo", "gé", "liáng", "yuán"],
      "translation": "旧日的好友，又隔着难以再续的缘分。",
      "noteIds": []
    },
    {
      "text": "心断新丰酒，",
      "pinyin": ["xīn", "duàn", "xīn", "fēng", "jiǔ"],
      "translation": "断念吧——纵有新丰美酒，",
      "noteIds": ["n-xinfeng"]
    },
    {
      "text": "销愁斗几千。",
      "pinyin": ["xiāo", "chóu", "dǒu", "jǐ", "qiān"],
      "translation": "要买一斗来消愁，也需几千钱。",
      "noteIds": ["n-dou"]
    }
