  ],
  "lines": [
    {
      "text": "长安城头头白乌，",
      "pinyin": [
        "cháng",
        "ān",
        "chéng",
        "tóu",
        "tóu",
        "bái",
        "wū"
      ],
      "translation": "长安城头上落着一只白头乌鸦，",
      "noteIds": [
        "n-baiwu"
      ]
    },
    {
      "text": "夜飞延秋门上呼。",
      "pinyin": [
        "yè",
        "fēi",
        "yán",
        "qiū",
        "mén",
        "shàng",
        "hū"
      ],
      "translation": "夜里飞到延秋门上啼叫。",
      "noteIds": [
        "n-yanqiumen"
      ]
    },
    {
      "text": "又向人家啄大屋，",
      "pinyin": [
        "yòu",
        "xiàng",
        "rén",
        "jiā",
        "zhuó",
        "dà",
        "wū"
      ],
      "translation": "它又飞向人家的大宅啄叫，",
      "noteIds": []
    },
    {
      "text": "屋底达官走避胡。",
      "pinyin": [
        "wū",
        "dǐ",
        "dá",
        "guān",
        "zǒu",
        "bì",
        "hú"
      ],
      "translation": "屋里的大官们早已逃走躲避胡兵。",
      "noteIds": []
    },
    {
      "text": "金鞭断折九马死，",
      "pinyin": [
        "jīn",
        "biān",
        "duàn",
        "zhé",
        "jiǔ",
        "mǎ",
        "sǐ"
      ],
      "translation": "皇帝出逃时金鞭折断，驾车的骏马也累死了，",
      "noteIds": []
    },
    {
      "text": "骨肉不得同驰驱。",
      "pinyin": [
        "gǔ",
        "ròu",
        "bù",
        "dé",
        "tóng",
        "chí",
        "qū"
      ],
      "translation": "骨肉至亲都不能一同乘车逃走。",
      "noteIds": []
    },
    {
      "text": "腰下宝玦青珊瑚，",
      "pinyin": [
        "yāo",
        "xià",
        "bǎo",
        "jué",
        "qīng",
        "shān",
        "hú"
      ],
      "translation": "有个少年腰间佩着宝玦和青珊瑚，",
      "noteIds": [
        "n-jue"
      ]
    },
    {
      "text": "可怜王孙泣路隅。",
      "pinyin": [
        "kě",
        "lián",
        "wáng",
        "sūn",
        "qì",
        "lù",
        "yú"
      ],
      "translation": "可怜的王孙躲在路边角落里哭泣。",
      "noteIds": []
    },
    {
      "text": "问之不肯道姓名，",
      "pinyin": [
        "wèn",
        "zhī",
        "bù",
        "kěn",
        "dào",
        "xìng",
        "míng"
      ],
      "translation": "问他姓名，他不肯说出，",
      "noteIds": []
    },
    {
      "text": "但道困苦乞为奴。",
      "pinyin": [
        "dàn",
        "dào",
        "kùn",
        "kǔ",
        "qǐ",
        "wéi",
        "nú"
      ],
      "translation": "只说自己困苦，乞求给人做奴仆。",
      "noteIds": []
    },
    {
      "text": "已经百日窜荆棘，",
      "pinyin": [
        "yǐ",
        "jīng",
        "bǎi",
        "rì",
        "cuàn",
        "jīng",
        "jí"
      ],
      "translation": "他已经在荆棘丛中逃窜了一百天，",
      "noteIds": []
    },
    {
      "text": "身上无有完肌肤。",
      "pinyin": [
        "shēn",
        "shàng",
        "wú",
        "yǒu",
        "wán",
        "jī",
        "fū"
      ],
      "translation": "身上没有一块完好的皮肤。",
      "noteIds": []
    },
    {
      "text": "高帝子孙尽隆准，",
      "pinyin": [
        "gāo",
        "dì",
        "zǐ",
        "sūn",
        "jìn",
        "lóng",
        "zhǔn"
      ],
      "translation": "高皇帝的子孙个个高鼻梁，",
      "noteIds": [
        "n-longzhun"
      ]
    },
    {
      "text": "龙种自与常人殊。",
      "pinyin": [
        "lóng",
        "zhǒng",
        "zì",
        "yǔ",
        "cháng",
        "rén",
        "shū"
      ],
      "translation": "皇族龙种本就与普通人不一样。",
      "noteIds": []
    },
    {
      "text": "豺狼在邑龙在野，",
      "pinyin": [
        "chái",
        "láng",
        "zài",
        "yì",
        "lóng",
        "zài",
        "yě"
      ],
      "translation": "如今豺狼占据着都城，蛟龙流落在荒野，",
      "noteIds": []
    },
    {
      "text": "王孙善保千金躯。",
      "pinyin": [
        "wáng",
        "sūn",
        "shàn",
        "bǎo",
        "qiān",
        "jīn",
        "qū"
      ],
      "translation": "王孙啊，可要保住你这千金之躯。",
      "noteIds": []
    },
    {
      "text": "不敢长语临交衢，",
      "pinyin": [
        "bù",
        "gǎn",
        "cháng",
        "yǔ",
        "lín",
        "jiāo",
        "qú"
      ],
      "translation": "我不敢在大路口同你多说，",
      "noteIds": [
        "n-qu"
      ]
    },
    {
      "text": "且为王孙立斯须。",
      "pinyin": [
        "qiě",
        "wèi",
        "wáng",
        "sūn",
        "lì",
        "sī",
        "xū"
      ],
      "translation": "姑且为你站一小会儿再说几句。",
      "noteIds": []
    },
    {
      "text": "昨夜东风吹血腥，",
      "pinyin": [
        "zuó",
        "yè",
        "dōng",
        "fēng",
        "chuī",
        "xuè",
        "xīng"
      ],
      "translation": "昨夜东风吹来血腥的气味，",
      "noteIds": []
    },
    {
      "text": "东来橐驼满旧都。",
      "pinyin": [
        "dōng",
        "lái",
        "tuó",
        "tuó",
        "mǎn",
        "jiù",
        "dū"
      ],
      "translation": "从东边来的骆驼驮着财物，挤满了旧都。",
      "noteIds": [
        "n-tuotuo"
      ]
    },
    {
      "text": "朔方健儿好身手，",
      "pinyin": [
        "shuò",
        "fāng",
        "jiàn",
        "ér",
        "hǎo",
        "shēn",
        "shǒu"
      ],
      "translation": "朔方军的健儿们本有一身好武艺，",
      "noteIds": [
        "n-shuofang"
      ]
    },
    {
      "text": "昔何勇锐今何愚。",
      "pinyin": [
        "xī",
        "hé",
        "yǒng",
        "ruì",
        "jīn",
        "hé",
        "yú"
      ],
      "translation": "从前那样勇猛，如今怎么这样糊涂失策。",
      "noteIds": []
    },
    {
      "text": "窃闻天子已传位，",
      "pinyin": [
        "qiè",
        "wén",
        "tiān",
        "zǐ",
        "yǐ",
        "chuán",
        "wèi"
      ],
      "translation": "我私下听说天子已经传位给新皇帝，",
      "noteIds": []
    },
    {
      "text": "圣德北服南单于。",
      "pinyin": [
        "shèng",
        "dé",
        "běi",
        "fú",
        "nán",
        "chán",
        "yú"
      ],
      "translation": "圣明的德行让北方的单于也归服了。",
      "noteIds": [
        "n-danyu"
      ]
    },
    {
      "text": "花门剺面请雪耻，",
      "pinyin": [
        "huā",
        "mén",
        "lí",
        "miàn",
        "qǐng",
        "xuě",
        "chǐ"
      ],
      "translation": "回纥人割面立誓，请求为大唐雪耻，",
      "noteIds": [
        "n-huamen",
        "n-li"
      ]
    },
    {
      "text": "慎勿出口他人狙。",
      "pinyin": [
        "shèn",
        "wù",
        "chū",
        "kǒu",
        "tā",
        "rén",
        "jū"
      ],
      "translation": "这话千万不要出口，小心被人暗中窥伺。",
      "noteIds": []
    },
    {
      "text": "哀哉王孙慎勿疏，",
      "pinyin": [
        "āi",
        "zāi",
        "wáng",
        "sūn",
        "shèn",
        "wù",
        "shū"
      ],
      "translation": "可叹的王孙啊，千万要小心谨慎，",
      "noteIds": []
    },
    {
      "text": "五陵佳气无时无。",
      "pinyin": [
        "wǔ",
        "líng",
        "jiā",
        "qì",
        "wú",
        "shí",
        "wú"
      ],
      "translation": "五陵上大唐的兴旺之气，从来没有断绝过。",
      "noteIds": []
    }
  ],
