  "lines": [
    {
      "text": "独有宦游人，",
      "pinyin": ["dú", "yǒu", "huàn", "yóu", "rén"],
      "translation": "只有常年在外做官的人，",
      "noteIds": ["n-huanyou"]
    },
    {
      "text": "偏惊物候新。",
      "pinyin": ["piān", "jīng", "wù", "hòu", "xīn"],
      "translation": "才会特别惊叹江南春天的物候来得又早又新。",
      "noteIds": ["n-wuhou"]
    },
    {
      "text": "云霞出海曙，",
      "pinyin": ["yún", "xiá", "chū", "hǎi", "shǔ"],
      "translation": "太阳从海上出来时，云霞映出曙光，",
      "noteIds": []
    },
    {
      "text": "梅柳渡江春。",
      "pinyin": ["méi", "liǔ", "dù", "jiāng", "chūn"],
