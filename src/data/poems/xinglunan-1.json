        "lái",
        "chuí",
        "diào",
        "bì",
        "xī",
        "shàng"
      ],
      "translation": "像姜太公一样，闲时在碧绿的溪边垂钓，",
      "noteIds": [
        "n-chuidiao"
      ]
    },
    {
      "text": "忽复乘舟梦日边。",
      "pinyin": [
        "hū",
        "fù",
        "chéng",
        "zhōu",
        "mèng",
        "rì",
        "biān"
      ],
      "translation": "又像伊尹一样，梦见乘船经过太阳旁边。",
      "noteIds": [
        "n-mengri"
      ]
    },
    {
      "text": "行路难，行路难，",
      "pinyin": [
        "xíng",
        "lù",
        "nán",
        "xíng",
        "lù",
        "nán"
      ],
      "translation": "人生的路真难走啊，真难走，",
      "noteIds": []
    },
    {
      "text": "多歧路，今安在？",
      "pinyin": [
        "duō",
        "qí",
        "lù",
        "jīn",
        "ān",
        "zài"
      ],
      "translation": "岔路这么多，如今真正的大路在哪里？",
      "noteIds": [
        "n-qilu"
      ]
    },
    {
      "text": "长风破浪会有时，",
      "pinyin": [
