  "lines": [
    {
      "text": "春花秋月何时了，",
      "pinyin": ["chūn", "huā", "qiū", "yuè", "hé", "shí", "liǎo"],
      "translation": "花年年开，月月圆，这样的日子什么时候才是尽头？",
      "noteIds": ["n-liao"]
    },
    {
      "text": "往事知多少。",
      "pinyin": ["wǎng", "shì", "zhī", "duō", "shǎo"],
      "translation": "过去那些宫廷里的日子，还记得多少呢？",
      "noteIds": []
    },
    {
      "text": "小楼昨夜又东风，",
      "pinyin": ["xiǎo", "lóu", "zuó", "yè", "yòu", "dōng", "fēng"],
      "translation": "昨夜小楼上又吹来了春风。",
      "noteIds": ["n-dongfeng"]
    },
    {
      "text": "故国不堪回首月明中。",
      "pinyin": ["gù", "guó", "bù", "kān", "huí", "shǒu", "yuè", "míng", "zhōng"],
      "translation": "在明亮的月光下回头想念故国，心里实在承受不了。",
      "noteIds": ["n-guguo", "n-kanbu"]
    },
    {
      "text": "雕栏玉砌应犹在，",
      "pinyin": ["diāo", "lán", "yù", "qì", "yīng", "yóu", "zài"],
      "translation": "金陵宫殿里雕花的栏杆和玉石的台阶，应该还在吧。",
      "noteIds": ["n-diaolan"]
    },
    {
      "text": "只是朱颜改。",
      "pinyin": ["zhǐ", "shì", "zhū", "yán", "gǎi"],
      "translation": "只是人的容颜已经衰老变样了。",
      "noteIds": ["n-zhuyan"]
    },
    {
      "text": "问君能有几多愁，",
      "pinyin": ["wèn", "jūn", "néng", "yǒu", "jǐ", "duō", "chóu"],
      "translation": "问我心中有多少忧愁？",
      "noteIds": ["n-jiduo"]
    },
    {
      "text": "恰似一江春水向东流。",
      "pinyin": ["qià", "sì", "yī", "jiāng", "chūn", "shuǐ", "xiàng", "dōng", "liú"],
      "translation": "就像满满一江春水，日夜不停地向东流去。",
      "noteIds": []
    }
  ],
