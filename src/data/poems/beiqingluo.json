  "lines": [
    {
      "text": "残阳西入崦，",
      "pinyin": ["cán", "yáng", "xī", "rù", "yān"],
      "translation": "夕阳向西落入崦嵫山下，",
      "noteIds": ["n-yan"]
    },
    {
      "text": "茅屋访孤僧。",
      "pinyin": ["máo", "wū", "fǎng", "gū", "sēng"],
      "translation": "我去茅屋前拜访一位孤僧。",
      "noteIds": []
    },
    {
      "text": "落叶人何在，",
      "pinyin": ["luò", "yè", "rén", "hé", "zài"],
      "translation": "满地落叶，僧人在哪里呢？",
      "noteIds": []
    },
    {
      "text": "寒云路几层。",
      "pinyin": ["hán", "yún", "lù", "jǐ", "céng"],
