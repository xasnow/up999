    },
    {
      "text": "幽居在空谷。",
      "pinyin": [
        "yōu",
        "jū",
        "zài",
        "kōng",
        "gǔ"
      ],
      "translation": "幽静地住在空旷的山谷里。",
      "noteIds": []
    },
    {
      "text": "自云良家子，",
      "pinyin": [
        "zì",
        "yún",
        "liáng",
        "jiā",
        "zǐ"
      ],
      "translation": "她说自己是好人家的子女，",
      "noteIds": [
