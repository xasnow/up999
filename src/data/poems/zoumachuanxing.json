  "lines": [
    {
      "text": "君不见走马川行雪海边，",
      "pinyin": ["jūn", "bú", "jiàn", "zǒu", "mǎ", "chuān", "xíng", "xuě", "hǎi", "biān"],
      "translation": "你难道没看见吗？走马川在雪海边上。",
      "noteIds": ["n-zoumachuan"]
    },
    {
      "text": "平沙莽莽黄入天。",
      "pinyin": ["píng", "shā", "mǎng", "mǎng", "huáng", "rù", "tiān"],
      "translation": "茫茫的沙漠一直黄到天边。",
      "noteIds": []
    },
    {
      "text": "轮台九月风夜吼，",
      "pinyin": ["lún", "tái", "jiǔ", "yuè", "fēng", "yè", "hǒu"],
      "translation": "九月的轮台，夜里狂风怒吼，",
      "noteIds": ["n-luntai"]
    },
    {
      "text": "一川碎石大如斗，",
      "pinyin": ["yì", "chuān", "suì", "shí", "dà", "rú", "dǒu"],
      "translation": "一川的碎石大得像斗，",
      "noteIds": ["n-dou"]
    },
    {
      "text": "随风满地石乱走。",
      "pinyin": ["suí", "fēng", "mǎn", "dì", "shí", "luàn", "zǒu"],
      "translation": "被风卷得满地乱滚。",
      "noteIds": []
    },
    {
      "text": "匈奴草黄马正肥，",
      "pinyin": ["xiōng", "nú", "cǎo", "huáng", "mǎ", "zhèng", "féi"],
      "translation": "匈奴的草黄了，战马正肥壮，",
      "noteIds": []
    },
    {
      "text": "金山西见烟尘飞，",
      "pinyin": ["jīn", "shān", "xī", "jiàn", "yān", "chén", "fēi"],
      "translation": "金山的西面烟尘滚滚，",
      "noteIds": ["n-jinshan"]
    },
    {
      "text": "汉家大将西出师。",
      "pinyin": ["hàn", "jiā", "dà", "jiàng", "xī", "chū", "shī"],
      "translation": "汉朝的大将带兵向西出征。",
      "noteIds": ["n-hanjia"]
    },
    {
      "text": "将军金甲夜不脱，",
      "pinyin": ["jiāng", "jūn", "jīn", "jiǎ", "yè", "bù", "tuō"],
      "translation": "将军的金甲夜里也不脱下，",
      "noteIds": []
    },
    {
      "text": "半夜军行戈相拨，",
      "pinyin": ["bàn", "yè", "jūn", "xíng", "gē", "xiāng", "bō"],
      "translation": "半夜行军，戈矛相互碰击，",
      "noteIds": []
    },
    {
      "text": "风头如刀面如割。",
      "pinyin": ["fēng", "tóu", "rú", "dāo", "miàn", "rú", "gē"],
      "translation": "风头像刀子一样割在脸上。",
      "noteIds": []
    },
    {
      "text": "马毛带雪汗气蒸，",
      "pinyin": ["mǎ", "máo", "dài", "xuě", "hàn", "qì", "zhēng"],
      "translation": "马毛带着雪，汗气一蒸，",
      "noteIds": []
    },
    {
      "text": "五花连钱旋作冰，",
      "pinyin": ["wǔ", "huā", "lián", "qián", "xuán", "zuò", "bīng"],
      "translation": "名贵的战马转眼就结了冰，",
      "noteIds": ["n-wuhua", "n-lianqian"]
