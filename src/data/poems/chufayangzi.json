  "lines": [
    {
      "text": "凄凄去亲爱，",
      "pinyin": ["qī", "qī", "qù", "qīn", "ài"],
      "translation": "凄然告别亲近的朋友，",
      "noteIds": ["n-qinai"]
    },
    {
      "text": "泛泛入烟雾。",
      "pinyin": ["fàn", "fàn", "rù", "yān", "wù"],
      "translation": "小船慢慢驶进江上的烟雾。",
      "noteIds": []
    },
    {
      "text": "归棹洛阳人，",
      "pinyin": ["guī", "zhào", "luò", "yáng", "rén"],
      "translation": "乘着归船回洛阳的是我，",
      "noteIds": ["n-zhao"]
    },
    {
      "text": "残钟广陵树。",
      "pinyin": ["cán", "zhōng", "guǎng", "líng", "shù"],
      "translation": "耳边是余音未尽的钟声，眼里是广陵朦胧的树影。",
      "noteIds": ["n-guangling"]
    },
    {
      "text": "今朝此为别，",
      "pinyin": ["jīn", "zhāo", "cǐ", "wéi", "bié"],
      "translation": "今天在这里分别，",
      "noteIds": []
    },
    {
      "text": "何处还相遇。",
      "pinyin": ["hé", "chù", "hái", "xiāng", "yù"],
      "translation": "以后还能在哪里相遇呢？",
      "noteIds": []
    },
    {
