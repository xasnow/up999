  ],
  "lines": [
    {
      "text": "塞下秋来风景异，",
      "pinyin": ["sài", "xià", "qiū", "lái", "fēng", "jǐng", "yì"],
      "translation": "边塞的秋天一到，风景和江南完全不同。",
      "noteIds": ["n-saixia"]
    },
    {
      "text": "衡阳雁去无留意。",
      "pinyin": ["héng", "yáng", "yàn", "qù", "wú", "liú", "yì"],
      "translation": "大雁朝衡阳飞去，一点也不愿意留下来。",
      "noteIds": ["n-hengyang"]
    },
    {
      "text": "四面边声连角起，",
      "pinyin": ["sì", "miàn", "biān", "shēng", "lián", "jiǎo", "qǐ"],
      "translation": "四面八方都是边塞特有的声响，和军营号角一起响起来。",
      "noteIds": ["n-biansheng"]
    },
    {
      "text": "千嶂里，",
      "pinyin": ["qiān", "zhàng", "lǐ"],
      "translation": "在像屏障一样的千座大山中间，",
      "noteIds": ["n-qianzhang"]
    },
    {
      "text": "长烟落日孤城闭。",
      "pinyin": ["cháng", "yān", "luò", "rì", "gū", "chéng", "bì"],
      "translation": "长长的烟雾托着落日，一座孤城早早关上了城门。",
      "noteIds": []
    },
    {
      "text": "浊酒一杯家万里，",
      "pinyin": ["zhuó", "jiǔ", "yī", "bēi", "jiā", "wàn", "lǐ"],
      "translation": "喝下一杯浊酒，想起万里之外的家乡。",
      "noteIds": ["n-zhuojiu"]
    },
    {
      "text": "燕然未勒归无计。",
      "pinyin": ["yān", "rán", "wèi", "lè", "guī", "wú", "jì"],
      "translation": "战事还没有平定，像古人那样刻石记功，回家的事没有指望。",
      "noteIds": ["n-yanranle"]
    },
    {
      "text": "羌管悠悠霜满地，",
      "pinyin": ["qiāng", "guǎn", "yōu", "yōu", "shuāng", "mǎn", "dì"],
      "translation": "夜深了，羌笛声悠悠地响，霜铺满了地面。",
      "noteIds": ["n-qiangguan"]
    },
    {
      "text": "人不寐，",
      "pinyin": ["rén", "bù", "mèi"],
      "translation": "将士们睡不着觉，",
      "noteIds": []
    },
    {
      "text": "将军白发征夫泪。",
      "pinyin": ["jiāng", "jūn", "bái", "fà", "zhēng", "fū", "lèi"],
      "translation": "将军熬白了头发，士兵们流下了眼泪。",
      "noteIds": []
    }
  ],
