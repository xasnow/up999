---
// 移动端目录：右下角浮动按钮 + 抽屉（全站目录 / 本页目录 两个页签）
import SiteTree from './SiteTree.astro';
---

<div class="mobile-nav">
  <button type="button" class="toc-fab" id="toc-fab" aria-expanded="false" aria-controls="mobile-drawer">
    <span class="toc-fab-icon" aria-hidden="true">☰</span>目录
  </button>

  <div class="mobile-drawer" id="mobile-drawer">
    <div class="drawer-mask" data-close></div>
    <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="目录">
      <div class="drawer-head">
        <div class="drawer-tabs">
          <button type="button" class="drawer-tab active" data-tab="tree">全站目录</button>
          <button type="button" class="drawer-tab" data-tab="toc">本页目录</button>
        </div>
        <button type="button" class="drawer-close" data-close aria-label="关闭目录">×</button>
      </div>
      <div class="drawer-body">
        <div class="drawer-pane active" data-pane="tree">
          <SiteTree />
        </div>
        <div class="drawer-pane" data-pane="toc">
          <ol class="page-toc-list" data-page-toc></ol>
        </div>
      </div>
    </div>
  </div>
</div>
