    { "id": "n-jingpei", "word": "旌旆", "pinyin": "jīng pèi", "meaning": "各种军旗。" },
    { "id": "n-weiyi", "word": "逶迤", "pinyin": "wēi yí", "meaning": "蜿蜒曲折、绵延不绝的样子。" },
    { "id": "n-jieshi", "word": "碣石", "pinyin": "jié shí", "meaning": "山名，在今河北昌黎一带。" },
    { "id": "n-yushu", "word": "羽书", "pinyin": "yǔ shū", "meaning": "插着羽毛的紧急军事文书。" },
