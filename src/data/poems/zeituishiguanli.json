  "lines": [
    {
      "text": "昔岁逢太平，",
      "pinyin": ["xī", "suì", "féng", "tài", "píng"],
      "translation": "从前赶上太平年月，",
      "noteIds": ["n-xisui"]
    },
    {
      "text": "山林二十年。",
      "pinyin": ["shān", "lín", "èr", "shí", "nián"],
      "translation": "我在山林里过了二十年。",
      "noteIds": []
    },
    {
      "text": "泉源在庭户，",
      "pinyin": ["quán", "yuán", "zài", "tíng", "hù"],
      "translation": "泉水就在庭院门前流过，",
      "noteIds": []
    },
    {
      "text": "洞壑当门前。",
      "pinyin": ["dòng", "hè", "dàng", "mén", "qián"],
      "translation": "山沟正对着家门。",
      "noteIds": ["n-donghe"]
    },
    {
      "text": "井税有常期，",
      "pinyin": ["jǐng", "shuì", "yǒu", "cháng", "qī"],
      "translation": "那时收税有固定的期限，",
      "noteIds": ["n-jingshui"]
    },
    {
      "text": "日晏犹得眠。",
      "pinyin": ["rì", "yàn", "yóu", "dé", "mián"],
      "translation": "天晚了还能安心睡觉。",
      "noteIds": ["n-riyan"]
    },
    {
      "text": "忽然遭世变，",
      "pinyin": ["hū", "rán", "zāo", "shì", "biàn"],
      "translation": "忽然赶上大乱之年，",
      "noteIds": []
    },
    {
      "text": "数岁亲戎旃。",
      "pinyin": ["shù", "suì", "qīn", "róng", "zhān"],
      "translation": "好几年都亲身经历军旅生活。",
      "noteIds": ["n-rongzhan"]
    },
    {
      "text": "今来典斯郡，",
      "pinyin": ["jīn", "lái", "diǎn", "sī", "jùn"],
      "translation": "如今我来管理这个州郡，",
      "noteIds": ["n-dian"]
    },
    {
      "text": "山夷又纷然。",
      "pinyin": ["shān", "yí", "yòu", "fēn", "rán"],
      "translation": "山里的部族又闹起了战乱。",
      "noteIds": ["n-shanyi"]
    },
    {
      "text": "城小贼不屠，",
      "pinyin": ["chéng", "xiǎo", "zéi", "bù", "tú"],
      "translation": "城太小，贼人不屑来屠杀，",
      "noteIds": []
    },
    {
      "text": "人贫伤可怜。",
      "pinyin": ["rén", "pín", "shāng", "kě", "lián"],
      "translation": "百姓太穷，连贼人都觉得可怜。",
      "noteIds": []
    },
    {
      "text": "是以陷邻境，",
      "pinyin": ["shì", "yǐ", "xiàn", "lín", "jìng"],
      "translation": "所以邻近州县都遭了陷落，",
      "noteIds": []
    },
    {
      "text": "此州独见全。",
      "pinyin": ["cǐ", "zhōu", "dú", "jiàn", "quán"],
      "translation": "只有这个州得以保全。",
      "noteIds": ["n-jianquan"]
    },
    {
      "text": "使臣将王命，",
      "pinyin": ["shǐ", "chén", "jiāng", "wáng", "mìng"],
      "translation": "催税的使臣奉着皇帝的命令，",
      "noteIds": ["n-jiangming"]
    },
    {
      "text": "岂不如贼焉。",
      "pinyin": ["qǐ", "bù", "rú", "zéi", "yān"],
      "translation": "难道就不像贼人一样吗？",
      "noteIds": []
    },
    {
      "text": "今彼征敛者，",
      "pinyin": ["jīn", "bǐ", "zhēng", "liǎn", "zhě"],
      "translation": "现在那些横征暴敛的官吏，",
      "noteIds": ["n-zhenglian"]
    },
    {
      "text": "迫之如火煎。",
      "pinyin": ["pò", "zhī", "rú", "huǒ", "jiān"],
      "translation": "把百姓逼迫得像油煎火烤。",
      "noteIds": []
    },
    {
      "text": "谁能绝人命，",
      "pinyin": ["shuí", "néng", "jué", "rén", "mìng"],
      "translation": "谁忍心断绝百姓的活路，",
      "noteIds": ["n-jue"]
    },
    {
      "text": "以作时世贤。",
      "pinyin": ["yǐ", "zuò", "shí", "shì", "xián"],
      "translation": "去换取“当代贤能”的名声呢？",
      "noteIds": ["n-shishixian"]
    },
    {
      "text": "思欲委符节，",
      "pinyin": ["sī", "yù", "wěi", "fú", "jié"],
      "translation": "我想要交还这官印符节，",
      "noteIds": ["n-fujie"]
    },
    {
      "text": "引竿自刺船。",
      "pinyin": ["yǐn", "gān", "zì", "cì", "chuán"],
      "translation": "拿起竹篙自己撑船离开。",
      "noteIds": ["n-cichuan"]
    },
    {
      "text": "将家就鱼麦，",
      "pinyin": ["jiāng", "jiā", "jiù", "yú", "mài"],
      "translation": "带着全家去打鱼种麦，",
      "noteIds": ["n-jiangjia"]
    },
    {
      "text": "归老江湖边。",
      "pinyin": ["guī", "lǎo", "jiāng", "hú", "biān"],
      "translation": "在江湖边上安度晚年。",
      "noteIds": []
    }
  ],
