    },
    {
      "text": "采之欲遗谁？",
      "pinyin": ["cǎi", "zhī", "yù", "wèi", "shuí"],
      "translation": "采了花想要送给谁呢？",
      "noteIds": ["n-wei"]
    },
    {
      "text": "所思在远道。",
      "pinyin": ["suǒ", "sī", "zài", "yuǎn", "dào"],
      "translation": "我思念的人正在遥远的路上。",
      "noteIds": ["n-suosi"]
