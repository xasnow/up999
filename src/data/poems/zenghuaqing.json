  "lines": [
    {
      "text": "锦城丝管日纷纷，",
      "pinyin": ["jǐn", "chéng", "sī", "guǎn", "rì", "fēn", "fēn"],
      "translation": "成都城里，乐声天天响个不停，",
      "noteIds": ["n-jincheng", "n-siguan", "n-fenfen"]
    },
    {
      "text": "半入江风半入云。",
      "pinyin": ["bàn", "rù", "jiāng", "fēng", "bàn", "rù", "yún"],
      "translation": "一半飘进江风，一半飞上云霄。",
      "noteIds": []
    },
    {
      "text": "此曲只应天上有，",
      "pinyin": ["cǐ", "qǔ", "zhǐ", "yīng", "tiān", "shàng", "yǒu"],
      "translation": "这样的曲子只有天上才有，",
      "noteIds": ["n-zhiying"]
    },
    {
      "text": "人间能得几回闻。",
      "pinyin": ["rén", "jiān", "néng", "dé", "jǐ", "huí", "wén"],
      "translation": "人间能听到几回呢？",
      "noteIds": ["n-wen"]
    }
  ],
