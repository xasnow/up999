  "lines": [
    {
      "text": "飒飒东风细雨来，",
      "pinyin": ["sà", "sà", "dōng", "fēng", "xì", "yǔ", "lái"],
      "translation": "东风飒飒，夹着细雨飘来，",
      "noteIds": ["n-sasa"]
    },
    {
      "text": "芙蓉塘外有轻雷。",
