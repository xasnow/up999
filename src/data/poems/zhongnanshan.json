  "translation": "终南山的主峰高得快接近天帝住的地方了，连绵的山峰一直延伸到海边。回头一望，刚走过的地方白云又合拢了；想走近看那青色的雾气，走近了却什么也没有。山峰划分出的天地区域以主峰为界各不相同，众多的山谷里有的阴、有的晴。想找有人烟的地方借宿一夜，隔着溪水向砍柴的人问路。",
  "appreciation": "诗人用短短四十个字画出了整座终南山。远看，山峰高到天上、长到海边；走进去，白云在身后合拢，雾气在眼前散开；再往山沟里看，这边晴那边阴。最后问樵夫借宿，大山一下子有了人烟和生气。一远一近、一开一合的写法，就像高手画画，把一座大山写活了。",
  "background": "终南山在长安城南面，绵延八百多里，是唐代文人常去游览、隐居的地方。王维隐居终南山时期写下了这首游山之作，把大山的高远和云雾的变幻都收进了诗里。",
  "storyline": [
    {
      "step": 1,
      "title": "远望大山",
      "text": "终南山主峰高耸入云，山脉绵延直到海边。"
    },
    {
      "step": 2,
      "title": "云雾变幻",
      "text": "回望白云合拢，走近青霭却怎么也看不见。"
    },
    {
      "step": 3,
      "title": "阴晴各异",
      "text": "山峰各分一方，众多山谷阴晴各不相同。"
    },
    {
      "step": 4,
      "title": "问路投宿",
      "text": "天色渐晚，诗人隔水向樵夫打听借宿的地方。"
    }
  ],
