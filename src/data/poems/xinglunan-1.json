    {
      "text": "停杯投箸不能食，",
      "pinyin": [
        "tíng",
        "bēi",
        "tóu",
        "zhù",
        "bù",
        "néng",
        "shí"
      ],
      "translation": "我却停下杯子、放下筷子，吃不下饭，",
      "noteIds": [
        "n-zhu"
      ]
    },
    {
      "text": "拔剑四顾心茫然。",
      "pinyin": [
        "bá",
        "jiàn",
        "sì",
        "gù",
        "xīn",
        "máng",
        "rán"
      ],
      "translation": "拔出宝剑环顾四周，心里一片茫然。",
      "noteIds": []
    },
    {
      "text": "欲渡黄河冰塞川，",
      "pinyin": [
        "yù",
        "dù",
        "huáng",
        "hé",
        "bīng",
        "sè",
        "chuān"
      ],
      "translation": "想渡过黄河，坚冰堵塞了河道，",
      "noteIds": [
        "n-saichuan"
      ]
    },
    {
      "text": "将登太行雪满山。",
      "pinyin": [
        "jiāng",
        "dēng",
        "tài",
        "háng",
        "xuě",
        "mǎn",
        "shān"
      ],
      "translation": "想登上太行山，大雪铺满了山路。",
      "noteIds": [
        "n-taihang"
      ]
    },
    {
      "text": "闲来垂钓碧溪上，",
