      "step": 1,
      "title": "夜雨连江",
      "text": "夜里下起冷雨，雨和江水连成一片，一直下到吴地。"
    },
    {
      "step": 2,
      "title": "天亮送别",
      "text": "天刚亮，王昌龄在芙蓉楼送好朋友辛渐上船。"
    },
    {
      "step": 3,
      "title": "山也孤单",
      "text": "朋友走远了，只剩江边的楚山孤零零地立着。"
    },
    {
      "step": 4,
      "title": "带一句话",
      "text": "他请朋友捎句话：我的心还像玉壶里的冰一样干净。"
    }
