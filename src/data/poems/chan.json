  "lines": [
    {
      "text": "本以高难饱，",
      "pinyin": ["běn", "yǐ", "gāo", "nán", "bǎo"],
      "translation": "蝉栖在高树上餐风饮露，本来就难得吃饱，",
      "noteIds": ["n-gao"]
    },
    {
      "text": "徒劳恨费声。",
      "pinyin": ["tú", "láo", "hèn", "fèi", "shēng"],
      "translation": "再费尽力气鸣叫，也只能白白怨恨。",
      "noteIds": []
    },
    {
      "text": "五更疏欲断，",
      "pinyin": ["wǔ", "gēng", "shū", "yù", "duàn"],
      "translation": "叫到五更天，声音稀疏得快要断绝，",
      "noteIds": ["n-wugeng"]
    },
    {
      "text": "一树碧无情。",
      "pinyin": ["yī", "shù", "bì", "wú", "qíng"],
      "translation": "满树碧绿，却对它毫无怜惜。",
      "noteIds": []
    },
    {
      "text": "薄宦梗犹泛，",
      "pinyin": ["bó", "huàn", "gěng", "yóu", "fàn"],
      "translation": "我做着卑微的小官，仍像树枝一样四处漂流，",
      "noteIds": ["n-bohuan", "n-gengfan"]
    },
    {
      "text": "故园芜已平。",
      "pinyin": ["gù", "yuán", "wú", "yǐ", "píng"],
      "translation": "故乡的田园荒草丛生，早已盖过小路。",
      "noteIds": ["n-wu"]
    },
    {
      "text": "烦君最相警，",
      "pinyin": ["fán", "jūn", "zuì", "xiāng", "jǐng"],
      "translation": "劳烦你一声声鸣叫，最是提醒了我，",
      "noteIds": ["n-xiangjing"]
    },
    {
      "text": "我亦举家清。",
      "pinyin": ["wǒ", "yì", "jǔ", "jiā", "qīng"],
      "translation": "我也和你一样，全家清贫守节。",
      "noteIds": ["n-jujiaqing"]
    }
  ],
