  "lines": [
    {
      "text": "我本楚狂人，",
      "pinyin": [
        "wǒ",
        "běn",
        "chǔ",
        "kuáng",
        "rén"
      ],
      "translation": "我本来就像楚国的狂士接舆，",
      "noteIds": [
        "n-chukuang"
      ]
    },
    {
      "text": "凤歌笑孔丘。",
      "pinyin": [
        "fèng",
        "gē",
        "xiào",
        "kǒng",
        "qiū"
      ],
      "translation": "唱着凤歌笑那四处求官的孔丘。",
      "noteIds": [
        "n-fengge"
      ]
    },
    {
      "text": "手持绿玉杖，",
      "pinyin": [
        "shǒu",
        "chí",
        "lǜ",
        "yù",
        "zhàng"
      ],
      "translation": "手里拿着仙人用的绿玉杖，",
      "noteIds": [
        "n-lvyuzhang"
      ]
    },
    {
      "text": "朝别黄鹤楼。",
      "pinyin": [
        "zhāo",
        "bié",
        "huáng",
        "hè",
        "lóu"
      ],
      "translation": "清晨辞别黄鹤楼。",
      "noteIds": []
    },
    {
      "text": "五岳寻仙不辞远，",
      "pinyin": [
        "wǔ",
        "yuè",
        "xún",
        "xiān",
        "bù",
        "cí",
        "yuǎn"
      ],
      "translation": "为了寻访神仙，走遍五岳也不嫌路远，",
      "noteIds": []
    },
    {
      "text": "一生好入名山游。",
      "pinyin": [
        "yī",
        "shēng",
        "hào",
        "rù",
        "míng",
        "shān",
        "yóu"
      ],
      "translation": "这一生就喜欢到名山去游历。",
      "noteIds": []
    },
    {
      "text": "庐山秀出南斗傍，",
      "pinyin": [
        "lú",
        "shān",
        "xiù",
        "chū",
        "nán",
        "dǒu",
        "bàng"
      ],
      "translation": "庐山秀丽地挺立在南斗星旁边，",
      "noteIds": [
        "n-nandou"
      ]
    },
    {
      "text": "屏风九叠云锦张，",
      "pinyin": [
        "píng",
        "fēng",
        "jiǔ",
        "dié",
        "yún",
        "jǐn",
        "zhāng"
      ],
      "translation": "九叠云屏像铺开的云锦一样，",
      "noteIds": [
        "n-pingfeng"
      ]
    },
    {
      "text": "影落明湖青黛光。",
      "pinyin": [
        "yǐng",
        "luò",
        "míng",
        "hú",
        "qīng",
        "dài",
        "guāng"
      ],
      "translation": "山影落在明净的湖水里，泛出青黛色的光。",
      "noteIds": [
        "n-dai"
      ]
    },
    {
      "text": "金阙前开二峰长，",
      "pinyin": [
        "jīn",
        "què",
        "qián",
        "kāi",
        "èr",
        "fēng",
        "cháng"
      ],
      "translation": "金阙岩前两座山峰高耸屹立，",
      "noteIds": [
        "n-jinque"
      ]
    },
    {
      "text": "银河倒挂三石梁。",
      "pinyin": [
        "yín",
        "hé",
        "dào",
        "guà",
        "sān",
        "shí",
        "liáng"
      ],
      "translation": "瀑布像银河倒挂在三根石梁上。",
      "noteIds": [
        "n-shiliang"
      ]
    },
    {
      "text": "香炉瀑布遥相望，",
      "pinyin": [
        "xiāng",
        "lú",
        "pù",
        "bù",
        "yáo",
        "xiāng",
        "wàng"
      ],
      "translation": "香炉峰的瀑布远远地相对相望，",
      "noteIds": [
        "n-xianglu"
      ]
    },
    {
      "text": "回崖沓嶂凌苍苍。",
      "pinyin": [
        "huí",
        "yá",
        "tà",
        "zhàng",
        "líng",
        "cāng",
        "cāng"
      ],
      "translation": "曲折的山崖、重叠的山峰，高入青天。",
      "noteIds": [
        "n-tazhang"
      ]
    },
    {
      "text": "翠影红霞映朝日，",
      "pinyin": [
        "cuì",
        "yǐng",
        "hóng",
        "xiá",
        "yìng",
        "zhāo",
        "rì"
      ],
      "translation": "翠绿的山影、红色的朝霞，映着初升的太阳，",
      "noteIds": []
    },
    {
      "text": "鸟飞不到吴天长。",
      "pinyin": [
        "niǎo",
        "fēi",
        "bù",
        "dào",
        "wú",
        "tiān",
        "cháng"
      ],
      "translation": "鸟也飞不过这辽阔的吴天。",
      "noteIds": []
    },
    {
      "text": "登高壮观天地间，",
      "pinyin": [
        "dēng",
        "gāo",
        "zhuàng",
        "guān",
        "tiān",
        "dì",
        "jiān"
      ],
      "translation": "登上高峰，天地尽收眼底，气象壮观，",
      "noteIds": []
    },
    {
      "text": "大江茫茫去不还。",
      "pinyin": [
        "dà",
        "jiāng",
        "máng",
        "máng",
        "qù",
        "bù",
        "huán"
      ],
      "translation": "长江茫茫东流，一去不再回头。",
      "noteIds": []
    },
    {
      "text": "黄云万里动风色，",
      "pinyin": [
        "huáng",
        "yún",
        "wàn",
        "lǐ",
        "dòng",
        "fēng",
        "sè"
      ],
      "translation": "万里黄云卷动，天色随风变幻，",
      "noteIds": []
    },
    {
      "text": "白波九道流雪山。",
      "pinyin": [
        "bái",
        "bō",
        "jiǔ",
        "dào",
        "liú",
        "xuě",
        "shān"
      ],
      "translation": "九道白色的江波，像流动的雪山。",
      "noteIds": [
        "n-jiudao"
      ]
    },
    {
      "text": "好为庐山谣，",
      "pinyin": [
        "hào",
        "wéi",
        "lú",
        "shān",
        "yáo"
      ],
      "translation": "我高兴地唱起庐山的歌谣，",
      "noteIds": []
    },
    {
      "text": "兴因庐山发。",
      "pinyin": [
        "xìng",
        "yīn",
        "lú",
        "shān",
        "fā"
      ],
      "translation": "诗兴因为庐山而激发。",
      "noteIds": []
    },
    {
      "text": "闲窥石镜清我心，",
      "pinyin": [
        "xián",
        "kuī",
        "shí",
        "jìng",
        "qīng",
        "wǒ",
        "xīn"
      ],
      "translation": "闲来照照石镜，让心境清爽，",
      "noteIds": [
        "n-shijing"
      ]
    },
    {
      "text": "谢公行处苍苔没。",
      "pinyin": [
        "xiè",
        "gōng",
        "xíng",
        "chù",
        "cāng",
        "tái",
        "mò"
      ],
      "translation": "谢灵运走过的地方，已被青苔掩没。",
      "noteIds": [
        "n-xiegong"
      ]
    },
    {
      "text": "早服还丹无世情，",
      "pinyin": [
        "zǎo",
        "fú",
        "huán",
        "dān",
        "wú",
        "shì",
        "qíng"
      ],
      "translation": "我要早早服下仙丹，抛却世俗之情，",
      "noteIds": [
        "n-huandan"
      ]
    },
    {
      "text": "琴心三叠道初成。",
      "pinyin": [
        "qín",
        "xīn",
        "sān",
        "dié",
        "dào",
        "chū",
        "chéng"
      ],
      "translation": "练到心神宁静平和，学道便初有所成。",
      "noteIds": [
        "n-qinxin"
      ]
    },
    {
      "text": "遥见仙人彩云里，",
      "pinyin": [
        "yáo",
        "jiàn",
        "xiān",
        "rén",
        "cǎi",
        "yún",
        "lǐ"
      ],
      "translation": "远远望见神仙站在彩云里，",
      "noteIds": []
    },
    {
      "text": "手把芙蓉朝玉京。",
      "pinyin": [
        "shǒu",
        "bǎ",
        "fú",
        "róng",
        "cháo",
        "yù",
        "jīng"
      ],
      "translation": "手拿莲花，去朝拜天上的玉京。",
      "noteIds": [
        "n-yujing"
      ]
    },
    {
      "text": "先期汗漫九垓上，",
      "pinyin": [
        "xiān",
        "qī",
        "hàn",
        "màn",
        "jiǔ",
        "gāi",
        "shàng"
      ],
      "translation": "我要先和仙人汗漫约会在九天之上，",
      "noteIds": [
        "n-hanman",
        "n-jiugai"
      ]
    },
    {
      "text": "愿接卢敖游太清。",
      "pinyin": [
        "yuàn",
        "jiē",
        "lú",
        "áo",
        "yóu",
        "tài",
        "qīng"
      ],
      "translation": "愿接你卢敖，一同遨游太清仙境。",
      "noteIds": [
        "n-luao"
      ]
    }
  ],
