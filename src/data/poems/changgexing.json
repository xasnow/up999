  ],
  "lines": [
    {
      "text": "青青园中葵，",
      "pinyin": ["qīng", "qīng", "yuán", "zhōng", "kuí"],
      "translation": "园子里的葵菜长得绿油油，",
      "noteIds": ["n-kui"]
    },
    {
      "text": "朝露待日晞。",
      "pinyin": ["zhāo", "lù", "dài", "rì", "xī"],
      "translation": "早晨的露水等着太阳把它晒干。",
      "noteIds": ["n-xi"]
    },
    {
      "text": "阳春布德泽，",
      "pinyin": ["yáng", "chūn", "bù", "dé", "zé"],
      "translation": "温暖的春天把阳光雨露洒向大地，",
      "noteIds": ["n-deze"]
    },
    {
      "text": "万物生光辉。",
      "pinyin": ["wàn", "wù", "shēng", "guāng", "huī"],
      "translation": "万物都长得生机勃勃、亮闪闪。",
      "noteIds": []
    },
    {
      "text": "常恐秋节至，",
      "pinyin": ["cháng", "kǒng", "qiū", "jié", "zhì"],
      "translation": "常常担心秋天快点来到，",
      "noteIds": []
    },
    {
      "text": "焜黄华叶衰。",
      "pinyin": ["kūn", "huáng", "huá", "yè", "cuī"],
      "translation": "花和叶子就会枯黄凋落。",
      "noteIds": ["n-kun", "n-cui"]
    },
    {
      "text": "百川东到海，",
      "pinyin": ["bǎi", "chuān", "dōng", "dào", "hǎi"],
      "translation": "千百条江河向东流入大海，",
      "noteIds": []
    },
    {
      "text": "何时复西归？",
      "pinyin": ["hé", "shí", "fù", "xī", "guī"],
      "translation": "什么时候才能流回来呢？",
      "noteIds": []
    },
    {
      "text": "少壮不努力，",
      "pinyin": ["shào", "zhuàng", "bù", "nǔ", "lì"],
      "translation": "年轻力壮的时候不努力，",
      "noteIds": []
    },
    {
      "text": "老大徒伤悲。",
      "pinyin": ["lǎo", "dà", "tú", "shāng", "bēi"],
      "translation": "等老了只能白白地伤心后悔。",
      "noteIds": []
    }
  ],
