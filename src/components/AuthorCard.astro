---
import { authorPath, poemsOfAuthor } from '../lib/content';

const { author } = Astro.props;
const portrait = author.portrait;
const poemCount = poemsOfAuthor(author.id).length;
---

<a class="author-card" href={authorPath(author)}>
  <span class="author-avatar">
    {portrait ? <img src={portrait.src} width={portrait.width} height={portrait.height} alt={portrait.alt} loading="lazy" /> : author.name.slice(0, 1)}
  </span>
  <div>
    <h3>{author.name}</h3>
    <p class="author-years">{author.yearsLabel} · {poemCount} 首作品</p>
    <p class="author-summary">{author.summary}</p>
  </div>
</a>
