  "lines": [
    {
      "text": "鸡鸣紫陌曙光寒，",
      "pinyin": ["jī", "míng", "zǐ", "mò", "shǔ", "guāng", "hán"],
      "translation": "雄鸡报晓，京城的大路上曙光初露，还带着寒意。",
      "noteIds": ["n-zimo"]
    },
    {
      "text": "莺啭皇州春色阑。",
      "pinyin": ["yīng", "zhuàn", "huáng", "zhōu", "chūn", "sè", "lán"],
      "translation": "黄莺啼啭，长安的春天快要过去了。",
      "noteIds": ["n-lan"]
    },
    {
      "text": "金阙晓钟开万户，",
      "pinyin": ["jīn", "què", "xiǎo", "zhōng", "kāi", "wàn", "hù"],
      "translation": "皇宫的晓钟敲响，千万道宫门一扇扇打开。",
      "noteIds": ["n-jinque"]
    },
    {
      "text": "玉阶仙仗拥千官。",
      "pinyin": ["yù", "jiē", "xiān", "zhàng", "yōng", "qiān", "guān"],
      "translation": "玉阶前列着仪仗，簇拥着上朝的千百官员。",
      "noteIds": ["n-xianzhang"]
    },
    {
      "text": "花迎剑珮星初落，",
      "pinyin": ["huā", "yíng", "jiàn", "pèi", "xīng", "chū", "luò"],
