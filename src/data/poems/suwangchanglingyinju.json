    "松际露微月，清光犹为君。"
  ],
  "lines": [
    {
      "text": "清溪深不测，",
      "pinyin": ["qīng", "xī", "shēn", "bú", "cè"],
      "translation": "清溪深得望不到底，",
      "noteIds": []
    },
    {
      "text": "隐处唯孤云。",
      "pinyin": ["yǐn", "chù", "wéi", "gū", "yún"],
      "translation": "隐居的地方只见一朵孤云。",
      "noteIds": ["n-yinchu"]
    },
    {
      "text": "松际露微月，",
      "pinyin": ["sōng", "jì", "lù", "wēi", "yuè"],
      "translation": "松树间露出细细的月牙，",
      "noteIds": []
    },
    {
      "text": "清光犹为君。",
      "pinyin": ["qīng", "guāng", "yóu", "wèi", "jūn"],
      "translation": "清亮的光还在照着你。",
      "noteIds": ["n-weiwei"]
    },
    {
      "text": "茅亭宿花影，",
      "pinyin": ["máo", "tíng", "sù", "huā", "yǐng"],
      "translation": "茅亭边花影安睡，",
      "noteIds": ["n-maoting"]
    },
    {
      "text": "药院滋苔纹。",
      "pinyin": ["yào", "yuàn", "zī", "tái", "wén"],
      "translation": "药院里青苔的纹路悄悄生长。",
      "noteIds": ["n-yaoyuan"]
    },
    {
      "text": "余亦谢时去，",
      "pinyin": ["yú", "yì", "xiè", "shí", "qù"],
      "translation": "我也要辞别尘世而去，",
      "noteIds": ["n-xieshi"]
    },
    {
      "text": "西山鸾鹤群。",
      "pinyin": ["xī", "shān", "luán", "hè", "qún"],
      "translation": "到西山与鸾鸟仙鹤结伴。",
      "noteIds": ["n-luanhe"]
    }
  ],
