  "lines": [
    {
      "text": "草长莺飞二月天，",
      "pinyin": ["cǎo", "zhǎng", "yīng", "fēi", "èr", "yuè", "tiān"],
      "translation": "农历二月，青草生长，黄莺飞来飞去，",
      "noteIds": ["n-ying"]
    },
    {
      "text": "拂堤杨柳醉春烟。",
      "pinyin": ["fú", "dī", "yáng", "liǔ", "zuì", "chūn", "yān"],
      "translation": "杨柳枝轻轻拂过河堤，像陶醉在春天的雾气里。",
      "noteIds": ["n-fudi", "n-chunyan"]
    },
    {
      "text": "儿童散学归来早，",
      "pinyin": ["ér", "tóng", "sàn", "xué", "guī", "lái", "zǎo"],
      "translation": "孩子们放学回来得早，",
      "noteIds": ["n-sanxue"]
    },
    {
      "text": "忙趁东风放纸鸢。",
      "pinyin": ["máng", "chèn", "dōng", "fēng", "fàng", "zhǐ", "yuān"],
      "translation": "赶忙趁着东风，放起了风筝。",
      "noteIds": ["n-zhiyuan"]
    }
  ],
