      "noteIds": ["n-sui"]
    },
    {
      "text": "日高花影重。",
      "pinyin": ["rì", "gāo", "huā", "yǐng", "chóng"],
      "translation": "太阳升高，花影重重叠叠。",
      "noteIds": []
    },
    {
      "text": "年年越溪女，",
      "pinyin": ["nián", "nián", "yuè", "xī", "nǚ"],
      "translation": "年年想起越溪边的女伴，",
      "noteIds": ["n-yuexi"]
    },
    {
      "text": "相忆采芙蓉。",
      "pinyin": ["xiāng", "yì", "cǎi", "fú", "róng"],
      "translation": "那时一起采芙蓉的日子多么快乐。",
