  "lines": [
    {
      "text": "山石荦确行径微，",
      "pinyin": ["shān", "shí", "luò", "què", "xíng", "jìng", "wēi"],
      "translation": "山石嶙峋不平，山路又窄又险，",
      "noteIds": ["n-luoque"]
    },
    {
      "text": "黄昏到寺蝙蝠飞。",
      "pinyin": ["huáng", "hūn", "dào", "sì", "biān", "fú", "fēi"],
      "translation": "黄昏时赶到寺庙，蝙蝠正飞来飞去。",
      "noteIds": []
    },
    {
      "text": "升堂坐阶新雨足，",
      "pinyin": ["shēng", "táng", "zuò", "jiē", "xīn", "yǔ", "zú"],
      "translation": "走进佛堂，坐在台阶上，一场新雨刚下透，",
      "noteIds": []
    },
    {
      "text": "芭蕉叶大栀子肥。",
      "pinyin": ["bā", "jiāo", "yè", "dà", "zhī", "zi", "féi"],
      "translation": "芭蕉叶子大大的，栀子花开得又肥又亮。",
      "noteIds": ["n-zhike"]
    },
    {
      "text": "僧言古壁佛画好，",
      "pinyin": ["sēng", "yán", "gǔ", "bì", "fó", "huà", "hǎo"],
      "translation": "僧人说古壁上的佛像画画得真好，",
      "noteIds": []
    },
    {
      "text": "以火来照所见稀。",
      "pinyin": ["yǐ", "huǒ", "lái", "zhào", "suǒ", "jiàn", "xī"],
      "translation": "点起火把来照，能看见的已经不多。",
      "noteIds": []
    },
    {
      "text": "铺床拂席置羹饭，",
      "pinyin": ["pū", "chuáng", "fú", "xí", "zhì", "gēng", "fàn"],
      "translation": "和尚铺好床、拂净席子，摆上简单的饭菜，",
      "noteIds": []
    },
    {
      "text": "疏粝亦足饱我饥。",
      "pinyin": ["shū", "lì", "yì", "zú", "bǎo", "wǒ", "jī"],
      "translation": "粗茶淡饭也足够填饱我的肚子。",
      "noteIds": ["n-shuli"]
    },
    {
      "text": "夜深静卧百虫绝，",
      "pinyin": ["yè", "shēn", "jìng", "wò", "bǎi", "chóng", "jué"],
      "translation": "夜深了，静静躺下，各种虫鸣都停了，",
      "noteIds": []
    },
    {
      "text": "清月出岭光入扉。",
      "pinyin": ["qīng", "yuè", "chū", "lǐng", "guāng", "rù", "fēi"],
      "translation": "一轮清亮的月亮翻出山岭，月光照进窗户。",
      "noteIds": []
    },
    {
      "text": "天明独去无道路，",
      "pinyin": ["tiān", "míng", "dú", "qù", "wú", "dào", "lù"],
      "translation": "天亮时独自出发，看不清哪是道路，",
      "noteIds": []
    },
    {
      "text": "出入高下穷烟霏。",
      "pinyin": ["chū", "rù", "gāo", "xià", "qióng", "yān", "fēi"],
      "translation": "在高低起伏的山雾里，走遍了没走过的路。",
      "noteIds": []
    },
    {
      "text": "山红涧碧纷烂漫，",
      "pinyin": ["shān", "hóng", "jiàn", "bì", "fēn", "làn", "màn"],
      "translation": "山上红花、涧边绿草，一片绚烂，",
      "noteIds": []
    },
    {
      "text": "时见松枥皆十围。",
      "pinyin": ["shí", "jiàn", "sōng", "lì", "jiē", "shí", "wéi"],
