  "writtenYear": 805,
  "writtenLabel": "公元805年秋（韩愈38岁，遇赦北归途中拜谒南岳衡山庙，夜宿岳寺）",
  "orderInAuthor": 2,
  "famousLines": [
    "须臾静扫众峰出，仰见突兀撑青空。"
  ],
  "lines": [
    {
      "text": "五岳祭秩皆三公，",
      "pinyin": ["wǔ", "yuè", "jì", "zhì", "jiē", "sān", "gōng"],
      "translation": "五岳的祭祀规格，都同三公一样高，",
      "noteIds": ["n-jizhi"]
    },
    {
      "text": "四方环镇嵩当中。",
      "pinyin": ["sì", "fāng", "huán", "zhèn", "sōng", "dāng", "zhōng"],
      "translation": "四方各镇一岳，嵩山稳稳居中。",
      "noteIds": []
    },
    {
      "text": "火维地荒足妖怪，",
      "pinyin": ["huǒ", "wéi", "dì", "huāng", "zú", "yāo", "guài"],
      "translation": "南方属火，这片荒僻的土地上多有精怪，",
      "noteIds": ["n-huowei"]
    },
    {
      "text": "天假神柄专其雄。",
      "pinyin": ["tiān", "jiǎ", "shén", "bǐng", "zhuān", "qí", "xióng"],
      "translation": "上天把神权交给衡山之神，让它独称雄长。",
      "noteIds": []
    },
    {
      "text": "喷云泄雾藏半腹，",
      "pinyin": ["pēn", "yún", "xiè", "wù", "cáng", "bàn", "fù"],
      "translation": "山腰喷云吐雾，把半个山身都藏了起来，",
      "noteIds": []
    },
    {
      "text": "虽有绝顶谁能穷？",
      "pinyin": ["suī", "yǒu", "jué", "dǐng", "shéi", "néng", "qióng"],
      "translation": "纵然有绝顶，谁能爬到头呢？",
      "noteIds": []
    },
    {
      "text": "我来正逢秋雨节，",
      "pinyin": ["wǒ", "lái", "zhèng", "féng", "qiū", "yǔ", "jié"],
      "translation": "我来到这里，正赶上秋雨时节，",
      "noteIds": []
    },
    {
      "text": "阴气晦昧无清风。",
      "pinyin": ["yīn", "qì", "huì", "mèi", "wú", "qīng", "fēng"],
      "translation": "山间阴气沉沉，昏暗得没有一丝清风。",
      "noteIds": ["n-huimei"]
    },
    {
      "text": "潜心默祷若有应，",
      "pinyin": ["qián", "xīn", "mò", "dǎo", "ruò", "yǒu", "yìng"],
      "translation": "我静下心来默默祷告，竟像真有回应，",
      "noteIds": []
    },
    {
      "text": "岂非正直能感通！",
      "pinyin": ["qǐ", "fēi", "zhèng", "zhí", "néng", "gǎn", "tōng"],
      "translation": "难道不正因人正直，才能与神灵相通吗！",
      "noteIds": []
    },
    {
      "text": "须臾静扫众峰出，",
      "pinyin": ["xū", "yú", "jìng", "sǎo", "zhòng", "fēng", "chū"],
      "translation": "一会儿，云雾像被静静扫开，群峰露了出来，",
      "noteIds": []
    },
    {
      "text": "仰见突兀撑青空。",
      "pinyin": ["yǎng", "jiàn", "tū", "wù", "chēng", "qīng", "kōng"],
      "translation": "抬头看，山峰高峻突兀，撑住了青天。",
      "noteIds": ["n-tuwu"]
    },
    {
      "text": "紫盖连延接天柱，",
      "pinyin": ["zǐ", "gài", "lián", "yán", "jiē", "tiān", "zhù"],
      "translation": "紫盖峰绵延起伏，连着天柱峰，",
      "noteIds": []
    },
    {
      "text": "石廪腾掷堆祝融。",
      "pinyin": ["shí", "lǐn", "téng", "zhì", "duī", "zhù", "róng"],
      "translation": "石廪峰腾挪跳跃，簇拥着最高的祝融峰。",
      "noteIds": ["n-shilin"]
    },
    {
      "text": "森然魄动下马拜，",
      "pinyin": ["sēn", "rán", "pò", "dòng", "xià", "mǎ", "bài"],
      "translation": "山势森然，我心惊魄动，连忙下马下拜，",
      "noteIds": []
    },
    {
      "text": "松柏一径趋灵宫。",
      "pinyin": ["sōng", "bǎi", "yí", "jìng", "qū", "líng", "gōng"],
      "translation": "沿着两旁长满松柏的小路，走向衡岳庙。",
      "noteIds": []
    },
    {
      "text": "粉墙丹柱动光彩，",
      "pinyin": ["fěn", "qiáng", "dān", "zhù", "dòng", "guāng", "cǎi"],
      "translation": "白墙红柱，光彩明晃晃地闪动，",
      "noteIds": []
    },
    {
      "text": "鬼物图画填青红。",
      "pinyin": ["guǐ", "wù", "tú", "huà", "tián", "qīng", "hóng"],
      "translation": "墙上画满神鬼，青红颜色涂得满满的。",
      "noteIds": []
    },
    {
      "text": "升阶伛偻荐脯酒，",
      "pinyin": ["shēng", "jiē", "yǔ", "lǚ", "jiàn", "fǔ", "jiǔ"],
      "translation": "我弯着腰登上台阶，献上干肉和酒，",
      "noteIds": ["n-yulv", "n-fu"]
    },
    {
      "text": "欲以菲薄明其衷。",
      "pinyin": ["yù", "yǐ", "fěi", "bó", "míng", "qí", "zhōng"],
      "translation": "想用这点微薄的祭品表明我的心意。",
      "noteIds": ["n-feibo"]
    },
    {
      "text": "庙令老人识神意，",
      "pinyin": ["miào", "lìng", "lǎo", "rén", "shí", "shén", "yì"],
      "translation": "管庙的老人最懂神灵的心意，",
      "noteIds": []
    },
    {
      "text": "睢盱侦伺能鞠躬。",
      "pinyin": ["suī", "xū", "zhēn", "sì", "néng", "jū", "gōng"],
      "translation": "睁大眼睛看着我来意，躬着身子小心伺候。",
      "noteIds": ["n-suixu"]
    },
    {
      "text": "手持杯珓导我掷，",
      "pinyin": ["shǒu", "chí", "bēi", "jiào", "dǎo", "wǒ", "zhì"],
      "translation": "他手拿占卜的杯珓，教我怎么掷，",
      "noteIds": ["n-beijiao"]
    },
    {
      "text": "云此最吉余难同。",
      "pinyin": ["yún", "cǐ", "zuì", "jí", "yú", "nán", "tóng"],
      "translation": "说这个卦最吉利，别的卦都比不上。",
      "noteIds": []
    },
    {
      "text": "窜逐蛮荒幸不死，",
      "pinyin": ["cuàn", "zhú", "mán", "huāng", "xìng", "bù", "sǐ"],
      "translation": "我被放逐到蛮荒之地，侥幸没死，",
      "noteIds": []
    },
    {
      "text": "衣食才足甘长终。",
      "pinyin": ["yī", "shí", "cái", "zú", "gān", "cháng", "zhōng"],
      "translation": "衣食刚刚够用，也甘愿就这样过完一生。",
      "noteIds": []
    },
    {
      "text": "侯王将相望久绝，",
      "pinyin": ["hóu", "wáng", "jiàng", "xiàng", "wàng", "jiǔ", "jué"],
      "translation": "封侯拜相的念头早已断绝，",
      "noteIds": []
    },
    {
      "text": "神纵欲福难为功！",
      "pinyin": ["shén", "zòng", "yù", "fú", "nán", "wéi", "gōng"],
      "translation": "神灵纵然想降福给我，也难有作为！",
      "noteIds": []
    },
    {
      "text": "夜投佛寺上高阁，",
      "pinyin": ["yè", "tóu", "fó", "sì", "shàng", "gāo", "gé"],
      "translation": "夜里投宿岳寺，登上高高的楼阁，",
      "noteIds": []
    },
    {
      "text": "星月掩映云曈昽。",
      "pinyin": ["xīng", "yuè", "yǎn", "yìng", "yún", "tóng", "lóng"],
      "translation": "星光月色掩映着云层，透出蒙蒙的微光。",
      "noteIds": ["n-tonglong"]
    },
    {
      "text": "猿鸣钟动不知曙，",
      "pinyin": ["yuán", "míng", "zhōng", "dòng", "bù", "zhī", "shǔ"],
      "translation": "猿声响起，钟声敲动，我竟不知天已亮，",
      "noteIds": []
    },
    {
      "text": "杲杲寒日生于东。",
      "pinyin": ["gǎo", "gǎo", "hán", "rì", "shēng", "yú", "dōng"],
      "translation": "明亮的秋日已从东边升起来了。",
      "noteIds": ["n-gao"]
    }
  ],
