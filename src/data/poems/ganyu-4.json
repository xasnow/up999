    {
      "text": "经冬犹绿林。",
      "pinyin": ["jīng", "dōng", "yóu", "lǜ", "lín"],
      "translation": "经过整个冬天，依然是绿油油的一片。",
      "noteIds": []
    },
    {
      "text": "岂伊地气暖？",
      "pinyin": ["qǐ", "yī", "dì", "qì", "nuǎn"],
      "translation": "难道只是因为那里的气候暖和吗？",
      "noteIds": ["n-yi"]
    },
    {
      "text": "自有岁寒心。",
      "pinyin": ["zì", "yǒu", "suì", "hán", "xīn"],
      "translation": "是它自己有一颗耐得住严寒的心。",
      "noteIds": ["n-suihan"]
    },
    {
      "text": "可以荐嘉客，",
      "pinyin": ["kě", "yǐ", "jiàn", "jiā", "kè"],
      "translation": "这样的好果子本可以献给贵客，",
      "noteIds": ["n-jian"]
    },
    {
      "text": "奈何阻重深。",
      "pinyin": ["nài", "hé", "zǔ", "zhòng", "shēn"],
      "translation": "无奈山高路远，重重阻隔，送不出去。",
      "noteIds": ["n-zhong"]
    },
    {
      "text": "运命唯所遇，",
      "pinyin": ["yùn", "mìng", "wéi", "suǒ", "yù"],
      "translation": "命运只看碰上了什么样的遭遇，",
      "noteIds": []
    },
    {
      "text": "循环不可寻。",
      "pinyin": ["xún", "huán", "bù", "kě", "xún"],
      "translation": "像轮子转来转去，说不清其中的缘由。",
      "noteIds": []
    },
    {
      "text": "徒言树桃李，",
      "pinyin": ["tú", "yán", "shù", "táo", "lǐ"],
      "translation": "人们只知道种桃树、李树，",
      "noteIds": []
    },
    {
      "text": "此木岂无阴？",
      "pinyin": ["cǐ", "mù", "qǐ", "wú", "yīn"],
      "translation": "难道这橘树就没有树荫吗？",
