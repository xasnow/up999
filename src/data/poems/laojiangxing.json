  "writtenLabel": "约公元 737 年（王维 36 岁，借老将军遭遇讽刺朝廷刻薄功臣）",
  "orderInAuthor": 1,
  "famousLines": [
    "莫嫌旧日云中守，犹堪一战取功勋。"
  ],
  "lines": [
    {
      "text": "少年十五二十时，",
      "pinyin": [
        "shào",
        "nián",
        "shí",
        "wǔ",
        "èr",
        "shí",
        "shí"
      ],
      "translation": "这位老将军少年十五二十岁的时候，",
      "noteIds": []
    },
    {
      "text": "步行夺得胡马骑。",
      "pinyin": [
        "bù",
        "xíng",
        "duó",
        "dé",
        "hú",
        "mǎ",
        "qí"
      ],
      "translation": "徒步上阵也能夺得胡人的战马来骑。",
      "noteIds": []
    },
    {
      "text": "射杀山中白额虎，",
      "pinyin": [
        "shè",
        "shā",
        "shān",
        "zhōng",
        "bái",
        "é",
        "hǔ"
      ],
      "translation": "他射死过山中的白额猛虎，",
      "noteIds": []
    },
    {
      "text": "肯数邺下黄须儿。",
      "pinyin": [
        "kěn",
        "shǔ",
        "yè",
        "xià",
        "huáng",
        "xū",
        "ér"
      ],
      "translation": "哪里还会数着邺下的黄须儿称英雄。",
      "noteIds": [
        "n-huangxuer"
      ]
    },
    {
      "text": "一身转战三千里，",
      "pinyin": [
        "yī",
        "shēn",
        "zhuǎn",
        "zhàn",
        "sān",
        "qiān",
        "lǐ"
      ],
      "translation": "他一个人转战三千里疆场，",
      "noteIds": []
    },
    {
      "text": "一剑曾当百万师。",
      "pinyin": [
        "yī",
        "jiàn",
        "céng",
        "dāng",
        "bǎi",
        "wàn",
        "shī"
      ],
      "translation": "一把剑曾抵挡过百万大军。",
      "noteIds": []
    },
    {
      "text": "汉兵奋迅如霹雳，",
      "pinyin": [
        "hàn",
        "bīng",
        "fèn",
        "xùn",
        "rú",
        "pī",
        "lì"
      ],
      "translation": "汉军迅猛得像霹雳一样，",
      "noteIds": [
        "n-pili"
      ]
    },
    {
      "text": "虏骑崩腾畏蒺藜。",
      "pinyin": [
        "lǔ",
        "qì",
        "bēng",
        "téng",
        "wèi",
        "jí",
        "lí"
      ],
      "translation": "敌人的骑兵溃逃奔散，害怕铁蒺藜。",
      "noteIds": [
        "n-luqi",
        "n-jili"
      ]
    },
    {
      "text": "卫青不败由天幸，",
      "pinyin": [
        "wèi",
        "qīng",
        "bù",
        "bài",
        "yóu",
        "tiān",
        "xìng"
      ],
      "translation": "卫青总打胜仗，靠的是天大的运气，",
      "noteIds": [
        "n-weiqing"
      ]
    },
    {
      "text": "李广无功缘数奇。",
      "pinyin": [
        "lǐ",
        "guǎng",
        "wú",
        "gōng",
        "yuán",
        "shù",
        "jī"
      ],
      "translation": "李广立不了功，是因为命运不好。",
      "noteIds": [
        "n-liguang",
        "n-shuqi"
      ]
    },
    {
      "text": "自从弃置便衰朽，",
      "pinyin": [
        "zì",
        "cóng",
        "qì",
        "zhì",
        "biàn",
        "shuāi",
        "xiǔ"
      ],
      "translation": "自从被朝廷弃置不用，他就衰老了，",
      "noteIds": [
        "n-qizhi"
      ]
    },
    {
      "text": "世事蹉跎成白首。",
      "pinyin": [
        "shì",
        "shì",
        "cuō",
        "tuó",
        "chéng",
        "bái",
        "shǒu"
      ],
      "translation": "岁月蹉跎，头发全都白了。",
      "noteIds": [
        "n-cuotuo"
      ]
    },
    {
      "text": "昔时飞箭无全目，",
      "pinyin": [
        "xī",
        "shí",
        "fēi",
        "jiàn",
        "wú",
        "quán",
        "mù"
      ],
      "translation": "从前箭法高明，射出去的箭没有一只眼睛能保全，",
      "noteIds": [
        "n-quanmu"
      ]
    },
    {
      "text": "今日垂杨生左肘。",
      "pinyin": [
        "jīn",
        "rì",
        "chuí",
        "yáng",
        "shēng",
        "zuǒ",
        "zhǒu"
      ],
      "translation": "如今却衰老多病，肘上像生了瘤子。",
      "noteIds": [
        "n-zuozhou"
      ]
    },
    {
      "text": "路旁时卖故侯瓜，",
      "pinyin": [
        "lù",
        "páng",
        "shí",
        "mài",
        "gù",
        "hóu",
        "guā"
      ],
      "translation": "他路旁有时卖着故侯的甜瓜，",
      "noteIds": [
        "n-guhougua"
      ]
    },
    {
      "text": "门前学种先生柳。",
      "pinyin": [
        "mén",
        "qián",
        "xué",
        "zhòng",
        "xiān",
        "shēng",
        "liǔ"
      ],
      "translation": "门前学着五柳先生种起柳树。",
      "noteIds": [
        "n-xianshengliu"
      ]
    },
    {
      "text": "苍茫古木连穷巷，",
      "pinyin": [
        "cāng",
        "máng",
        "gǔ",
        "mù",
        "lián",
        "qióng",
        "xiàng"
      ],
      "translation": "苍茫的古树连着冷落的深巷，",
      "noteIds": [
        "n-qiongxiang"
      ]
    },
    {
      "text": "寥落寒山对虚牖。",
      "pinyin": [
        "liáo",
        "luò",
        "hán",
        "shān",
        "duì",
        "xū",
        "yǒu"
      ],
      "translation": "寂寥的寒山正对着空空的窗户。",
      "noteIds": [
        "n-you"
      ]
    },
    {
      "text": "誓令疏勒出飞泉，",
      "pinyin": [
        "shì",
        "lìng",
        "shū",
        "lè",
        "chū",
        "fēi",
        "quán"
      ],
      "translation": "他发誓要像耿恭那样让疏勒城涌出飞泉，",
      "noteIds": [
        "n-shule"
      ]
    },
    {
      "text": "不似颍川空使酒。",
      "pinyin": [
        "bù",
        "sì",
        "yǐng",
        "chuān",
        "kōng",
        "shǐ",
        "jiǔ"
      ],
      "translation": "不像颍川的灌夫，只会借酒撒气。",
      "noteIds": [
        "n-yingchuan"
      ]
    },
    {
      "text": "贺兰山下阵如云，",
      "pinyin": [
        "hè",
        "lán",
        "shān",
        "xià",
        "zhèn",
        "rú",
        "yún"
      ],
      "translation": "如今贺兰山下军阵如云，",
      "noteIds": []
    },
    {
      "text": "羽檄交驰日夕闻。",
      "pinyin": [
        "yǔ",
        "xí",
        "jiāo",
        "chí",
        "rì",
        "xī",
        "wén"
      ],
      "translation": "紧急的军书日夜奔驰，不断传来。",
      "noteIds": [
        "n-yuxi"
      ]
    },
    {
      "text": "节使三河募年少，",
      "pinyin": [
        "jié",
        "shǐ",
        "sān",
        "hé",
        "mù",
        "nián",
        "shào"
      ],
      "translation": "持节的使者在三河一带招募年轻人，",
      "noteIds": [
        "n-jieshi",
        "n-sanhe"
      ]
    },
    {
      "text": "诏书五道出将军。",
      "pinyin": [
        "zhào",
        "shū",
        "wǔ",
        "dào",
        "chū",
        "jiāng",
        "jūn"
      ],
      "translation": "皇帝下诏书，从五条路线派出将军。",
      "noteIds": []
    },
    {
      "text": "试拂铁衣如雪色，",
      "pinyin": [
        "shì",
        "fú",
        "tiě",
        "yī",
        "rú",
        "xuě",
        "sè"
      ],
      "translation": "老将军擦亮铁甲，白亮得像雪一样，",
      "noteIds": []
    },
    {
      "text": "聊持宝剑动星文。",
      "pinyin": [
        "liáo",
        "chí",
        "bǎo",
        "jiàn",
        "dòng",
        "xīng",
        "wén"
      ],
      "translation": "又拿起宝剑，剑上七星花纹闪闪发亮。",
      "noteIds": [
        "n-xingwen"
      ]
    },
    {
      "text": "愿得燕弓射天骄，",
      "pinyin": [
        "yuàn",
        "dé",
        "yān",
        "gōng",
        "shè",
        "tiān",
        "jiāo"
      ],
      "translation": "他愿得到燕地的强弓，去射敌人的首领，",
      "noteIds": [
        "n-yangong",
        "n-tianjiao"
      ]
    },
    {
      "text": "耻令越甲鸣吾君。",
      "pinyin": [
        "chǐ",
        "lìng",
        "yuè",
        "jiǎ",
        "míng",
        "wú",
        "jūn"
      ],
      "translation": "绝不能让敌兵惊扰自己的君主，那是耻辱。",
      "noteIds": [
        "n-yuejia"
      ]
    },
    {
      "text": "莫嫌旧日云中守，",
      "pinyin": [
        "mò",
        "xián",
        "jiù",
        "rì",
        "yún",
        "zhōng",
        "shǒu"
      ],
      "translation": "不要嫌弃昔日的云中太守，",
      "noteIds": [
        "n-yunzhongshou"
      ]
    },
    {
      "text": "犹堪一战取功勋。",
      "pinyin": [
        "yóu",
        "kān",
        "yī",
        "zhàn",
        "qǔ",
        "gōng",
        "xūn"
      ],
      "translation": "他还能上战场，再立一场大功呢。",
      "noteIds": []
    }
  ],
