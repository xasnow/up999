    },
    {
      "text": "瞿塘石城草萧瑟。",
      "pinyin": [
        "qú",
        "táng",
        "shí",
        "chéng",
        "cǎo",
        "xiāo",
        "sè"
      ],
      "translation": "瞿塘峡和白帝城的草木，也一片萧条冷落。",
      "noteIds": []
    },
    {
      "text": "玳筵急管曲复终，",
      "pinyin": [
        "dài",
        "yán",
        "jí",
        "guǎn",
        "qǔ",
        "fù",
        "zhōng"
      ],
      "translation": "华美的宴席上急促的乐声又一次结束，",
      "noteIds": [
        "n-daiyan"
      ]
    },
    {
      "text": "乐极哀来月东出。",
      "pinyin": [
        "lè",
        "jí",
        "āi",
        "lái",
        "yuè",
        "dōng",
        "chū"
      ],
      "translation": "乐到极点悲哀涌来，月亮已经从东边升起。",
      "noteIds": []
