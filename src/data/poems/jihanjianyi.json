  "lines": [
    {
      "text": "今我不乐思岳阳，",
      "pinyin": [
        "jīn",
        "wǒ",
        "bù",
        "lè",
        "sī",
        "yuè",
        "yáng"
      ],
      "translation": "如今我心情不佳，思念远在岳阳的朋友，",
      "noteIds": []
    },
    {
      "text": "身欲奋飞病在床。",
      "pinyin": [
        "shēn",
        "yù",
        "fèn",
        "fēi",
        "bìng",
        "zài",
        "chuáng"
      ],
      "translation": "想要奋飞前去探望，却病倒在床。",
      "noteIds": []
    },
    {
      "text": "美人娟娟隔秋水，",
      "pinyin": [
        "měi",
        "rén",
        "juān",
        "juān",
        "gé",
        "qiū",
        "shuǐ"
      ],
      "translation": "品德美好的友人，隔着秋水娟秀独立，",
      "noteIds": [
        "n-meiren"
      ]
    },
    {
      "text": "濯足洞庭望八荒。",
      "pinyin": [
        "zhuó",
        "zú",
        "dòng",
        "tíng",
        "wàng",
        "bā",
        "huāng"
      ],
      "translation": "在洞庭湖边洗脚，放眼八方荒远之地。",
      "noteIds": [
        "n-zhuozu",
        "n-bahuang"
      ]
    },
    {
      "text": "鸿飞冥冥日月白，",
      "pinyin": [
        "hóng",
        "fēi",
        "míng",
        "míng",
        "rì",
        "yuè",
        "bái"
      ],
      "translation": "大雁高飞在深远的天际，日月皎洁，",
      "noteIds": []
    },
    {
      "text": "青枫叶赤天雨霜。",
      "pinyin": [
        "qīng",
        "fēng",
        "yè",
        "chì",
        "tiān",
        "yù",
        "shuāng"
      ],
      "translation": "青枫的叶子红了，天上下起秋霜。",
      "noteIds": []
    },
    {
      "text": "玉京群帝集北斗，",
      "pinyin": [
        "yù",
        "jīng",
        "qún",
        "dì",
        "jí",
        "běi",
        "dǒu"
      ],
      "translation": "仙山玉京的众仙帝聚集在北斗周围，",
      "noteIds": [
        "n-yujing"
      ]
    },
    {
      "text": "或骑麒麟翳凤凰。",
      "pinyin": [
        "huò",
        "qí",
        "qí",
        "lín",
        "yì",
        "fèng",
        "huáng"
      ],
      "translation": "有的骑着麒麟，有的乘着凤凰，遮天蔽日。",
      "noteIds": [
        "n-yi"
      ]
    },
    {
      "text": "芙蓉旌旗烟雾落，",
