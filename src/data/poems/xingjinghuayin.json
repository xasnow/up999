  "lines": [
    {
      "text": "岧峣太华俯咸京，",
      "pinyin": ["tiáo", "yáo", "tài", "huà", "fǔ", "xián", "jīng"],
      "translation": "高高的西岳华山，俯瞰着长安城。",
      "noteIds": ["n-tiaoyao", "n-taihua"]
    },
    {
      "text": "天外三峰削不成。",
      "pinyin": ["tiān", "wài", "sān", "fēng", "xuē", "bù", "chéng"],
      "translation": "天边三座主峰陡峭奇险，像不是人力能削成的。",
      "noteIds": ["n-sanfeng"]
    },
    {
      "text": "武帝祠前云欲散，",
      "pinyin": ["wǔ", "dì", "cí", "qián", "yún", "yù", "sàn"],
      "translation": "武帝祠前，云彩快要散开，",
      "noteIds": ["n-wudici"]
    },
    {
      "text": "仙人掌上雨初晴。",
      "pinyin": ["xiān", "rén", "zhǎng", "shàng", "yǔ", "chū", "qíng"],
      "translation": "仙人掌峰上，雨刚停，天刚放晴。",
      "noteIds": ["n-xianrenzhang"]
    },
    {
      "text": "河山北枕秦关险，",
      "pinyin": ["hé", "shān", "běi", "zhěn", "qín", "guān", "xiǎn"],
      "translation": "黄河华山北靠着险要的秦地关隘，",
      "noteIds": ["n-beizhen"]
    },
    {
      "text": "驿路西连汉畤平。",
      "pinyin": ["yì", "lù", "xī", "lián", "hàn", "zhì", "píng"],
      "translation": "驿道向西连着平坦的汉代祭坛。",
