{
  "id": "tang-shengtang-libai-changganxing-zhiyi",
  "slug": "changganxing-zhiyi",
  "title": "长干行·其一",
  "titlePinyin": "cháng gān xíng · qí yī",
  "dynasty": "tangshi",
