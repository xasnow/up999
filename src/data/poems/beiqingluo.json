      "noteIds": []
    },
    {
      "text": "独敲初夜磬，",
      "pinyin": ["dú", "qiāo", "chū", "yè", "qìng"],
      "translation": "入夜时分，独自敲响诵经的磬。",
      "noteIds": ["n-chuye", "n-qing"]
    },
    {
      "text": "闲倚一枝藤。",
      "pinyin": ["xián", "yǐ", "yī", "zhī", "téng"],
      "translation": "闲适地倚着一根藤杖。",
      "noteIds": ["n-yizhiteng"]
